[Unit]
Description=Sauvegarde du staging Meeshy (base verifiee, medias, configuration)
Documentation=https://github.com/isopen-io/meeshy/issues/10385
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=COMPOSE_DIR=/opt/meeshy/staging
Environment=BACKUP_ROOT=/opt/meeshy/backups/staging-nightly
Environment=DB_CONTAINER=meeshy-database-staging
Environment="VOLUMES=meeshy-staging-gateway-uploads meeshy-staging-gateway-sounds meeshy-staging-web-uploads meeshy-staging-redis-data"
Environment=STATUS_DIR=/opt/meeshy/staging/backup-status
Environment=LOCK_FILE=/run/meeshy-staging-backup.lock
ExecStart=/opt/meeshy/staging/ops/bin/meeshy-nightly-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=4h
