[Unit]
Description=Publie l'usage Docker et l'etat des conteneurs pour l'administration Meeshy (%i)
Documentation=https://github.com/isopen-io/meeshy/issues/10386
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/meeshy/%i/ops/bin/meeshy-ops-runner.py docker-df %i
TimeoutStartSec=2min
Nice=10
NoNewPrivileges=true
