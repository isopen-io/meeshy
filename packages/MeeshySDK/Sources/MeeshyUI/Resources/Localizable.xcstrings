    "voiceProfile.manage.deleteMessage": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحذف هذا الإجراء ملفك الصوتي وجميع عيّناتك نهائيًا، وسيلغي موافقتك. وهو إجراء لا رجعة فيه (اللائحة العامة لحماية البيانات)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Aktion löscht dauerhaft Ihr Stimmprofil, alle Proben und widerruft Ihre Einwilligung (DSGVO)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This action will permanently delete your voice profile, all your samples and revoke your consent. This action is irreversible (GDPR)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta acción eliminará permanentemente tu perfil vocal, todas tus muestras y revocará tu consentimiento (RGPD)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "new",
            "value": "Cette action supprimera definitivement votre profil vocal, tous vos echantillons et revoquera votre consentement. Cette action est irreversible (RGPD)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione eliminerà definitivamente il tuo profilo vocale e tutti i tuoi campioni, e revocherà il tuo consenso. È irreversibile (GDPR)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta ação excluirá permanentemente seu perfil vocal, todas as amostras e revogará seu consentimento (RGPD)."
          }
        }
      }
    },
