    "auth.registration.header.language" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parle ta langue, on traduit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speak your language, we translate"
