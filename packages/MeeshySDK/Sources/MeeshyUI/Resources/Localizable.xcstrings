    "settings.cache.purge.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحذف لا رجعة فيه. ستتم إعادة تنزيل البيانات المعنية عند الحاجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Löschvorgang ist unwiderruflich. Die betroffenen Daten werden bei Bedarf erneut heruntergeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletion is irreversible. The affected data will be downloaded again on demand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta eliminación es irreversible. Los datos afectados se volverán a descargar cuando se necesiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette suppression est irréversible. Les données concernées seront retéléchargées à la demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa eliminazione è irreversibile. I dati interessati verranno scaricati di nuovo all'occorrenza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta exclusão é irreversível. Os dados afetados serão baixados novamente quando necessário."
          }
        }
      }
    },
