    "story.media.soundExtraction.a11yHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتمكن أشخاص آخرون من إعادة استخدام مسار صوت مقاطع الفيديو في هذا المنشور في منشوراتهم الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Personen können den Ton der Videos dieses Beitrags in ihren eigenen Beiträgen wiederverwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other people will be able to reuse this post's video soundtrack in their own posts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otras personas podrán reutilizar la banda sonora de los vídeos de esta publicación en sus propias publicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'autres personnes pourront réutiliser la bande-son des vidéos de ce post dans leurs propres publications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altre persone potranno riutilizzare la colonna sonora dei video di questo post nelle proprie pubblicazioni."
