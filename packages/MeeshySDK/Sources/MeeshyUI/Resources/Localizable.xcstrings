    "profile.connection.context.received": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرغب %@ في التواصل معك. اقبل لتبادل الرسائل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
