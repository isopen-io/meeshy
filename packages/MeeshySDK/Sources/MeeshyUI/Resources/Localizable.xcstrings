    "settings.cache.limitation.embedded": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التفاعلات جزء من المحتوى الذي يحملها وليس لها مدخل خاص بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaktionen sind Teil des Inhalts, der sie trägt, und haben keinen eigenen Eintrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reactions are part of the content that carries them and have no entry of their own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reacciones forman parte del contenido que las contiene y no ocupan una entrada propia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réactions font partie du contenu qui les porte et n'occupent pas d'entrée propre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le reazioni fanno parte del contenuto che le contiene e non occupano una voce propria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As reações fazem parte do conteúdo que as contém e não ocupam uma entrada própria."
          }
        }
      }
    },
    "settings.cache.limitation.indivisible": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشترك بيانات الريلز والمنشورات في نفس التخزين: أفرغ صف المنشورات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten von Reels und Beiträgen teilen sich denselben Speicher – leeren Sie die Zeile Beiträge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reels and posts data share the same storage — clear the Posts row."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de los reels y las publicaciones comparten el mismo almacenamiento: vacía la fila Publicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données des réels et des publications partagent le même stockage : videz la ligne Publications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di reel e post condividono lo stesso archivio: svuota la riga Post."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados dos reels e das publicações compartilham o mesmo armazenamento: limpe a linha Publicações."
          }
        }
      }
    },
    "settings.cache.limitation.noStore": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم الاحتفاظ بالمستندات في ذاكرة التخزين المؤقت: لا يوجد ما يمكن تحريره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumente werden nicht im Cache gespeichert – es gibt nichts freizugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents are not kept in the cache — there is nothing to free up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos no se guardan en caché: no hay nada que liberar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les documents ne sont pas conservés en cache : il n'y a rien à libérer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I documenti non vengono memorizzati nella cache: non c'è nulla da liberare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os documentos não são mantidos em cache: não há nada a liberar."
          }
        }
      }
    },
    "settings.cache.limitation.notApplicable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ينطبق على هذا المجال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
