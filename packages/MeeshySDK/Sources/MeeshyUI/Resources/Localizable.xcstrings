    "profile.connection.context.received" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرغب %@ في التواصل معك. اقبل لتبادل الرسائل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ möchte sich mit dir verbinden. Akzeptiere, um Nachrichten auszutauschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wants to connect with you. Accept to exchange messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quiere conectar contigo. Acepta para intercambiar mensajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ souhaite entrer en contact avec vous. Acceptez pour échanger des messages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ desidera mettersi in contatto con te. Accetta per scambiare messaggi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quer se conectar com você. Aceite para trocar mensagens."
          }
        }
      }
    },
