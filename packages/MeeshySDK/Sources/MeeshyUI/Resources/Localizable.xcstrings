    "story.composer.mediaLoadFailedMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل هذه الوسائط. تأكّد من تنزيلها على الجهاز (iCloud) ثم أعِد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Medium konnte nicht geladen werden. Stelle sicher, dass es auf das Gerät heruntergeladen ist (iCloud), und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This media couldn't be loaded. Make sure it's downloaded to the device (iCloud) and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar este medio. Comprueba que esté descargado en el dispositivo (iCloud) y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce média n'a pas pu être chargé. Vérifiez qu'il est téléchargé sur l'appareil (iCloud) et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile caricare questo media. Verifica che sia scaricato sul dispositivo (iCloud) e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar esta mídia. Verifique se ela está baixada no dispositivo (iCloud) e tente novamente."
          }
        }
      }
    },
