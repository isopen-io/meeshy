    "settings.cache.purge.unattributed.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات ما زالت على الجهاز ولم يعد المنشور أو القصة أو المحادثة الأصلية في ذاكرة التخزين المؤقت. لا يمكن ربطها بأي مجال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die noch auf dem Gerät liegen, deren ursprünglicher Beitrag, Story oder Unterhaltung nicht mehr im Cache ist. Sie lassen sich keinem Bereich zuordnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files still on the device whose original post, story or conversation is no longer cached. They cannot be linked to any domain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos que siguen en el dispositivo cuya publicación, historia o conversación de origen ya no está en caché. No se pueden vincular a ningún dominio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers encore sur l'appareil dont la publication, la story ou la conversation d'origine n'est plus en cache. Impossible de les rattacher à un domaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File ancora sul dispositivo il cui post, storia o conversazione di origine non è più in cache. Non è possibile associarli a un ambito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos ainda no aparelho cuja publicação, story ou conversa de origem não está mais em cache. Não é possível vinculá-los a um domínio."
          }
        }
      }
    },
