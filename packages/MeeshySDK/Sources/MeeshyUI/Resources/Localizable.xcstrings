    "story.sound.library.renameHint": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيكون هذا العنوان مرئيًا لكل من يكتشف هذا الصوت. اتركه فارغًا للعودة إلى التسمية الافتراضية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Titel ist für alle sichtbar, die diesen Sound entdecken. Leer lassen, um die Standardbezeichnung wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This title will be visible to everyone who finds this sound. Leave it empty to restore the default label."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este título será visible para todos los que descubran este sonido. Déjalo vacío para volver a la etiqueta predeterminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce titre sera visible par tous ceux qui découvrent ce son. Laissez vide pour revenir au libellé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo titolo sarà visibile a chiunque scopra questo suono. Lascialo vuoto per tornare all'etichetta predefinita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este título ficará visível para todos que descobrirem este som. Deixe vazio para voltar ao rótulo padrão."
          }
        }
      }
    },
