    "story.timeline.inspector.background.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغطّي الخلفية الشريحة بأكملها — ويُتجاهل البداية والمدة. عطّل «الخلفية» لوضع هذه الوسائط على الخط الزمني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrund bedeckt die ganze Slide — Beginn und Dauer werden ignoriert. Deaktiviere „Hintergrund“, um dieses Medium auf der Timeline zu platzieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A background fills the whole slide — start/duration are ignored. Turn “Background” off to time this media on the timeline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fondo cubre toda la diapositiva — se ignoran inicio y duración. Desactiva «Fondo» para colocar este contenido en la línea de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fond couvre toute la slide — début/durée ignorés. Désactivez « Fond » pour caler ce média sur la timeline."
