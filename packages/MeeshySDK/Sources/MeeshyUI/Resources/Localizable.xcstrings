    "story.composer.mediaLostSingle": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد إحدى وسائط مسودتك متاحة (ملف محذوف). أُعيدت الشريحة من دون هذه الوسائط — أعِد التصوير إن لزم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Medium deines Entwurfs ist nicht mehr verfügbar (Datei gelöscht). Der Slide wurde ohne es wiederhergestellt — bei Bedarf neu aufnehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One media item from your draft is no longer available (file deleted). The slide was restored without it — retake if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un medio de tu borrador ya no está disponible (archivo eliminado). El slide se restauró sin él — vuelve a capturarlo si es necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "new",
            "value": "Un média de votre brouillon n'est plus disponible (fichier supprimé). Le slide a été restauré sans ce média — retake si nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un media della tua bozza non è più disponibile (file eliminato). La slide è stata ripristinata senza questo media — rifallo se necessario."
