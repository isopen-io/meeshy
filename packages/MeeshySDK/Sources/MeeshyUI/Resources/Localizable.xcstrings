    "story.timeline.inspector.animate.caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحلة حركة: تثبّت الموضع والمقياس والشفافية عند هذه اللحظة — وينتقل العنصر من مرحلة إلى أخرى أثناء التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animationsschritt: fixiert Position, Skalierung und Deckkraft in diesem Moment — das Element gleitet während der Wiedergabe von einem Schritt zum nächsten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation step: pins position, scale and opacity at this moment — the element glides between steps during playback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso de animación: fija posición, escala y opacidad en este instante — el elemento se desliza de un paso a otro durante la reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étape d'animation : fige position, échelle et opacité à cet instant — l'élément glisse d'une étape à l'autre pendant la lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase di animazione: fissa posizione, scala e opacità in questo istante — l'elemento scorre da una fase all'altra durante la riproduzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Etapa de animação: fixa posição, escala e opacidade neste instante — o elemento desliza de uma etapa à outra durante a reprodução."
          }
        }
      }
    },
