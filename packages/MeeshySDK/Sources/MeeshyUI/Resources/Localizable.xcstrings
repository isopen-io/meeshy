    "community.settings.delete.confirm.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الإجراء لا رجعة فيه. سيُحذف جميع الأعضاء والقنوات والرسائل نهائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese Aktion ist unwiderruflich. Alle Mitglieder, Kanäle und Nachrichten werden dauerhaft gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This action is irreversible. All members, channels and messages will be permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta acción es irreversible. Todos los miembros, canales y mensajes serán eliminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cette action est irréversible. Tous les membres, canaux et messages seront supprimés définitivement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione è irreversibile. Tutti i membri, i canali e i messaggi saranno eliminati definitivamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta ação é irreversível. Todos os membros, canais e mensagens serão excluídos."
          }
        }
      }
    },
