{
  "$doc": "IL LESSICO DELL’EPOPEA, ITALIANO — tradotto dalla fonte francese fr.json (#11174 ; concezione docs/superpowers/specs/2026-10-20-epopee-du-jeu-design.md § 3.1 e § 4 ; glossario docs/product/epopee/glossaire/it.md). Formato: docs/product/epopee/glossaire/README.md. Letto dalla guardia web (apps/web/src/lib/game/epic-vocabulary.test.ts) e dalla guardia iOS (#11179). `banned`: i motivi che NESSUN valore dei cataloghi del gioco porta, parametri {…} esclusi; `names`: il valore esatto di ogni chiave di nome.",
  "language": "it",
  "banned": [
    {
      "pattern": "(?<![\\p{L}\\p{N}])aument\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "crescere, nutrire, risvegliarsi, brillare più forte"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])contator[ei](?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "il nome del concetto: «la tua gloria», «la tua Fiamma»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])valor[ei](?:\\s+real[ei])?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«la tua luce»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])convertibil[ei](?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«la tua luce»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])tasc(?:a|he)(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«la tua luce»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])potenzial[ei](?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "niente: si dice ciò che si possiede"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])debit[oi](?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«un’ombra vela N scintille della tua luce» (l’Ombra)"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])record(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«ricevute da sempre», «la tua luce più alta», «la tua Fiamma più lunga», «coniate da sempre»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])ancora(?![\\p{L}\\p{N}])[^.!?:;]*(?<![\\p{L}\\p{N}])prima(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "in piccolo, «N fino a X»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])cost(?:a|ano|o|i|are|erà|eranno|ava|ato|ata)(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "una frase: «fissa N scintille della tua luce»; il calcolo va nelle regole"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])rester(?:à|anno)(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "niente: nessuna sottrazione su una scheda"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])tariff\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«ogni gesto fa scaturire le sue»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])prezzo\\s+base(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "niente su una scheda: il calcolo vive nelle regole",
      "except": [
        "game.rules."
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])percentual\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "niente su una scheda: il calcolo vive nelle regole",
      "except": [
        "game.rules."
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])fattor[ei](?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "niente su una scheda: il calcolo vive nelle regole",
      "except": [
        "game.rules."
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])leg(?:a|he)(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«torneo»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:rang(?:o|hi)|posizion[ei])(?![\\p{L}\\p{N}])",
