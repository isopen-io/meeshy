    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])serie(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«Fiamma»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])mission[ei](?![\\p{L}\\p{N}])",
