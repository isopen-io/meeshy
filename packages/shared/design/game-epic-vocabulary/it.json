    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])forzier[ei]\\s+del\\s+giorno(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«l’Offerta»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])traguard[oi](?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«imprese»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])badge(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«medaglie»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])quadern[oi](?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«la Cronaca»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])costellazion[ei](?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«il cielo degli antenati» (Costellazione nomina solo il nono stato della luce)",
      "except": [
        "game.tier.constellation"
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])celebrazion[ei](?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«segno degli antenati»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])tapp[ae](?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«prova» (i dieci livelli), «sosta» (il viaggio); «tappa» nomina solo l’accoglienza",
      "keys": [
        "game."
      ],
      "except": [
        "game.guide.step_of",
        "game.rules.section_steps"
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])tesor[oi](?![\\p{L}\\p{N}])",
      "flags": "u",
      "instead": "«l’Eredità» (il Tesoro, con la maiuscola, nomina solo la quinta custodia)"
    },
    {
      "pattern": "\\+\\s*\\S+\\s+Gloria(?![\\p{L}\\p{N}])",
      "flags": "u",
      "instead": "«+250 di gloria»: minuscola in una frase, legata da «di»"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])vostr[aeio](?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "«tuo», «tua», «tuoi», «tue»: il gioco dà del tu",
