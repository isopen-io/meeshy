{
  "$doc": "LE LEXIQUE DE L’ÉPOPÉE, FRANÇAIS — la source (#11173 ; conception docs/superpowers/specs/2026-10-20-epopee-du-jeu-design.md § 3.1 et § 4 ; glossaire docs/product/epopee/glossaire/fr.md). Format : docs/product/epopee/glossaire/README.md. Lu par la garde web (apps/web/src/lib/game/epic-vocabulary.test.ts) et, demain, par la garde iOS (#11179). `banned` : les motifs qu’AUCUNE valeur des catalogues du jeu ne porte, paramètres {…} mis de côté ; `names` : la valeur exacte de chaque clé de nom.",
  "language": "fr",
  "banned": [
    {
      "pattern": "(?<![\\p{L}\\p{N}])augment\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "grandir, nourrir, s’éveiller, briller plus fort"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])compteurs?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "le nom du concept : « ta gloire », « ta Flamme »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])valeurs?(?:\\s+réelles?)?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« ta lumière »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])convertibles?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« ta lumière »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])en\\s+poche(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« ta lumière »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])potentiel(?:le)?s?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "rien : on dit ce qu’on possède"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])dettes?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« une ombre voile N étincelles de ta lumière » (l’Ombre)"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])records?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« reçues depuis toujours », « ta plus haute lumière », « ta plus longue Flamme », « frappées depuis toujours »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])encore(?![\\p{L}\\p{N}])[^.!?:;]*(?<![\\p{L}\\p{N}])avant(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "en petit, « N jusqu’à X »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])co[uû]t\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "une phrase : « elle fige N étincelles de ta lumière » ; le calcul va dans les règles"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])restera(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "rien : aucune soustraction sur une fiche"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])barèmes?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« chaque geste fait jaillir les siennes »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])prix\\s+de\\s+base(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "rien sur une fiche : le calcul vit dans les règles",
      "except": [
        "game.rules."
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])pourcentages?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "rien sur une fiche : le calcul vit dans les règles",
      "except": [
        "game.rules."
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])facteurs?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "rien sur une fiche : le calcul vit dans les règles",
      "except": [
        "game.rules."
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])ligues?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« joute »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])rangs?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« place » (la joute parle de place ; le rang est le nom du héros)",
      "keys": [
        "game.league.",
        "game.state.league.",
        "game.guide.moment.league",
        "game.trophy.league",
        "game.photo.title.league",
        "game.archive.week."
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])pseudonymes?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« nom de joute »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])duos?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« alliance »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])saisons?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« voyage » ; ses étoiles sont des « pas », ses étapes des « haltes »"
    },
    {
      "pattern": "(?<!d[’'])(?<![\\p{L}\\p{N}])étoiles?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« pas » (le voyage) ; « âges » (la renaissance)",
      "keys": [
        "game.season.",
        "game.prestige.",
        "game.fact.strides",
        "game.fact.rebirths"
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])prestiges?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« renaissance »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])gel(?:s|é|ée|és|ées|er)?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« Veilleuse »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])séries?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« Flamme »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])missions?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« le rêve » ; une mission est un « acte »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])coffres?\\s+du\\s+jour(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« l’Offrande »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])succès(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« hauts faits »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])badges?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« médailles »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])carnets?(?![\\p{L}\\p{N}])(?!\\s+des\\s+règles)",
      "flags": "iu",
      "instead": "« la Chronique » (seul le carnet des règles garde son nom)"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])constellations?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« le ciel des aïeux » (Constellation ne nomme plus que le neuvième état de la lumière)",
      "except": [
        "game.tier.constellation"
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])célébrations?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« signe des aïeux »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])étapes?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« épreuve » (les dix niveaux), « halte » (le voyage) ; « étape » ne nomme plus que l’accueil",
      "keys": [
        "game."
      ],
      "except": [
        "game.guide.step_of",
        "game.rules.section_steps"
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])trésors?(?![\\p{L}\\p{N}])",
      "flags": "u",
      "instead": "« l’Héritage » (le Trésor, avec sa majuscule, ne nomme plus que la cinquième réserve)"
    },
    {
      "pattern": "\\+\\s*\\S+\\s+Gloire(?![\\p{L}\\p{N}])",
      "flags": "u",
      "instead": "« +250 de gloire » : minuscule dans une phrase, liée par « de »"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:vos|votre)(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "« ton », « ta », « tes » : le jeu tutoie"
    }
  ],
