{
  "$doc": "LE LEXIQUE DE L’ÉPOPÉE, ALLEMAND — traduit de fr.json (#11174 ; conception docs/superpowers/specs/2026-10-20-epopee-du-jeu-design.md § 3.1 et § 4 ; glossaire docs/product/epopee/glossaire/de.md). Format : docs/product/epopee/glossaire/README.md. Lu par la garde web (apps/web/src/lib/game/epic-vocabulary.test.ts) et, demain, par la garde iOS (#11179). `banned` : les mots comptables de l’allemand qu’AUCUNE valeur des catalogues du jeu ne porte, paramètres {…} mis de côté ; `names` : la valeur exacte de chaque clé de nom.",
  "language": "de",
  "banned": [
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:erhöh|steiger)\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "wachsen, nähren, erwachen, heller leuchten"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:\\p{L}+-)?(?:Punkte|Funken|Ruhm|Flammen)?zähler(?:s|n)?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "der Name des Konzepts: „dein Ruhm“, „deine Flamme“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:\\p{Lu}\\p{Ll}*w|W)ert(?:e|es|en)?(?![\\p{L}\\p{N}])",
      "flags": "u",
      "instead": "„dein Licht“ (das Adjektiv „wert“ bleibt erlaubt: „ist 250 Ruhm wert“)"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])umwandel\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„dein Licht“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])Taschen?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„dein Licht“ (statt „in der Tasche“)"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])potenzi\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "nichts: man sagt, was man besitzt"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*schulden?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„ein Schatten verhüllt N Funken deines Lichts“ (der Schatten)"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*rekord\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„seit jeher empfangen“, „dein hellstes Licht“, „deine längste Flamme“, „seit jeher geprägt“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])noch(?![\\p{L}\\p{N}])[^.!?:;]*(?<![\\p{L}\\p{N}])bis(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "klein, „N bis X“ (ohne „noch“)"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:kost(?:e|est|et|eten|en)|Kosten)(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "ein Satz: „sie bannt N Funken deines Lichts“; die Rechnung steht in den Regeln"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:übrig|verbleib)\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "nichts: keine Subtraktion auf einem Blatt"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*(?:tabelle|schema)\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„jede Geste lässt ihre eigenen Funken sprühen“ (statt einer Punktetabelle)"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])grundpreis\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "nichts auf einem Blatt: die Rechnung steht in den Regeln",
      "except": [
        "game.rules."
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])prozents[aä]tz\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "nichts auf einem Blatt: die Rechnung steht in den Regeln",
      "except": [
        "game.rules."
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])faktor(?:en)?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "nichts auf einem Blatt: die Rechnung steht in den Regeln",
      "except": [
        "game.rules."
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:\\p{L}*liga\\p{L}*|Ligen)(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„Turnier“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*r[aä]ng\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„Platz“ (das Turnier spricht vom Platz; der Rang ist der Name des Helden)",
      "keys": [
        "game.league.",
        "game.state.league.",
        "game.guide.moment.league",
        "game.trophy.league",
        "game.photo.title.league",
        "game.archive.week."
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*pseudonym\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„Turniername“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*duos?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„Bündnis“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*saison\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„Reise“; ihre Sterne sind „Schritte“, ihre Etappen „Rasten“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*stern(?:e|en)?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„Schritte“ (die Reise); „Zeitalter“ (die Wiedergeburt); „Stufen“ (eine Medaille)",
      "keys": [
        "game.season.",
        "game.prestige.",
        "game.fact.strides",
        "game.fact.rebirths",
        "game.badge.stars_label"
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*prestige\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„Wiedergeburt“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:\\p{L}+-)?(?:Eis|Frost|Freeze)(?![\\p{L}\\p{N}])|(?<![\\p{L}\\p{N}])\\p{L}*(?:einfrier|eingefror)\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„Hüterin“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*(?:serie|streak|strähne)\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„Flamme“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*mission\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„der Traum“; eine Mission ist ein „Akt“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:Tagestruhe\\p{L}*|Truhe\\s+des\\s+Tages)(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„die Gabe“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])Erfolg(?:e|es|en|s)?(?![\\p{L}\\p{N}])",
      "flags": "u",
      "instead": "„Heldentaten“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*abzeichen\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„Medaillen“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*[Hh]eft(?:e|es)?(?![\\p{L}\\p{N}])",
      "flags": "u",
      "instead": "„die Chronik“"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*sternbild\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„der Himmel der Ahnen“ (Sternbild nennt nur noch die neunte Gestalt des Lichts)",
      "except": [
        "game.tier.constellation"
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])Feier(?:n|lichkeit\\p{L}*)?(?![\\p{L}\\p{N}])",
      "flags": "u",
      "instead": "„Zeichen der Ahnen“ (das Verb „feiern“ bleibt erlaubt)"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])\\p{L}*etappe\\p{L}*(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„Prüfung“ (die zehn Level), „Rast“ (die Reise); „Etappe“ nennt nur noch die Einführung",
      "keys": [
        "game."
      ],
      "except": [
        "game.guide.step_of",
        "game.rules.section_steps"
      ]
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:dein(?:en|em|es)?\\s+Schatz\\p{L}*|des\\s+Schatzes|Schatzes|Schätze\\p{L}*|Schatz\\p{L}+)(?![\\p{L}\\p{N}])",
      "flags": "u",
      "instead": "„das Erbe“ (der Schatz nennt nur noch die fünfte Reserve)"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])(?:Ihnen|Ihre|Ihren|Ihrem|Ihrer|Ihres)(?![\\p{L}\\p{N}])",
      "flags": "u",
      "instead": "„dein“, „deine“: das Spiel duzt"
    },
    {
      "pattern": "(?<![\\p{L}\\p{N}])flammen?(?![\\p{L}\\p{N}])",
      "flags": "iu",
      "instead": "„N Tage“ unter 🔥: die Flamme gehört dem Helden, nie einem Gespräch",
      "keys": [
        "engagement.pill.streak."
      ]
    }
