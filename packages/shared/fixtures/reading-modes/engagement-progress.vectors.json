        "levelProgress": 1,
        "streakNext": null,
        "streakProgress": 1,
        "streakReached": 6,
        "badgesEarned": 5,
        "isEmpty": false,
        "achievements": [],
        "axes": { "tool.sticker": { "reachedCount": 5, "nextThreshold": null, "progress": 1 } }
      }
    },
    {
      "_label": "deux succès débloqués, dans l'ordre du catalogue quel que soit l'ordre servi",
      "input": {
        "counters": [
          { "axisKey": "content.audio_message", "count": 1 },
          { "axisKey": "content.text_message", "count": 2 }
        ],
        "milestones": [
          { "milestoneType": "achievement", "milestoneKey": "achievement.first_voice", "reachedAt": "2026-09-03T12:00:00.000Z" },
          { "milestoneType": "achievement", "milestoneKey": "achievement.first_content", "reachedAt": "2026-09-03T11:00:00.000Z" }
        ],
        "streak": { "currentStreakDays": 2, "longestStreakDays": 2 },
        "level": { "engagementScore": 9 }
