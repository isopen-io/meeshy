          "content.story": { "reachedCount": 2, "nextThreshold": 50, "progress": 0.5 },
          "comment.text": { "reachedCount": 1, "nextThreshold": 10, "progress": 0.444444 },
          "conversation.private": { "reachedCount": 1, "nextThreshold": 10, "progress": 0.222222 }
        }
      }
    },
    {
      "_label": "échelles complètes — plus de palier suivant, barres à 1",
      "input": {
        "counters": [{ "axisKey": "tool.sticker", "count": 500 }],
        "milestones": [],
        "streak": { "currentStreakDays": 100, "longestStreakDays": 120 },
