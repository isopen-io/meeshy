{
  "$format": {
    "input": "EngagementProgressPayload — la charge EXACTE de GET /me/engagement (#5670) : counters[{axisKey,count}], milestones[{milestoneType,milestoneKey,reachedAt}], streak{currentStreakDays,longestStreakDays}, level{engagementScore}.",
    "expected": "PROJECTION de resolveEngagementProgress (packages/shared/utils/engagement-progress.ts) : { level, levelNext (null au sommet), levelProgress, streakNext, streakProgress, streakReached, badgesEarned, isEmpty, achievements: [clés DÉBLOQUÉES, ordre du catalogue], axes: { axisKey: { reachedCount, nextThreshold, progress } } — seuls les axes dont value > 0 OU reachedCount > 0 figurent }. Les fractions sont comparées à 1e-4.",
    "provenance": "Contrat cross-plateforme de la loi de progression (#5547 web, #5698 iOS). TS le rejoue (__tests__/vectors/engagement-progress.vectors.test.ts) et iOS aussi (apps/ios/MeeshyTests/Unit/Engagement/EngagementProgressVectorTests.swift, via EngagementProgressResolver). Sur divergence entre ce fichier et le TS, c'est le TS qui a raison — le miroir bouge, jamais le vecteur sans lui."
  },
  "vectors": [
    {
      "_label": "aucune activité — état vide, premiers paliers pointés",
      "input": {
        "counters": [],
        "milestones": [],
        "streak": { "currentStreakDays": 0, "longestStreakDays": 0 },
        "level": { "engagementScore": 0 }
      },
      "expected": {
        "level": 0,
        "levelNext": 10,
        "levelProgress": 0,
        "streakNext": 3,
        "streakProgress": 0,
        "streakReached": 0,
        "badgesEarned": 0,
        "isEmpty": true,
        "achievements": [],
        "axes": {}
      }
    },
    {
      "_label": "douze messages texte — deux badges, pas mesuré depuis le palier 10",
      "input": {
        "counters": [{ "axisKey": "content.text_message", "count": 12 }],
        "milestones": [
          { "milestoneType": "badge", "milestoneKey": "content.text_message:1", "reachedAt": "2026-09-01T08:00:00.000Z" },
          { "milestoneType": "badge", "milestoneKey": "content.text_message:10", "reachedAt": "2026-09-04T08:00:00.000Z" },
          { "milestoneType": "level", "milestoneKey": "level:10", "reachedAt": "2026-09-02T08:00:00.000Z" },
          { "milestoneType": "achievement", "milestoneKey": "achievement.first_content", "reachedAt": "2026-09-01T08:00:00.000Z" }
        ],
        "streak": { "currentStreakDays": 1, "longestStreakDays": 1 },
        "level": { "engagementScore": 36 }
      },
      "expected": {
        "level": 1,
        "levelNext": 50,
        "levelProgress": 0.65,
        "streakNext": 3,
        "streakProgress": 0.333333,
        "streakReached": 0,
        "badgesEarned": 2,
        "isEmpty": false,
        "achievements": ["achievement.first_content"],
        "axes": { "content.text_message": { "reachedCount": 2, "nextThreshold": 50, "progress": 0.05 } }
      }
    },
    {
      "_label": "palier gravé sans compteur — un badge servi ne se reprend pas",
      "input": {
        "counters": [],
        "milestones": [{ "milestoneType": "badge", "milestoneKey": "content.post:1", "reachedAt": "2026-08-30T00:00:00.000Z" }],
        "streak": { "currentStreakDays": 0, "longestStreakDays": 0 },
        "level": { "engagementScore": 0 }
      },
      "expected": {
        "level": 0,
        "levelNext": 10,
        "levelProgress": 0,
        "streakNext": 3,
        "streakProgress": 0,
        "streakReached": 0,
        "badgesEarned": 1,
        "isEmpty": false,
        "achievements": [],
        "axes": { "content.post": { "reachedCount": 1, "nextThreshold": 1, "progress": 0 } }
      }
    },
    {
      "_label": "axe et paliers hors catalogue — ignorés, l'écran reste vide",
      "input": {
        "counters": [{ "axisKey": "content.future", "count": 99 }],
        "milestones": [
          { "milestoneType": "badge", "milestoneKey": "content.future:10", "reachedAt": "2026-09-01T00:00:00.000Z" },
          { "milestoneType": "badge", "milestoneKey": "content.post:7", "reachedAt": "2026-09-01T00:00:00.000Z" },
          { "milestoneType": "streak", "milestoneKey": "streak:5", "reachedAt": "2026-09-01T00:00:00.000Z" }
        ],
        "streak": { "currentStreakDays": 0, "longestStreakDays": 0 },
        "level": { "engagementScore": 0 }
      },
      "expected": {
        "level": 0,
        "levelNext": 10,
        "levelProgress": 0,
        "streakNext": 3,
        "streakProgress": 0,
        "streakReached": 0,
        "badgesEarned": 0,
        "isEmpty": true,
        "achievements": [],
        "axes": {}
      }
    },
    {
