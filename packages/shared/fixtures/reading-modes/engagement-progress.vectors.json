        "milestones": [
          { "milestoneType": "level", "milestoneKey": "level:150", "reachedAt": "2026-09-02T00:00:00.000Z" },
          { "milestoneType": "streak", "milestoneKey": "streak:7", "reachedAt": "2026-08-20T00:00:00.000Z" }
