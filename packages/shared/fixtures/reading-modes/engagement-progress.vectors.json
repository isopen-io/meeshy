        "levelNext": 10,
        "levelProgress": 0.9,
        "streakNext": 3,
        "streakProgress": 0.666667,
        "streakReached": 0,
        "badgesEarned": 2,
        "isEmpty": false,
        "achievements": ["achievement.first_content", "achievement.first_voice"],
        "axes": {
          "content.audio_message": { "reachedCount": 1, "nextThreshold": 10, "progress": 0 },
          "content.text_message": { "reachedCount": 1, "nextThreshold": 10, "progress": 0.111111 }
