# Version files (auto-generated)
**/shared/version.txt
frontend/shared/version.txt
gateway/shared/version.txt
translator/shared/version.txt
post-*
# `post-*` above is unqualified and matches by BASENAME at any depth — it silently
# swallows real source files named `post-<word>.ts` (lived masked until caught here,
# 2026-08-19: packages/shared/types/post-reference.ts). Un-ignore known source files
# individually rather than narrowing the pattern blind, since its original intent
# (likely a stray root-level artifact) is undocumented.
!packages/shared/types/post-reference.ts
!services/gateway/src/__tests__/unit/post-service-mocks.ts
!apps/web/__tests__/hooks/post-translation-map-single-source.test.ts
!services/gateway/src/__tests__/unit/post-service-geo-discoverability.test.ts
!packages/shared/fixtures/canvas-v3/post-carousel-sound-library.json
!packages/shared/fixtures/canvas-v3/post-sound-original.json
!apps/web/__tests__/components/post-card-repost-attribution.test.tsx
!apps/web/__tests__/components/post-detail-repost-attribution.test.tsx
!apps/web/__tests__/components/post-detail-background-sound.test.tsx

