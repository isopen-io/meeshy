    <string name="circles_ritual_consent_listening_title">Title of what I\'m listening to</string>
    <string name="circles_ritual_consent_listening_title_detail">They see the title and source, live, while sharing is on.</string>
    <string name="circles_ritual_consent_listening_title_folding">A title can say a lot about you (beliefs, opinions, tastes). Nothing is kept once listening ends. You can exclude apps.</string>
    <string name="circles_ritual_consent_location_history">My location history (30 days)</string>
    <string name="circles_ritual_consent_location_history_detail">They can review my movements of the last 30 days; I can erase them whenever I want.</string>
    <string name="circles_ritual_consent_location_history_folding">Meeshy keeps your locations for 30 days, encrypted on its servers, then deletes them. Nothing is recorded in ghost mode.</string>
    <string name="circles_ritual_consent_location_live">My live location</string>
    <string name="circles_ritual_consent_location_live_detail">They see where I am, continuously, while sharing is on.</string>
    <string name="circles_ritual_consent_location_live_folding">Even when the app is closed. You always know when it is on (banner). Ghost mode hides you without anyone knowing. You see who looked at your location and when (30 days). You stop it in one gesture. We will ask you again in 30 days.</string>
    <string name="circles_ritual_consent_location_proximity">The proximity alert</string>
    <string name="circles_ritual_consent_location_proximity_detail">We are both notified, at most once every 2 hours, when we are close.</string>
    <string name="circles_ritual_consent_location_proximity_folding">Only if %1$s has accepted it too. Nothing about the place is kept.</string>
