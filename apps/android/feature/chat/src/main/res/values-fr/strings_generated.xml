    <string name="encryption_fact_device_limit">Votre compte peut avoir jusqu’à 16 appareils chiffrés. Au-delà, l’application vous propose d’en retirer un ; un appareil retiré ne lit plus les nouveaux messages chiffrés.</string>
    <string name="encryption_fact_encrypted_on_server_server_reads">Vos messages sont chiffrés sur nos serveurs. Traduction, transcription et recherche fonctionnent.</string>
    <string name="encryption_fact_end_to_end_is_final">Une fois activé, le chiffrement de bout en bout ne se désactive plus.</string>
    <string name="encryption_fact_end_to_end_never_turned_off">Le chiffrement de bout en bout ne se désactive jamais. Vous pourrez toujours ouvrir une autre conversation, sans chiffrement de bout en bout, avec les mêmes personnes.</string>
    <string name="encryption_fact_end_to_end_never_turned_off_direct">Le chiffrement de bout en bout ne se désactive jamais : ce tête-à-tête le reste. Vous pourrez toujours ouvrir à côté une autre conversation, sans chiffrement de bout en bout, avec cette personne : les deux sont dans la liste, celle-ci marquée d’un cadenas.</string>
    <string name="encryption_fact_every_server_feature">Toutes les fonctions sont disponibles : traduction automatique, transcription des vocaux, aperçu des notifications, recherche.</string>
    <string name="encryption_fact_group_sending_unavailable">Dans ce groupe, l’application ne peut pas encore envoyer de message chiffré.</string>
    <string name="encryption_fact_hybrid_is_server_today">Le mode hybride chiffre aujourd’hui comme Serveur. Le double chiffrement par vos appareils arrive bientôt.</string>
    <string name="encryption_fact_no_edit">Un message envoyé ne peut pas être modifié.</string>
    <string name="encryption_fact_no_forward">Un message ne peut pas être transféré.</string>
    <string name="encryption_fact_no_notification_preview">Les notifications n’affichent pas le texte du message : le serveur ne le connaît pas.</string>
    <string name="encryption_fact_no_offline_sending">Hors connexion, un message n’est pas mis en attente : renvoyez-le une fois connecté.</string>
    <string name="encryption_fact_no_search">La recherche du serveur ne trouve pas ces messages.</string>
    <string name="encryption_fact_no_server_transcription">Le serveur ne transcrit pas les messages vocaux.</string>
    <string name="encryption_fact_not_yet_attachments">Photos, vidéos, fichiers, vocaux, lieux et stickers ne peuvent pas encore être envoyés.</string>
    <string name="encryption_fact_not_yet_decrypted_notifications">Le déchiffrement des notifications sur l’appareil, pour en afficher le texte, n’est pas encore disponible.</string>
    <string name="encryption_fact_not_yet_groups">Le chiffrement de bout en bout des groupes n’est pas encore disponible dans l’application.</string>
    <string name="encryption_fact_not_yet_safety_numbers">La vérification des numéros de sécurité avec vos contacts n’est pas encore disponible.</string>
    <string name="encryption_fact_one_key_per_device">Chaque appareil a sa propre clé, qui ne le quitte jamais.</string>
    <string name="encryption_fact_only_participants_read">Seuls vos appareils et ceux des participants lisent les messages.</string>
    <string name="encryption_fact_restored_device_is_new">Un appareil réinstallé ou restauré compte comme un nouvel appareil : il ne lit pas les messages chiffrés reçus avant.</string>
    <string name="encryption_fact_server_cannot_turn_it_off">Sur cet appareil, une fois cette conversation vue chiffrée de bout en bout, votre compte n’y écrit plus jamais sans chiffrement de bout en bout, même si le serveur la présentait ensuite autrement.</string>
    <string name="encryption_fact_stored_without_encryption">Cette conversation a été créée avant le chiffrement systématique : ses messages sont stockés sans chiffrement.</string>
    <string name="encryption_fact_switch_is_shown_in_thread">Chaque changement de mode s’affiche dans le fil, pour tous les membres.</string>
    <string name="encryption_fact_switch_keeps_history">Une bascule ne change que les nouveaux messages : ceux déjà chiffrés de bout en bout le restent, lisibles sur les appareils qui les ont reçus.</string>
    <string name="encryption_fact_transit_protected">Entre votre appareil et le serveur, les messages voyagent toujours protégés.</string>
    <string name="encryption_fact_translated_on_device">La traduction automatique se fait sur votre appareil, jamais sur le serveur.</string>
    <string name="encryption_fact_who_may_toggle">Pendant la phase de test, seuls les membres de la conversation qui ont un rôle d’équipe Meeshy (analyste ou plus) peuvent changer de mode ; dans un groupe, il faut aussi en être modérateur. Le chiffrement ne se désactive pas.</string>
