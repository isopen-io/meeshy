<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Exported GDPR data files written to context.cacheDir/exports for the share sheet. -->
    <cache-path
        name="exports"
        path="exports/" />
    <!-- Feed-composer camera-photo captures written to context.cacheDir/captures before
         being read back and uploaded (feature-parity §F, ActivityResultContracts.TakePicture). -->
    <cache-path
        name="captures"
        path="captures/" />
    <!-- Fullscreen viewer "Share outside Meeshy": a local copy of the viewed media, handed
         to the system share sheet (GalleryMediaSharer). -->
    <cache-path
        name="shared-media"
        path="shared-media/" />
    <!-- Composer "Transférer" : the MP4 baked from the scene, handed to the system share sheet
         (SceneExportCoordinator). Swept at the next export. -->
    <cache-path
        name="scene-exports"
        path="scene-exports/" />
</paths>
