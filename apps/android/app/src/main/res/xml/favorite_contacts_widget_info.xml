<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidgetProviderInfo for FavoriteContactsWidget (me.meeshy.app.widget).
  Resizable multi-row face — parity target: iOS MeeshyWidgets.FavoriteContactsWidget
  (`.systemMedium`/`.systemLarge`). `initialLayout` uses Glance's own predefined
  loading layout (no custom XML layout needed — Glance replaces it once composed).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="360dp"
    android:updatePeriodMillis="1800000"
    android:description="@string/widget_favorite_contacts_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
