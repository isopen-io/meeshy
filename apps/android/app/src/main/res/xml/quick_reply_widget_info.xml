<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidgetProviderInfo for QuickReplyWidget (me.meeshy.app.widget).
  Resizable single-conversation face — parity target: iOS
  MeeshyWidgets.QuickReplyWidget (`.systemMedium`/`.systemLarge`). `initialLayout`
  uses Glance's own predefined loading layout (no custom XML layout needed —
  Glance replaces it once composed).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="220dp"
    android:updatePeriodMillis="1800000"
    android:description="@string/widget_quick_reply_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
