<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidgetProviderInfo for UnreadCountWidget (me.meeshy.app.widget).
  Small single-cell face — parity target: iOS MeeshyWidgets.UnreadCountWidget's
  `.systemSmall` face. `initialLayout` uses Glance's own predefined loading
  layout (no custom XML layout needed — Glance replaces it once composed).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="180dp"
    android:maxResizeHeight="180dp"
    android:updatePeriodMillis="1800000"
    android:description="@string/widget_unread_count_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview_unread"
    android:previewImage="@drawable/widget_preview_unread"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
