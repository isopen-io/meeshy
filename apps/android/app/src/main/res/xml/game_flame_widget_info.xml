<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidgetProviderInfo de GameFlameWidget (« Ma Flamme », #20566) — miroir de la face `.systemSmall` du widget iOS
  `MeeshyWidgets.GameFlameWidget`. Le widget se repeint quand le bloc `game` caché change
  (GameFlameWidgetRepaintInitializer) : `updatePeriodMillis` n'est que le filet. Aucune description au sélecteur :
  le titre « Ma Flamme » suffit, et le cliquet de verbosité (#17584) n'admet aucun libellé d'explication de plus.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="180dp"
    android:maxResizeHeight="180dp"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview_game_flame"
    android:previewImage="@drawable/widget_preview_game_flame"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
