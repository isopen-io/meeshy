{
  "name": "@meeshy/web-old-version3",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "dev:https": "node scripts/dev-https.mjs -p 3300",
    "build": "node scripts/build-participate.mjs && next build && node scripts/check-app-router-built.mjs && node scripts/check-bundle-budget.mjs",
    "start": "next start -p 3300 -H 0.0.0.0",
    "lint": "eslint . && node scripts/check-jetons.mjs",
    "type-check": "tsc --noEmit",
    "test": "jest --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --maxWorkers=50%",
    "e2e:run": "CHROMIUM_PATH=\"${CHROMIUM_PATH:-$(node -e \"process.stdout.write(require('../../scripts/lib/navigateur.cjs').chromiumPath())\")}\" playwright test",
    "e2e": "npm run test:pages && npm run test:chaines && npm run test:gestes-moteurs",
    "clean": "rm -rf .next node_modules",
    "baseline": "node scripts/baseline.mjs",
    "test:a11y": "CHROMIUM_PATH=\"${CHROMIUM_PATH:-$(node -e \"process.stdout.write(require('../../scripts/lib/navigateur.cjs').chromiumPath())\")}\" playwright test e2e/visual/v3-a11y.spec.ts",
    "test:cibles": "CHROMIUM_PATH=\"${CHROMIUM_PATH:-$(node -e \"process.stdout.write(require('../../scripts/lib/navigateur.cjs').chromiumPath())\")}\" playwright test e2e/visual/v3-cibles.spec.ts",
    "test:fil-a11y": "CHROMIUM_PATH=\"${CHROMIUM_PATH:-$(node -e \"process.stdout.write(require('../../scripts/lib/navigateur.cjs').chromiumPath())\")}\" playwright test e2e/visual/v3-fil-a11y.spec.ts",
    "test:lifecycle": "CHROMIUM_PATH=\"${CHROMIUM_PATH:-$(node -e \"process.stdout.write(require('../../scripts/lib/navigateur.cjs').chromiumPath())\")}\" playwright test e2e/visual/v3-lifecycle.spec.ts",
    "test:pages": "npm run e2e:run -- --project=pages",
    "test:chaines": "npm run e2e:run -- --project=chaines",
    "test:gestes-moteurs": "npm run e2e:run -- --project=gestes-webkit --project=gestes-firefox"
  },
  "dependencies": {
    "@meeshy/design-tokens": "workspace:*",
    "@meeshy/icons": "workspace:*",
    "@meeshy/shared": "workspace:*",
    "libphonenumber-js": "^1.13.12",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.6",
    "@next/eslint-plugin-next": "15.5.23",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.48.2",
    "@typescript-eslint/parser": "^8.48.2",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.4",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.4.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "socket.io": "^4.8.3",
    "typescript": "^6.0.3"
  },
  "description": "D\u00c9COMMISSIONN\u00c9E (2026-09-07) \u2014 ancienne refonte v3, jamais servie en production. Conserv\u00e9e pour son historique et sa conception ; remplac\u00e9e par apps/web-v3 (ex web-v4)."
}
