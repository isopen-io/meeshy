{
  "name": "@meeshy/web-v3",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "La v3.1 web — une application TypeScript unique, servie en web, installable en PWA, empaquetable Android/iOS par Capacitor. Interface reprise de l'app iOS.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:react": "MEESHY_RUNTIME=react vite build",
    "preview": "vite preview --port 4173",
    "type-check": "tsc --noEmit",
    "mesure": "node scripts/mesure-poids.mjs",
    "cap:sync": "cap sync",
    "test": "bun test",
    "gate": "bun run check:jetons && node scripts/verifie-courbe.mjs && bun run type-check && bun test && bun run build && node scripts/mesure-poids.mjs && node scripts/verifie-institutionnel.mjs && node scripts/verifie-lentille.mjs && node scripts/verifie-contexte-docker.mjs && node scripts/verifie-suivi-git.mjs",
    "check:jetons": "node ../../packages/design-tokens/scripts/genere-depuis-ios.mjs --verifie",
    "verifie:jetons": "node scripts/verifie-jetons.mjs",
    "test:coverage": "bun test --coverage",
    "verifie:institutionnel": "node scripts/verifie-institutionnel.mjs",
    "verifie:contexte": "node scripts/verifie-contexte-docker.mjs",
    "verifie:suivi": "node scripts/verifie-suivi-git.mjs",
    "verifie:courbe": "node scripts/verifie-courbe.mjs",
    "verifie:lentille": "node scripts/verifie-lentille.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "preact": "10.29.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@meeshy/design-tokens": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "preact-render-to-string": "6.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0"
  },
  "optionalDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1"
  }
}
