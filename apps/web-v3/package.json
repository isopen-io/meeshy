{
  "name": "@meeshy/web-v3",
  "version": "3.1.1",
  "private": true,
  "type": "module",
  "description": "La v3.1 web — une application TypeScript unique, servie en web, installable en PWA, empaquetable Android/iOS par Capacitor. Interface reprise de l'app iOS.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:react": "MEESHY_RUNTIME=react vite build",
    "preview": "vite preview --port 4173",
    "type-check": "tsc --noEmit",
    "measure": "node scripts/measure-weight.mjs",
    "cap:sync": "cap sync",
    "test": "bun test",
    "gate": "bun run check:tokens && bun run check:countries && bun run check:brand-assets && node scripts/check-curve.mjs && node scripts/check-river-metrics.mjs && bun run type-check && bun test && bun run build && node scripts/check-utilities.mjs && node scripts/measure-weight.mjs && node scripts/check-institutional.mjs && node scripts/check-scheme-bootstrap.mjs && node scripts/check-lens.mjs && node scripts/check-list-actions.mjs && node scripts/check-thread-states.mjs && node scripts/check-thread-virtualization.mjs && node scripts/check-reading-mode.mjs && node scripts/check-field-focus.mjs && node scripts/check-docker-context.mjs && node scripts/check-git-tracking.mjs && node scripts/check-shell-dist.mjs && node scripts/check-gateway-build.mjs",
    "check:tokens": "node ../../packages/design-tokens/scripts/generate-from-ios.mjs --check",
    "check:countries": "node scripts/generate-countries.mjs --check",
    "check:brand-assets": "python3 scripts/generate-icons.py --check",
    "check:tokens-resolved": "node scripts/check-tokens.mjs",
    "test:coverage": "bun test --coverage",
    "check:institutional": "node scripts/check-institutional.mjs",
    "check:scheme-bootstrap": "node scripts/check-scheme-bootstrap.mjs",
    "check:docker-context": "node scripts/check-docker-context.mjs",
    "check:git-tracking": "node scripts/check-git-tracking.mjs",
    "check:curve": "node scripts/check-curve.mjs",
    "check:river-metrics": "node scripts/check-river-metrics.mjs",
    "check:lens": "node scripts/check-lens.mjs",
    "check:utilities": "node scripts/check-utilities.mjs",
    "check:virtualization": "node scripts/check-thread-virtualization.mjs",
    "check:states": "node scripts/check-thread-states.mjs",
    "check:reading-mode": "node scripts/check-reading-mode.mjs",
    "check:list-actions": "node scripts/check-list-actions.mjs",
    "check:shell-dist": "node scripts/check-shell-dist.mjs",
    "check:gateway-build": "node scripts/check-gateway-build.mjs",
    "build:shells": "node scripts/build-shells.mjs"
  },
  "dependencies": {
    "@meeshy/shared": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.10",
    "preact": "10.29.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@meeshy/design-tokens": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "preact-render-to-string": "6.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0"
  },
  "optionalDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1"
  }
}
