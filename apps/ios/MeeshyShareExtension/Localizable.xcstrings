    "share.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Meeshy مرة واحدة للعثور على محادثاتك هنا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Meeshy einmal, um deine Unterhaltungen hier zu sehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Meeshy once to find your conversations here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Meeshy una vez para ver aquí tus conversaciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Meeshy une fois pour retrouver vos conversations ici"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Meeshy una volta per trovare qui le tue conversazioni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Meeshy uma vez para ver suas conversas aqui"
          }
        }
      }
    },
    "share.media.count": {
