    "share.media.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحضير بعض الملفات. نزّلها أولاً ثم أعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien konnten nicht vorbereitet werden. Laden Sie sie zuerst herunter und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files could not be prepared. Download them first, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos archivos no se pudieron preparar. Descárgalos primero y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers n'ont pas pu être préparés. Téléchargez-les d'abord, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni file non sono stati preparati. Scaricali prima e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos não puderam ser preparados. Baixe-os primeiro e tente novamente."
          }
        }
      }
    },
