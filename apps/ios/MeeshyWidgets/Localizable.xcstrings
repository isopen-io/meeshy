        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the unread badge for this conversation from the widget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra el indicador de no leído de esta conversación desde el widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface le badge non lu de cette conversation depuis le widget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove il badge non letto di questa conversazione dal widget."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o indicador de não lida desta conversa a partir do widget."
          }
        }
      }
