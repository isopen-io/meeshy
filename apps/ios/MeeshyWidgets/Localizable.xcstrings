    "widget.intent.markRead.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل شارة غير المقروء لهذه المحادثة من الأداة."
          }
        },
