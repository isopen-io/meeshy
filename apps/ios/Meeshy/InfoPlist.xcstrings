    "NSAlarmKitUsageDescription" : {
      "comment" : "AlarmKit: the alarm that rings when a Bring arrives",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرع Meeshy منبّهًا على آيفون عندما يرسل لك صديق «Bring»، أي حالة طارئة قصوى، حتى في الوضع الصامت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy lässt auf deinem iPhone einen Wecker klingeln, wenn dir ein Freund einen Bring sendet, einen extremen Notfall, auch im Lautlos-Modus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy rings an alarm on your iPhone when a friend sends you a Bring, an extreme emergency, even in silent mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy hace sonar una alarma en tu iPhone cuando un amigo te envía un Bring, una urgencia extrema, incluso en modo silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy fait sonner une alarme sur ton iPhone quand un ami t’envoie un Bring, une urgence extrême, même en mode silencieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy fa suonare una sveglia sul tuo iPhone quando un amico ti invia un Bring, un’emergenza estrema, anche in modalità silenziosa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meeshy faz tocar um alarme no seu iPhone quando um amigo envia um Bring, uma emergência extrema, mesmo no modo silencioso."
          }
        }
      }
    },
    "NSAppleMusicUsageDescription" : {
      "comment" : "Privacy - Media Library Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Meeshy المقطع الذي يعمل في Apple Music لمشاركته مع المقرّبين الذين منحتهم ذلك، ومعهم فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy liest den Titel, der in Apple Music läuft, um ihn mit den Nahestehenden zu teilen, denen du es gewährt hast – und nur mit ihnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy reads the song playing in Apple Music to share it with the Close friends you granted it to, and only with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy lee la canción que suena en Apple Music para compartirla con los Cercanos a quienes se lo concediste, y solo con ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy lit le morceau qui joue dans Apple Music pour le partager avec les Proches à qui vous l’avez accordé, et seulement avec eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy legge il brano in riproduzione su Apple Music per condividerlo con i Vicini a cui l’hai concesso, e solo con loro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meeshy lê a música que está tocando no Apple Music para compartilhá-la com os Próximos a quem você concedeu, e só com eles."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Meeshy إلى الوصول إلى الكاميرا لالتقاط الصور وتصوير الفيديو للرسائل ومكالمات الفيديو وتجارب الواقع المعزّز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy benötigt Zugriff auf Ihre Kamera, um Fotos und Videos für Nachrichten, Videoanrufe und AR-Erlebnisse aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy needs access to your camera to take photos and videos for messages, video calls, and AR experiences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy necesita acceso a tu cámara para tomar fotos y videos para mensajes, videollamadas y experiencias AR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy a besoin d'accéder à votre caméra pour prendre des photos et vidéos pour les messages, les appels vidéo et les expériences AR."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy ha bisogno di accedere alla fotocamera per scattare foto e girare video per i messaggi, le videochiamate e le esperienze in realtà aumentata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meeshy precisa de acesso à sua câmera para tirar fotos e gravar vídeos para mensagens, chamadas de vídeo e experiências AR."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Meeshy جهات اتصالك للعثور على أصدقائك الموجودين على Meeshy وإخطارك عند انضمام أحدهم. لن يتواصل أحد مع أي شخص نيابةً عنك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy nutzt Ihre Kontakte, um Freunde zu finden, die schon auf Meeshy sind, und Sie zu benachrichtigen, wenn einer von ihnen dazukommt. Niemand wird in Ihrem Namen kontaktiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy uses your contacts to find friends who are already on Meeshy and let you know when one of them joins. No one is contacted on your behalf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy usa tus contactos para encontrar a los amigos que ya están en Meeshy y avisarte cuando uno de ellos llegue. Nadie recibe mensajes en tu nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy utilise vos contacts pour retrouver vos amis déjà sur Meeshy et vous prévenir quand l'un d'eux arrive. Personne n'est contacté à votre place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy usa i tuoi contatti per ritrovare gli amici già su Meeshy e avvisarti quando uno di loro arriva. Nessuno viene contattato al posto tuo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meeshy usa seus contatos para encontrar amigos que já estão no Meeshy e avisar você quando um deles chegar. Ninguém é contatado em seu nome."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Meeshy تقنية Face ID لمصادقة آمنة وسهلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy verwendet Face ID für eine sichere und bequeme Authentifizierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy uses Face ID to provide secure and convenient authentication."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy utiliza Face ID para proporcionar una autenticación segura y práctica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy utilise Face ID pour fournir une authentification sécurisée et pratique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy usa Face ID per un'autenticazione sicura e comoda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meeshy usa o Face ID para fornecer autenticação segura e prática."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بموافقتك، يقرأ Meeshy فقط وقت حالات السقوط التي ترصدها ساعة Apple Watch، لتنبيه أفراد عائلتك فورًا. لا تتم قراءة أو إرسال أي بيانات صحية أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit deiner Einwilligung liest Meeshy nur den Zeitpunkt der Stürze, die deine Apple Watch erkennt, um deine Blut-Kontakte sofort zu benachrichtigen. Keine anderen Gesundheitsdaten werden gelesen oder gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your consent, Meeshy reads only the time of falls your Apple Watch detects, to alert your Blood links right away. No other health data is read or sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tu consentimiento, Meeshy lee solo la hora de las caídas que detecta tu Apple Watch, para avisar enseguida a tus Sangre. No se lee ni se envía ningún otro dato de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec votre accord, Meeshy lit seulement l'heure des chutes que votre Apple Watch détecte, pour prévenir vos Sangs tout de suite. Aucune autre donnée de santé n'est lue ni envoyée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il tuo consenso, Meeshy legge solo l'ora delle cadute rilevate dal tuo Apple Watch, per avvisare subito i tuoi Sangue. Nessun altro dato sanitario viene letto o inviato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com seu consentimento, o Meeshy lê apenas o horário das quedas que seu Apple Watch detecta, para avisar seus Sangue na hora. Nenhum outro dado de saúde é lido ou enviado."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعثر Meeshy على الهاتف المجاور لهاتفك عندما تشارك ملفك الشخصي دون تلامس. لا يُرسَل شيء قبل أن تختار ما تعطيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy findet das Telefon neben Ihrem, wenn Sie Ihr Profil kontaktlos teilen. Nichts wird gesendet, bevor Sie gewählt haben, was Sie geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy finds the phone next to yours when you share your profile without contact. Nothing is sent until you choose what to give."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy encuentra el teléfono junto al tuyo cuando compartes tu perfil sin contacto. No se envía nada hasta que eliges qué das."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy trouve le téléphone à côté du vôtre quand vous partagez votre profil sans contact. Rien ne part tant que vous n'avez pas choisi ce que vous donnez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy trova il telefono accanto al tuo quando condividi il profilo senza contatto. Non parte nulla finché non scegli cosa dare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meeshy encontra o celular ao lado do seu quando você compartilha seu perfil sem contato. Nada é enviado até você escolher o que dar."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Meeshy موقعك لمشاركته مع جهات اتصالك والعثور على أصدقاء قريبين منك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy verwendet Ihren Standort, um ihn mit Kontakten zu teilen und Freunde in der Nähe zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy uses your location to share your current location with contacts and find nearby friends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy utiliza tu ubicación para compartirla con tus contactos y encontrar amigos cercanos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy utilise votre position pour partager votre localisation avec vos contacts et trouver des amis à proximité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy usa la tua posizione per condividerla con i tuoi contatti e trovare amici nelle vicinanze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meeshy usa sua localização para compartilhá-la com seus contatos e encontrar amigos próximos."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Meeshy إلى الوصول إلى الميكروفون للرسائل الصوتية ومكالمات الفيديو وتسجيل الصوت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy benötigt Zugriff auf Ihr Mikrofon für Sprachnachrichten, Videoanrufe und Audioaufnahmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy needs access to your microphone for voice messages, video calls, and audio recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy necesita acceso a tu micrófono para mensajes de voz, videollamadas y grabación de audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy a besoin d'accéder à votre microphone pour les messages vocaux, les appels vidéo et l'enregistrement audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy ha bisogno di accedere al microfono per i messaggi vocali, le videochiamate e la registrazione audio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meeshy precisa de acesso ao seu microfone para mensagens de voz, chamadas de vídeo e gravação de áudio."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Meeshy نشاط هاتفك (المشي، الدراجة، السيارة) ليُظهر للأشخاص الذين تشاركهم موقعك الدقيق كيف تتنقّل، ومعهم فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy nutzt die Aktivität deines Telefons (zu Fuß, Rad, Auto), um den Personen, mit denen du deinen genauen Standort teilst, zu zeigen, wie du unterwegs bist – und nur ihnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy uses your phone's activity (walking, cycling, driving) to show the people you share your exact location with how you are moving, and only them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy usa la actividad de tu teléfono (a pie, en bici, en coche) para mostrar cómo te desplazas a las personas con quienes compartes tu ubicación exacta, y solo a ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy utilise l’activité de votre téléphone (à pied, à vélo, en voiture) pour montrer comment vous vous déplacez aux personnes à qui vous partagez votre position exacte, et seulement à elles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy usa l’attività del telefono (a piedi, in bici, in auto) per mostrare come ti sposti alle persone con cui condividi la tua posizione esatta, e solo a loro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meeshy usa a atividade do seu celular (a pé, de bicicleta, de carro) para mostrar como você se desloca às pessoas com quem compartilha sua localização exata, e só a elas."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Meeshy إلى إذن لحفظ الصور ومقاطع الفيديو في مكتبتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy benötigt die Erlaubnis, Fotos und Videos in Ihrer Bibliothek zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy needs permission to save photos and videos to your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy necesita permiso para guardar fotos y videos en tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy a besoin de l'autorisation pour enregistrer des photos et vidéos dans votre bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy ha bisogno del permesso di salvare foto e video nella tua libreria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meeshy precisa de permissão para salvar fotos e vídeos na sua biblioteca."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Meeshy إلى الوصول إلى مكتبة صورك لمشاركة الصور ومقاطع الفيديو مع جهات اتصالك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy benötigt Zugriff auf Ihre Fotomediathek, um Fotos und Videos mit Ihren Kontakten zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeshy needs access to your photo library to share photos and videos with your contacts."
          }
        },
