        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kontakte sehen „war vor Kurzem auf Meeshy“, höchstens alle 3 Stunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts see “was on Meeshy recently”, at most every 3 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus contactos ven «estuvo en Meeshy hace poco», como máximo cada 3 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos contacts voient « était sur Meeshy récemment », au plus toutes les 3 heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi contatti vedono «è stato su Meeshy di recente», al massimo ogni 3 ore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus contatos veem “esteve no Meeshy recentemente”, no máximo a cada 3 horas."
          }
        }
      }
    },
    "settings.privacy.notify_contacts_on_return.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من يُبلَّغ بعودتي؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer erfährt von meiner Rückkehr?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who is told when I'm back?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A quién se avisa de mi regreso?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui est prévenu de mon retour ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi viene avvisato del mio ritorno?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem é avisado do meu retorno?"
          }
        }
      }
    },
    "settings.privacy.hide_from_contact_search.info": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé, vos contacts ne sont pas non plus prévenus de votre arrivée sur Meeshy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, your contacts aren't notified when you join Meeshy either."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, tus contactos tampoco reciben aviso de tu llegada a Meeshy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden deine Kontakte auch nicht benachrichtigt, wenn du zu Meeshy kommst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, i tuoi contatti non vengono nemmeno avvisati del tuo arrivo su Meeshy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado, seus contatos também não são avisados da sua chegada ao Meeshy."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، لا يتم أيضًا إخطار جهات اتصالك بانضمامك إلى Meeshy."
          }
        }
      }
    },
    "settings.privacy.hide_from_contact_search.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يظهر ملفك الشخصي في البحث برقم الهاتف أو البريد الإلكتروني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Profil erscheint nicht mehr bei einer Suche nach Nummer oder E-Mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile no longer shows up in a search by phone number or email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil ya no aparece en una búsqueda por número o correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil ne ressort plus d'une recherche par numéro ou e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo non compare più in una ricerca per numero o e-mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu perfil não aparece mais em buscas por número ou e-mail."
          }
        }
      }
    },
