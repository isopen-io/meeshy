    "onboarding.age.picker.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لأعلى أو لأسفل لاختيار اليوم والشهر والسنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach oben oder unten, um Tag, Monat und Jahr zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up or down to choose the day, month and year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba o hacia abajo para elegir el día, el mes y el año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse vers le haut ou le bas pour choisir le jour, le mois et l'année."
