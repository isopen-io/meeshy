    "Pour vérifier, comparez ce numéro avec celui affiché sur l'appareil de %@, ou scannez son code QR.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للتحقق، قارن هذا الرقم بالرقم الظاهر على جهاز %@، أو امسح رمز الاستجابة السريعة الخاص به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleichen Sie diese Nummer mit der auf dem Gerät von %@ angezeigten, oder scannen Sie den QR-Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To verify, compare this number with the one displayed on %@'s device, or scan their QR code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para verificar, compara este número con el que aparece en el dispositivo de %@, o escanea su código QR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per verificare, confronta questo numero con quello mostrato sul dispositivo di %@, oppure scansiona il suo codice QR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para verificar, compare este número com o exibido no dispositivo de %@, ou escaneie o código QR."
          }
        }
      }
    },
