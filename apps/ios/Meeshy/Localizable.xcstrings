    },
    "game2.guide.moment.season_start.means_plain": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثمانية أسابيع في أرض لغة. كل فصل محقّق وكل تحالف يُقدّمانك بضع خطوات، وكل محطة مجانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Wochen in einem Sprachland. Jeder erfüllte Akt und jedes Bündnis bringen dich ein paar Schritte voran, und jede Rast ist kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eight weeks in the land of a language. Each act you complete and each alliance carry you a few strides, and every stop is free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho semanas en tierra de idioma. Cada acto hecho realidad y cada alianza te hacen avanzar unos pasos, y cada parada es gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit semaines en terre de langue. Chaque acte réalisé et chaque alliance te font avancer de quelques pas, et chaque halte est gratuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Otto settimane in terra di lingua. Ogni atto compiuto e ogni alleanza ti fanno avanzare di qualche passo, e ogni sosta è gratuita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oito semanas em terra de idioma. Cada ato realizado e cada aliança fazem você avançar alguns passos, e cada parada é gratuita."
          }
        }
      }
    },
