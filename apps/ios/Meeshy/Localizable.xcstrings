    "game.concept.glory.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجدك يمنحك اسمك، وهذا الاسم لا يتراجع أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ruhm gibt dir deinen Namen, und dieser Name weicht nie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your glory gives you your name, and that name never goes back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu gloria te da tu nombre, y ese nombre nunca retrocede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta gloire te donne ton nom, et ce nom ne recule jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua gloria ti dà il tuo nome, e quel nome non arretra mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua glória dá o seu nome, e esse nome nunca recua."
          }
        }
      }
    },
    "game.concept.glory.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السكّ والمستويات الجديدة والمآثر تُنمّي مجدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prägungen, neue Level und Heldentaten lassen deinen Ruhm wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mints, new levels and great deeds make your glory grow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuñaciones, nuevos niveles y hazañas hacen crecer tu gloria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frappes, nouveaux niveaux et hauts faits font grandir ta gloire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coni, nuovi livelli e imprese fanno crescere la tua gloria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunhagens, novos níveis e façanhas fazem a sua glória crescer."
          }
        }
      }
    },
    "game.concept.glory.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سُكّ Meesh: كل سكّ يُنمّي مجدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Präge eine Meesh: Jede Prägung lässt deinen Ruhm wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mint a Meesh: every mint makes your glory grow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuña una Meesh: cada acuñación hace crecer tu gloria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frappe une Meesh : chaque frappe fait grandir ta gloire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conia una Meesh: ogni conio fa crescere la tua gloria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunhe uma Meesh: cada cunhagem faz a sua glória crescer."
          }
        }
      }
    },
    "game.concept.glory.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتقِ إلى حلقة مبارزة أعلى، وأتمّ رحلة: مجدك ينمو أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklimm einen Kreis des Turniers, vollende eine Reise: Auch dein Ruhm wächst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Climb a joust circle, complete a journey: your glory grows too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube un círculo de justa, termina un viaje: tu gloria también crece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravis un cercle de joute, achève un voyage : ta gloire grandit aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali un cerchio del torneo, completa un viaggio: anche la tua gloria cresce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba um círculo de torneio, complete uma viagem: sua glória também cresce."
          }
        }
      }
    },
    "game.concept.flame.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللهب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Flamme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Flame"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Llama"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Flamme"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Fiamma"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Chama"
          }
        }
      }
    },
    "game.concept.flame.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لهبك يروي أيامك المتتالية، ويغذّي أحلامك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Flamme erzählt deine Tage am Stück, und sie nährt deine Träume."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Flame tells your days in a row, and it feeds your dreams."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Llama dice tus días seguidos, y alimenta tus sueños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Flamme dit tes jours d’affilée, et elle nourrit tes rêves."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua Fiamma racconta i tuoi giorni di fila, e nutre i tuoi sogni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua Chama mostra os seus dias seguidos, e ela alimenta seus sonhos."
          }
        }
      }
    },
    "game.concept.flame.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينمو يومًا عن كل يوم تقوم فيه بإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wächst um einen Tag für jeden Tag, an dem du eine Aktion ausführst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It grows by one day for each day you make a move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece un día por cada día en que haces un gesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle grandit d’un jour à chaque jour où tu fais un geste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce di un giorno per ogni giorno in cui fai un gesto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela cresce um dia a cada dia em que você faz um gesto."
          }
        }
      }
    },
    "game.concept.flame.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإجراء واحد على الأقل كل يوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach jeden Tag mindestens eine Aktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do at least one action every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz al menos un gesto cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais au moins un geste chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai almeno un gesto ogni giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça pelo menos um gesto todos os dias."
          }
        }
      }
    },
    "game.concept.flame.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بقنديل لأيام الغياب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine Hüterin bereit für Tage ohne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a Vigil for the days off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una Vela para los días sin gestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde une Veilleuse pour les jours sans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni una Lucerna per i giorni senza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde uma Lamparina para os dias sem."
          }
        }
      }
    },
    "game.concept.missions.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحلم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Traum"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Dream"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Sueño"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Rêve"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Sogno"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sonho"
          }
        }
      }
    },
    "game.concept.missions.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ليلة، يرسل إليك أجدادك حلمًا لتحقّقه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Nacht schicken dir deine Ahnen einen Traum, den du erfüllen sollst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each night, your ancestors send you a dream to fulfill."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada noche, tus ancestros te envían un sueño que hacer realidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque nuit, tes aïeux t’envoient un rêve à réaliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni notte, i tuoi antenati ti mandano un sogno da compiere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda noite, seus ancestrais enviam um sonho para você realizar."
          }
        }
      }
    },
    "game.concept.missions.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاثة فصول لكل حلم. حين تتحقّق، تظهر العطيّة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Akte pro Traum. Sind sie erfüllt, erscheint die Gabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three acts per dream. Once they’re complete, the Offering appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres actos por sueño. Cuando los haces realidad, aparece la Ofrenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois actes par rêve. Quand ils sont réalisés, l’Offrande apparaît."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre atti per sogno. Quando sono compiuti, appare l’Offerta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três atos por sonho. Quando estão realizados, a Oferenda aparece."
          }
        }
      }
    },
    "game.concept.missions.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
