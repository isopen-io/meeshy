    "game.flame_panel.relight_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انطفأ لهبك: أعد إشعاله الآن، فيستأنف من حيث توقّف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Flamme ist erloschen: entzünde sie jetzt neu, sie macht dort weiter, wo sie aufgehört hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Flame went out: relight it now, it picks up where it stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Llama se apagó: vuelve a encenderla ahora, continúa donde se quedó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Flamme s’est éteinte : rallume-la maintenant, elle repart là où elle s’était arrêtée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua Fiamma si è spenta: riaccendila adesso, riparte da dove si era fermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua Chama se apagou: reacenda-a agora, ela recomeça de onde parou."
          }
        }
      }
    },
    "game.flame_panel.relight": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
