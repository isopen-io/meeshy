    "game.mint.offline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا اتصال: سيُستأنف السك عند عودة الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline: Das Prägen geht mit der Verbindung weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline: minting will resume when you are back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión: la acuñación se reanudará con la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors ligne : la frappe reprendra avec la connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline: il conio riprenderà con la connessione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão: a cunhagem volta com a conexão."
          }
        }
      }
    },
    "game.mint.next_title": {
      "extractionState": "manual",
      "localizations": {
