    "game.guide.moment.flame_at_risk.short": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطفئ لهبك عند منتصف الليل: يكفي إجراء واحد."
