    "game2.league.pseudonym.drawn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمك في المبارزة يُسحب بالقرعة: لا اسمك ولا معرّفك. ويتغيّر مع كل رحلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Turniername wird zugelost: weder dein Name noch dein Benutzername. Er wechselt mit jeder Reise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your joust name is drawn at random: not your name, not your username. It changes with every journey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre de justa se sortea: ni tu nombre ni tu usuario. Cambia con cada viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton nom de joute est tiré au sort : ni ton nom, ni ton identifiant. Il change à chaque voyage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome di torneo è estratto a sorte: né il tuo nome né il tuo nome utente. Cambia a ogni viaggio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome de torneio é sorteado: nem o seu nome, nem o seu usuário. Ele muda a cada viagem."
          }
        }
      }
    },
    "game2.league.pseudonym.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من 3 إلى 20 حرفًا. لا اسمك ولا معرّفك. اتركه فارغًا: يُسحب لك اسم مبارزة بالقرعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 bis 20 Zeichen. Weder dein Name noch dein Benutzername. Leer lassen: Dir wird ein Turniername zugelost."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 to 20 characters. Not your name or your username. Leave it empty: a joust name is drawn for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 3 a 20 caracteres. Ni tu nombre ni tu usuario. Déjalo vacío: te sorteamos un nombre de justa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 à 20 caractères. Ni ton nom, ni ton identifiant. Laisse vide : un nom de joute t’est tiré au sort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 3 a 20 caratteri. Né il tuo nome né il tuo nome utente. Lascia vuoto: un nome di torneo ti viene estratto a sorte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De 3 a 20 caracteres. Nem o seu nome, nem o seu usuário. Deixe vazio: um nome de torneio é sorteado para você."
          }
        }
      }
    },
