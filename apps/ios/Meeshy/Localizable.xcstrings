    "game.error.price_changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر جزء النور الذي سيُصاغ في هذه الأثناء: لم يُؤخذ شيء. راجعه، ثم سُكّ من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Teil deines Lichts, der gebannt werden soll, hat sich inzwischen geändert: Nichts wurde genommen. Sieh ihn dir an und präge dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The part of your light to bind changed in the meantime: nothing was taken. Check it, then mint again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte de luz que se fija cambió mientras tanto: no se tomó nada. Vuelve a leerla y acuña de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La part de lumière à figer a changé entre-temps : rien n’a été pris. Relis-la, puis frappe à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte di luce da fissare è cambiata nel frattempo: non è stato preso nulla. Rileggila, poi conia di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parte da luz a cristalizar mudou nesse meio-tempo: nada foi tirado. Leia de novo e cunhe outra vez."
          }
        }
      }
    },
