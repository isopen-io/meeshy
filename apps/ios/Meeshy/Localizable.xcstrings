    "game.guide.moment.new_rank.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نما مجدك: العالم يمنحك اسمًا جديدًا، لا يتراجع أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
