    "e2ee.deviceLimit.enrolled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم هذا الجهاز بالتشفير مجددًا. يمكنك إعادة إرسال رسالتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät verschlüsselt wieder. Du kannst deine Nachricht erneut senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device encrypts again. You can resend your message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo vuelve a cifrar. Puedes reenviar tu mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil chiffre de nouveau. Vous pouvez renvoyer votre message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo cripta di nuovo. Puoi inviare di nuovo il tuo messaggio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo voltou a criptografar. Você pode reenviar sua mensagem."
          }
        }
      }
    },
    "e2ee.deviceLimit.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغ حسابك الحد الأقصى من الأجهزة المشفّرة. أزل جهازًا للكتابة من هذا الجهاز. لن يقرأ الجهاز المُزال بعد ذلك الرسائل المشفّرة الجديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto hat die maximale Anzahl verschlüsselter Geräte erreicht. Entferne eines, um von diesem zu schreiben. Das entfernte Gerät liest keine neuen verschlüsselten Nachrichten mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has reached the maximum number of encrypted devices. Remove one to write from this one. The removed device will no longer read new encrypted messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta alcanzó el número máximo de dispositivos cifrados. Elimina uno para escribir desde este. El dispositivo eliminado dejará de leer los nuevos mensajes cifrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte a atteint le nombre maximal d’appareils chiffrés. Retirez-en un pour écrire depuis celui-ci. L’appareil retiré ne lira plus les nouveaux messages chiffrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account ha raggiunto il numero massimo di dispositivi crittografati. Rimuovine uno per scrivere da questo. Il dispositivo rimosso non leggerà più i nuovi messaggi crittografati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta atingiu o número máximo de dispositivos criptografados. Remova um para escrever deste. O dispositivo removido deixará de ler as novas mensagens criptografadas."
          }
        }
      }
    },
