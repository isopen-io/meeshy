            "value": "Remove your link with %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Deshacer el vínculo con %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler le lien avec %@ ?"
          }
        },
        "it": {
          "stringUnit": {
