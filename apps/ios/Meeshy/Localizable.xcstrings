    "game.concept.atlas.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأطلس يحفظ ختمًا لكل لغة تبادلت بها الرسائل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Atlas bewahrt einen Stempel für jede Sprache deiner Gespräche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Atlas keeps a stamp for every language you’ve chatted in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Atlas guarda un sello por cada idioma en el que has conversado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Atlas garde un tampon pour chaque langue dans laquelle tu as échangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Atlante conserva un timbro per ogni lingua in cui hai conversato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Atlas guarda um carimbo para cada idioma em que você conversou."
          }
        }
      }
    },
    "game.concept.atlas.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل رسالة واستقبل أخرى بلغة ما: فيوضع الختم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende und erhalte eine Nachricht in einer Sprache: Der Stempel sitzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a message and get one back in a language: the stamp lands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un mensaje y recibe otro en un idioma: el sello se estampa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un message et reçois-en un dans une langue : le tampon se pose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un messaggio e ricevine uno in una lingua: il timbro si posa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie uma mensagem e receba outra em um idioma: o carimbo aparece."
          }
        }
      }
    },
    "game.concept.atlas.tip.1": {
      "extractionState": "manual",
      "localizations": {
