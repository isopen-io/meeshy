    "game.rules.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثماني قواعد، واللعبة كلها بداخلها. ميو يشرحها، ومي تُريك الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Regeln, und das ganze Spiel passt hinein. Meo erklärt sie, Mee zeigt dir die Aktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eight rules, and the whole game fits inside. Meo explains them, Mee shows you the move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho reglas, y todo el juego cabe en ellas. Meo las explica, Mee te muestra el gesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit règles, et tout le jeu tient dedans. Meo les explique, Mee te montre le geste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Otto regole, e tutto il gioco ci sta dentro. Meo le spiega, Mee ti mostra il gesto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oito regras, e o jogo inteiro cabe nelas. O Meo as explica, a Mee mostra a ação."
          }
        }
      }
    },
    "game.rules.section_rules": {
      "extractionState": "manual",
