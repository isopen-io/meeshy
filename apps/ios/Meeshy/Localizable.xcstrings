    },
    "circles.level.acquaintance.opens": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez vous écrire ; cette personne voit tes stories « Connaissances »."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can message each other; this person sees your “Acquaintances” stories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podéis escribiros; esta persona ve tus stories para «Conocidos»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocês podem conversar; essa pessoa vê seus stories para “Conhecidos”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr könnt euch schreiben; diese Person sieht deine Stories für „Bekannte“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potete scrivervi; questa persona vede le tue storie per «Conoscenti»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنكما المراسلة؛ ويرى هذا الشخص قصصك الموجّهة إلى «المعارف»."
          }
        }
      }
    },
    "circles.level.community.opens": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que voient les membres de tes communautés."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What members of your communities see."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que ven los miembros de tus comunidades."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que os membros das suas comunidades veem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Mitglieder deiner Communities sehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che vedono i membri delle tue comunità."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يراه أعضاء مجتمعاتك."
          }
        }
      }
    },
    "circles.level.public.opens": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tout le monde voit de toi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What everyone sees of you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que todo el mundo ve de ti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que todo mundo vê de você."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was alle von dir sehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che tutti vedono di te."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يراه الجميع منك."
          }
        }
      }
    },
    "circles.settings.shareListening.question": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand cette personne voit-elle ce que j'écoute ?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When does this person see what I’m listening to?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo ve esta persona lo que escucho?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando essa pessoa vê o que eu escuto?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann sieht diese Person, was ich höre?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando questa persona vede cosa ascolto?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى يرى هذا الشخص ما أستمع إليه؟"
          }
        }
      }
    },
    "circles.settings.shareListening.note": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music joué sur cet iPhone, Meeshy ouvert. Messages vocaux jamais partagés."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music playing on this iPhone, Meeshy open. Voice messages are never shared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music sonando en este iPhone, Meeshy abierto. Los mensajes de voz nunca se comparten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music tocando neste iPhone, Meeshy aberto. Mensagens de voz nunca são compartilhadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music läuft auf diesem iPhone, Meeshy ist geöffnet. Sprachnachrichten werden nie geteilt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music in riproduzione su questo iPhone, Meeshy aperta. I messaggi vocali non vengono mai condivisi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music يعمل على هذا الـ iPhone وMeeshy مفتوح. لا تتم مشاركة الرسائل الصوتية أبدًا."
          }
        }
      }
    },
    "profile.language.intro": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy te montre tout dans ta langue principale, sinon dans la suivante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy shows you everything in your main language, otherwise in the next one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy te muestra todo en tu idioma principal y, si no, en el siguiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Meeshy mostra tudo no seu idioma principal; se não der, no seguinte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy zeigt dir alles in deiner Hauptsprache, sonst in der nächsten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy ti mostra tutto nella tua lingua principale, altrimenti nella successiva."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض لك Meeshy كل شيء بلغتك الرئيسية، وإن لم تتوفّر ففي اللغة التالية."
          }
        }
      }
    },
