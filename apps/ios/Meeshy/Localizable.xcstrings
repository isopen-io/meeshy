    "story.mine.drafts.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الإجراء نهائي. ستُحذف المسودة ووسائطها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion ist endgültig. Der Entwurf und seine Medien werden gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. The draft and its media will be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción es definitiva. El borrador y sus archivos se eliminarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est définitive. Le brouillon et ses médias seront supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione è definitiva. La bozza e i suoi contenuti saranno eliminati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação é definitiva. O rascunho e suas mídias serão excluídos."
          }
        }
      }
    },
    "story.mine.drafts.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف المسودة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwurf löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this draft?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar el borrador?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le brouillon ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare la bozza?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir o rascunho?"
          }
        }
      }
    },
    "story.mine.failed.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُنشر هذه القصة قط: هذه نسختها الأخيرة وستضيع نهائيًا. «استئناف» يحوّلها إلى مسودة بدلًا من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Story wurde nie veröffentlicht: Dies ist ihre letzte Kopie, sie geht endgültig verloren. „Fortsetzen“ wandelt sie stattdessen in einen Entwurf um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This story was never published: this is its last copy and it will be lost forever. “Resume” converts it into a draft instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta historia nunca se publicó: es su última copia y se perderá para siempre. «Retomar» permite convertirla en borrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette story n'a jamais été publiée : c'est sa dernière copie, elle sera définitivement perdue. « Reprendre » permet plutôt de la convertir en brouillon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa storia non è mai stata pubblicata: è la sua ultima copia e andrà persa per sempre. «Riprendi» la converte invece in una bozza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta story nunca foi publicada: é sua última cópia e será perdida para sempre. “Retomar” a converte em rascunho."
          }
        }
      }
    },
    "story.mine.failed.delete.title": {
