    "settings.beta.toggle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفعيل ميزات بيتا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta-Funktionen aktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable beta features"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar funciones beta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer les bêta"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le funzioni beta"
          }
        },
        "pt-BR": {
