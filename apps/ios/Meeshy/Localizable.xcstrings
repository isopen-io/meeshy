    "voice.profile.deleteAlert.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الإجراء لا رجعة فيه. ستُحذف جميع بياناتك الصوتية وفقًا للائحة حماية البيانات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion ist unwiderruflich. Alle Ihre Sprachdaten werden gemäß DSGVO gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action is irreversible. All your voice data will be deleted in accordance with the GDPR."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción es irreversible. Todos tus datos de voz se eliminarán de acuerdo con el RGPD."
