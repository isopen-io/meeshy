    "contacts.phonePrompt.benefit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجدك معارفك على Meeshy بفضل رقمك. ويمكنك أيضًا استخدامه لتسجيل الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kontakte finden dich auf Meeshy über deine Nummer. Du kannst sie auch zum Anmelden verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People you know find you on Meeshy through your number. You can also use it to sign in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus contactos te encuentran en Meeshy gracias a tu número. También podrás usarlo para iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes proches te retrouvent sur Meeshy grâce à ton numéro. Tu pourras aussi t’en servir pour te connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi contatti ti trovano su Meeshy grazie al tuo numero. Potrai usarlo anche per accedere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus contatos encontram você no Meeshy pelo seu número. Você também poderá usá-lo para entrar."
          }
        }
      }
    },
