    },
    "game.error.request_id_conflict": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبق استخدام هذا الطلب في إجراء آخر — حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage wurde bereits für eine andere Aktion verwendet – versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request was already used for another action — try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa solicitud ya se usó para otra acción: inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande a déjà servi pour une autre action : réessaie."
