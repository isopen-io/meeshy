    "conversation.send.e2ee.deviceLimitReached": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد كبير من الأجهزة المشفّرة: أزل جهازًا للكتابة من هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele verschlüsselte Geräte: Entferne eines, um von hier zu schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many encrypted devices: remove one to write from here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados dispositivos cifrados: retira uno para escribir desde aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop d’appareils chiffrés : retirez-en un pour écrire d’ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi dispositivi crittografati: rimuovine uno per scrivere da qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparelhos criptografados demais: remova um para escrever daqui."
          }
        }
      }
    },
    "conversation.send.e2ee.recipientWithoutEncryptedDevice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب على مراسلك تحديث Meeshy: الرسالة لم تُرسل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gegenüber muss Meeshy aktualisieren: Nachricht nicht gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contact needs to update Meeshy: message not sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contacto debe actualizar Meeshy: mensaje no enviado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre correspondant doit mettre Meeshy à jour : message non parti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo interlocutore deve aggiornare Meeshy: messaggio non inviato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu contato precisa atualizar o Meeshy: mensagem não enviada."
          }
        }
      }
    },
    "conversation.send.e2ee.sealedMessageUneditable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسلت هذه الرسالة مشفرة: لا يمكن تعديلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nachricht wurde verschlüsselt gesendet: Sie kann nicht bearbeitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message was sent encrypted: it can’t be edited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mensaje se envió cifrado: no se puede editar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce message a été envoyé chiffré : il ne peut pas être modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo messaggio è stato inviato crittografato: non può essere modificato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta mensagem foi enviada criptografada: ela não pode ser editada."
          }
        }
      }
    },
    "conversation.send.slow_mode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسالة واحدة كل 30 ث للحسابات الجديدة — أعد المحاولة بعد %lld ث"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Konten: eine Nachricht alle 30 s — versuch es in %lld s erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One message every 30 s for new accounts — try again in %lld s"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mensaje cada 30 s para las cuentas nuevas — vuelve a intentarlo en %lld s"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un message toutes les 30 s pour les nouveaux comptes — réessaie dans %lld s"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un messaggio ogni 30 s per i nuovi account — riprova tra %lld s"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mensagem a cada 30 s para contas novas — tente de novo em %lld s"
          }
        }
      }
    },
