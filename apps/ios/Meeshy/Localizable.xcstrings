    "onboarding.step.phone.existing.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان الحساب حسابك، فاستعِده عبر «هل نسيت كلمة المرور؟» في شاشة تسجيل الدخول. وإلّا، أدخل رقمًا آخر أو تخطَّ هذه الخطوة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es dein Konto ist, stelle es über „Passwort vergessen?“ auf dem Anmeldebildschirm wieder her. Gib andernfalls eine andere Nummer ein oder überspringe diesen Schritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it's yours, recover it with “Forgot password?” on the login screen. Otherwise, enter another number or skip this step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si es tu cuenta, recupérala con «¿Olvidaste tu contraseña?» en la pantalla de inicio de sesión. Si no, introduce otro número u omite este paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si c'est le tien, récupère-le depuis « Mot de passe oublié » sur l'écran de connexion. Sinon, saisis un autre numéro ou passe cette étape."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se è il tuo account, recuperalo con «Password dimenticata?» nella schermata di accesso. Altrimenti inserisci un altro numero o salta questo passaggio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a conta é sua, recupere-a com “Esqueceu a senha?” na tela de login. Caso contrário, digite outro número ou pule esta etapa."
          }
        }
      }
    },
    "onboarding.step.phone.existing.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرقم مرتبط بحساب بالفعل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nummer ist bereits mit einem Konto verknüpft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This number is already linked to an account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este número ya está vinculado a una cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce numéro est déjà lié à un compte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo numero è già collegato a un account"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este número já está vinculado a uma conta"
          }
        }
      }
    },
    "onboarding.step.phone.recovery.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرقم يخصّ حسابًا غير مُستخدَم يشبه اسمه اسمك. من شاشة تسجيل الدخول، اختر «هل نسيت كلمة المرور؟» لاستعادته بدلًا من إنشاء حساب جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nummer gehört zu einem inaktiven Konto, dessen Name deinem ähnelt. Wähle auf dem Anmeldebildschirm „Passwort vergessen?“, um es wiederherzustellen, anstatt ein neues zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This number belongs to an inactive account whose name looks like yours. From the login screen, choose “Forgot password?” to recover it rather than creating a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este número pertenece a una cuenta inactiva cuyo nombre se parece al tuyo. En la pantalla de inicio de sesión, elige «¿Olvidaste tu contraseña?» para recuperarla en lugar de crear una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce numéro appartient à un compte inactif dont le nom te ressemble. Depuis l'écran de connexion, choisis « Mot de passe oublié » pour le récupérer plutôt que d'en créer un nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo numero appartiene a un account inattivo il cui nome somiglia al tuo. Dalla schermata di accesso, scegli «Password dimenticata?» per recuperarlo invece di crearne uno nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este número pertence a uma conta inativa cujo nome se parece com o seu. Na tela de login, escolha “Esqueceu a senha?” para recuperá-la em vez de criar uma nova."
          }
        }
      }
    },
    "onboarding.step.phone.recovery.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنه حسابك القديم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nach deinem alten Konto aus"
          }
