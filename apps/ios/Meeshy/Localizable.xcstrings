    "game2.guide.moment.trophy.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنضمّ %@ إلى كؤوسك. الكأس لا تكسبك شيئًا: تُحفظ وتُعرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kommt zu deinen Trophäen. Eine Trophäe bringt nichts ein: Sie wird bewahrt und gezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joins your trophies. A trophy brings nothing: it is kept and shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se une a tus trofeos. Un trofeo no da nada: se guarda y se muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rejoint tes trophées. Un trophée ne rapporte rien : il se garde et se montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si aggiunge ai tuoi trofei. Un trofeo non porta nulla: si custodisce e si mostra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se junta aos seus troféus. Um troféu não rende nada: ele se guarda e se mostra."
          }
        }
      }
    },
