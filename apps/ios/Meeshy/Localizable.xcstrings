    "game2.league.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجموعة تمتلئ: يظهر الترتيب بمجرد وصول الشرارات الأولى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Turnier füllt sich: Die Plätze erscheinen, sobald die ersten Funken sprühen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group is filling up: the places appear as soon as the first sparks fall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo se está llenando: la clasificación aparece en cuanto caen las primeras chispas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groupe se remplit : le classement apparaît dès que les premières étincelles tombent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gruppo si sta riempiendo: la classifica compare appena arrivano le prime scintille."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O grupo está se enchendo: a classificação aparece assim que as primeiras faíscas chegam."
          }
        }
      }
    },
