          "stringUnit": {
            "state": "translated",
            "value": "The rarer a great deed, the more precious its border."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más rara es una hazaña, más valioso es su borde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus un haut fait est rare, plus son liseré est précieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più un’impresa è rara, più il suo bordo è prezioso."
