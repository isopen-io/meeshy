    "circles.demote.confirm.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينتقل %1$@ من %2$@ إلى %3$@. ستفقد ما يشاركه %2$@. لن يتم إشعار %1$@ ولن يتمكن من طلب الترقية مجددًا قبل 30 يومًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wechselt von %2$@ zu %3$@. Du verlierst, was %2$@ teilt. %1$@ wird nicht benachrichtigt und kann dich 30 Tage lang nicht bitten, wieder aufzusteigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will go from %2$@ to %3$@. You'll lose what %2$@ shares. %1$@ won't be notified and can't ask you to move back up for 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pasará de %2$@ a %3$@. Perderás lo que comparte %2$@. %1$@ no recibirá ningún aviso y no podrá pedirte volver a subir antes de 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ passera de %2$@ à %3$@. Vous perdrez ce que %2$@ partage. %1$@ n'en sera pas averti(e) et ne pourra pas vous redemander de remonter avant 30 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ passerà da %2$@ a %3$@. Perderai ciò che %2$@ condivide. %1$@ non verrà avvisato/a e non potrà chiederti di risalire prima di 30 giorni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ passará de %2$@ para %3$@. Você perderá o que %2$@ compartilha. %1$@ não será avisado(a) e não poderá pedir para subir de novo antes de 30 dias."
          }
        }
      }
    },
    "circles.unlink.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء الرابط مع %@؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung mit %@ aufheben?"
          }
        },
        "en": {
          "stringUnit": {
