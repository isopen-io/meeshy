          }
        }
      }
    },
    "e2ee.devices.entry.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعتمد أجهزتك الأخرى لقراءة رسائلك المشفّرة عليها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genehmige deine anderen Geräte, um dort deine verschlüsselten Nachrichten zu lesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve your other devices to read your encrypted messages on them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba tus otros dispositivos para leer en ellos tus mensajes cifrados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez vos autres appareils pour y lire vos messages chiffrés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva gli altri dispositivi per leggervi i tuoi messaggi crittografati"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove seus outros dispositivos para ler neles suas mensagens criptografadas"
          }
        }
      }
    },
    "e2ee.devices.entry.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجهزة التي تقرأ رسائلك المشفّرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräte, die deine verschlüsselten Nachrichten lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The devices that read your encrypted messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos que leen tus mensajes cifrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils qui lisent vos messages chiffrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi che leggono i tuoi messaggi crittografati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dispositivos que leem suas mensagens criptografadas."
          }
        }
      }
    },
    "e2ee.devices.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تصل رسائلك المشفّرة إلا إلى الأجهزة المعتمدة. لاعتماد جهاز، امسح رمزه هنا ثم افعل العكس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine verschlüsselten Nachrichten erreichen nur genehmigte Geräte. Um eines zu genehmigen, lies seinen Code hier und tu dann dasselbe umgekehrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your encrypted messages only reach approved devices. To approve one, scan its code here, then do the reverse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus mensajes cifrados solo llegan a los dispositivos aprobados. Para aprobar uno, lee su código aquí y luego haz lo inverso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos messages chiffrés n’arrivent qu’aux appareils approuvés. Pour en approuver un, lisez son code ici, puis faites l’inverse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi messaggi crittografati arrivano solo ai dispositivi approvati. Per approvarne uno, leggi qui il suo codice, poi fai il contrario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas mensagens criptografadas só chegam aos dispositivos aprovados. Para aprovar um, leia o código dele aqui e depois faça o inverso."
          }
        }
      }
    },
    "e2ee.devices.offline.banner": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير متصل — آخر المعلومات المعروفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
