    "activation.gate.moreLinks": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد 5 روابط نشطة يُطلب رمز. سيُنشأ رابطك فور تأكيده."
          }
        },
        "de": {
          "stringUnit": {
