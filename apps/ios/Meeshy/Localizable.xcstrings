    "game.detail.gem.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجوهرة تقول في أي حلقة تتبارز هذا الأسبوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Edelstein zeigt, in welchem Kreis du diese Woche im Turnier kämpfst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gem tells which circle you joust in this week."
