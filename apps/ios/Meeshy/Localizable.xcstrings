        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link öffnet ein ANDERES Konto als das geöffnete: %@. Öffne es nur, wenn es dir gehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link opens an account OTHER than the open one: %@. Only open it if it is yours."
          }
        },
        "es": {
          "stringUnit": {
