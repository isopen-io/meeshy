    "voice.profile.wizard.recording.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ بصوت عالٍ الجملتين أو الثلاث المعروضة، دون تكلّف. 3 عيّنات على الأقل مدة كل منها 10 ثوانٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies die zwei oder drei angezeigten Sätze laut vor, ganz natürlich. Mindestens 3 Proben à 10 Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the two or three sentences shown aloud, in your natural tone. At least 3 samples of 10 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee en voz alta las dos o tres frases mostradas, con tono natural. Mínimo 3 muestras de 10 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez à voix haute les deux ou trois phrases affichées, sans forcer le ton. Minimum 3 échantillons de 10 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi ad alta voce le due o tre frasi mostrate, con tono naturale. Minimo 3 campioni da 10 secondi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia em voz alta as duas ou três frases exibidas, em tom natural. Mínimo de 3 amostras de 10 segundos."
          }
        }
      }
    },
    "voice.profile.wizard.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل صوتك لتفعيل استنساخ الصوت المخصّص. ستحتفظ رسائلك الصوتية المترجمة بصوتك الطبيعي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm deine Stimme auf, um das persönliche Voice-Cloning zu aktivieren. Deine übersetzten Sprachnachrichten behalten deine natürliche Stimme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your voice to enable personal voice cloning. Your translated voice messages will keep your natural voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba tu voz para activar la clonación de voz personalizada. Tus mensajes de voz traducidos conservarán tu voz natural."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre voix pour activer le clonage vocal personnalisé. Vos messages audio traduits garderont votre voix naturelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la tua voce per attivare la clonazione vocale personalizzata. I tuoi messaggi vocali tradotti manterranno la tua voce naturale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave sua voz para ativar a clonagem de voz personalizada. Suas mensagens de voz traduzidas manterão sua voz natural."
          }
        }
      }
    },
