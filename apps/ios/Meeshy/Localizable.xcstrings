        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Toutes vos données vocales seront supprimées conformément au RGPD."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione è irreversibile. Tutti i tuoi dati vocali saranno eliminati in conformità al GDPR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação é irreversível. Todos os seus dados de voz serão excluídos de acordo com o RGPD."
          }
        }
      }
    },
