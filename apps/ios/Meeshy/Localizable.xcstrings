    "game.rules.concept.badges.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عشرون وسامًا، واحد لكل إجراء محدّد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwanzig Medaillen, eine pro bestimmter Aktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twenty medals, one per precise move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Veinte medallas, una por gesto preciso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vingt médailles, une par geste précis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Venti medaglie, una per gesto preciso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinte medalhas, uma por gesto preciso."
          }
        }
      }
    },
    "game.rules.concept.defis.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "درجات بأرقام في كل فئة من الإجراءات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stufen mit einer Zahl in jeder Aktionsfamilie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbered tiers in every family of actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalones con cifra en cada familia de gestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des paliers chiffrés dans chaque famille de gestes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradini numerati in ogni famiglia di gesti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Patamares com número em cada família de gestos."
          }
        }
      }
    },
    "game.rules.concept.succes.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقديرات نادرة، تتحقّق دفعة واحدة حين تجمع ما تطلبه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seltene Auszeichnungen, die auf einmal gelingen, wenn du erfüllst, was sie verlangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rare distinctions, done in one go when you gather what they ask for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distinciones raras, que se logran de una vez cuando reúnes lo que piden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des distinctions rares, accomplies d’un coup quand tu réunis ce qu’elles demandent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconoscimenti rari, compiuti in un colpo solo quando riunisci ciò che chiedono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Distinções raras, cumpridas de uma vez quando você reúne o que elas pedem."
          }
        }
      }
    },
    "game.rules.concept.showcase.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفّ كؤوسك: كؤوس المبارزة والرحلة والانبعاث واللهب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Regal deiner Trophäen: Pokale aus Turnier und Reise, Trophäen der Wiedergeburt und der Flamme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shelf of your trophies: joust and journey cups, rebirth and Flame trophies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estante de tus trofeos: copas de justa y de viaje, trofeos de renacimiento y de Llama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’étagère de tes trophées : coupes de joute et de voyage, trophées de renaissance et de Flamme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scaffale dei tuoi trofei: coppe del torneo e del viaggio, trofei di rinascita e della Fiamma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prateleira dos seus troféus: taças de torneio e de viagem, troféus de renascimento e de Chama."
          }
        }
      }
    },
    "game.rules.concept.atlas.body": {
      "extractionState": "manual",
      "localizations": {
