    "game.notebook.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيرتك تنتظر صفحتها الأولى: مع كل علامة من أجدادك، صورة مع مي وميو."
