      }
    },
    "game.detail.fact.factor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجراءاتك القادمة تُطلق شرارات مضاعفة بهذا العدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine nächsten Aktionen lassen so viel Mal mehr Funken sprühen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next moves make this many times more sparks fly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus próximos gestos hacen brotar este número de veces más chispas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes prochains gestes font jaillir ce nombre de fois plus d’étincelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi prossimi gesti fanno scaturire questo numero di volte più scintille."
          }
