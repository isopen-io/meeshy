    "game2.settings.visibility.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خارج الأصدقاء المقبولين لا أحد يرى إن كنت متصلًا ولا متى تلعب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außerhalb bestätigter Freunde sieht niemand, ob du online bist oder wann du spielst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside accepted friends, nobody sees whether you are online or when you play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de los amigos aceptados, nadie ve si estás en línea ni cuándo juegas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors amis acceptés, personne ne voit si tu es en ligne ni quand tu joues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuori dagli amici accettati nessuno vede se sei online né quando giochi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora dos amigos aceitos, ninguém vê se você está online nem quando joga."
          }
        }
      }
    },
