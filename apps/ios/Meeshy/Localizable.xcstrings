    "game2.guide.moment.trophy.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتّبها على طريقتك، واختر من يراها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne sie nach deinem Geschmack und bestimme, wer sie sieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange it your way, and choose who sees it."
          }
        },
        "es": {
