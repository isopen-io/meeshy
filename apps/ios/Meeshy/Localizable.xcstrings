    "message.unencrypted.notice": {
      "comment": "Marqueur d'un message arrivé en clair dans une conversation chiffrée de bout en bout (#11380) — fil, aperçu d'appui long, ligne de liste (VoiceOver).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسالة غير مشفرة — لم يتم التحقق من مرسلها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverschlüsselte Nachricht – der Absender ist nicht verifiziert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unencrypted message — its sender is not verified"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensaje sin cifrar: su autor no está verificado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Message non chiffré — son auteur n'est pas vérifié"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaggio non cifrato: il mittente non è verificato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagem não criptografada — o remetente não foi verificado"
          }
        }
      }
    },
    "conversation.encryption.detail.activationFooterFinal": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُوقَف التشفير أبدًا، لا التام بين الطرفين ولا على خوادمنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verschlüsselung lässt sich nie ausschalten, weder Ende-zu-Ende noch auf unseren Servern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encryption can never be turned off, end-to-end or on our servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cifrado nunca se desactiva, ni de extremo a extremo ni en nuestros servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffrement ne se désactive jamais, de bout en bout comme sur nos serveurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La crittografia non si disattiva mai, né end-to-end né sui nostri server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A criptografia nunca é desativada, nem de ponta a ponta nem em nossos servidores."
          }
        }
      }
    },
    "conversation.encryption.detail.servedGap": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رُئيت هنا مشفّرة تمامًا بين الطرفين: تبقى كذلك مهما عرض الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier Ende-zu-Ende-verschlüsselt gesehen: Sie bleibt es, was auch immer der Server anzeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seen end-to-end encrypted here: it stays so, whatever the server presents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista cifrada de extremo a extremo aquí: lo sigue siendo, diga lo que diga el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue chiffrée de bout en bout ici : elle le reste, quoi que présente le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista qui crittografata end-to-end: resta tale, qualunque cosa presenti il server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista com criptografia de ponta a ponta aqui: continua assim, seja o que for que o servidor apresente."
          }
        }
      }
    },
