    "game.photo.camera.denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الكاميرا. اسمح بها من إعدادات جهازك، أو اختر صورة من المعرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist verweigert. Erlaube sie in den Geräteeinstellungen oder wähle ein Foto aus deiner Galerie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is denied. Allow it in your device settings, or pick a photo from your gallery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara está denegada. Permítela en los ajustes de tu dispositivo, o elige una foto de tu galería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra est refusée. Autorise-la dans les réglages de ton appareil, ou choisis une photo dans ta galerie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera è negata. Consentila nelle impostazioni del dispositivo, oppure scegli una foto dalla galleria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera foi negada. Permita-a nos ajustes do aparelho, ou escolha uma foto da galeria."
          }
        }
      }
    },
    "game.photo.camera.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسمح هذا الجهاز بالكاميرا هنا. اختر صورة من المعرض، أو احتفظ بالبطاقة فقط."
