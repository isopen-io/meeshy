    "progression.elans.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انشر قصة أو منشورًا أو مقطعًا أو ابدأ محادثة: كل عائلة تحافظ عليها في الوقت نفسه تضاعف شراراتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Poste eine Story, einen Beitrag, ein Reel oder starte eine Unterhaltung: Jede Familie, die du gleichzeitig hältst, vervielfacht deine Funken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post a story, a post, a reel or start a conversation: every family you keep going at once multiplies your sparks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publica una historia, una publicación, un reel o inicia una conversación: cada familia que mantienes a la vez multiplica tus chispas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publie une story, un post, un réel ou lance une conversation : chaque famille tenue en même temps multiplie tes étincelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblica una storia, un post, un reel o avvia una conversazione: ogni famiglia portata avanti insieme moltiplica le tue scintille."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Publique um story, um post, um reel ou inicie uma conversa: cada família mantida ao mesmo tempo multiplica as suas faíscas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Publique um story, um post, um reels ou inicie uma conversa: cada família mantida ao mesmo tempo multiplica suas faíscas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布快拍、帖子、短视频，或发起一段对话：同时保持的每个类别都会让你的火花翻倍。"
          }
        }
      }
    },
    "progression.elans.hint": {
      "extractionState": "manual",
      "localizations": {
