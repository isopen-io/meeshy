    "game.concept.succes.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المأثرة تُخلّد لحظة نادرة من أسطورتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Heldentat hält einen seltenen Moment deiner Legende fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A great deed marks a rare moment in your legend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hazaña marca un momento raro de tu leyenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un haut fait marque un moment rare de ta légende."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’impresa segna un momento raro della tua leggenda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma façanha marca um momento raro da sua lenda."
          }
        }
      }
    },
    "game.concept.succes.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحقّق دفعة واحدة، حين تجمع ما تطلبه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie gelingt auf einmal, wenn du erfüllst, was sie verlangt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is done in one go, when you gather what it asks for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se logra de una vez, cuando reúnes lo que pide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’accomplit d’un coup, quand tu réunis ce qu’il demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si compie in un colpo solo, quando riunisci ciò che chiede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela se cumpre de uma vez, quando você reúne o que ela pede."
          }
        }
      }
    },
    "game.concept.succes.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استكشف التطبيق: بعض المآثر مخفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkunde die App: Manche Heldentaten sind versteckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore the app: some great deeds are hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora la aplicación: algunas hazañas están escondidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore l’application : certains hauts faits se cachent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
