        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Flame goes out at midnight: one action is enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Llama se apaga a medianoche: basta un gesto."
          }
        },
        "fr": {
