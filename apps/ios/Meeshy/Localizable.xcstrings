    },
    "conversation.encryption.fact.hybridIsServerToday": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوضع الهجين ليس تشفيرًا تامًا بين الطرفين: تقرأ خوادمنا الرسائل من أجل الترجمة والبحث."
