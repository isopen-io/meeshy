    "game.rules.concept.chest.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر حين تتحقّق فصول الحلم الثلاثة: هدية محجوبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erscheint, wenn die drei Akte des Traums erfüllt sind: ein verhülltes Geschenk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It appears when the dream’s three acts are complete: a veiled gift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece cuando los tres actos del sueño se han hecho realidad: un regalo envuelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle apparaît quand les trois actes du rêve sont réalisés : un présent voilé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appare quando i tre atti del sogno sono compiuti: un dono velato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela aparece quando os três atos do sonho estão realizados: um presente velado."
          }
        }
      }
    },
    "game.rules.concept.treasury.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملات Meesh التي تحتفظ بها لسلالتك. ستة أوعية، من الكيس إلى الاحتياطي، تظهر في ملفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Meeshes, die du für deine Linie bewahrst. Sechs Behältnisse, von der Börse bis zur Reserve, sichtbar auf deinem Profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Meeshes you keep for your line. Six containers, from the Purse to the Reserve, shown on your profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Meeshes que guardas para tu linaje. Seis recipientes, del Monedero a la Reserva, visibles en tu perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Meeshes que tu gardes pour ta lignée. Six contenants, de la Bourse à la Réserve, visibles sur ton profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Meesh che custodisci per la tua stirpe. Sei custodie, dalla Borsa alla Riserva, visibili sul tuo profilo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Meeshes que você guarda para a sua linhagem. Seis recipientes, da Bolsa à Reserva, visíveis no seu perfil."
          }
        }
      }
    },
    "game.rules.concept.steps.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل عشرة مستويات، من 10 إلى 100: سكّ Meesh، أو تحقيق أحلام، أو الحفاظ على لهب، أو بلوغ رتبة. ما لم تجتزه، ينتظر نورك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle zehn Level, von 10 bis 100: eine Meesh prägen, Träume erfüllen, eine Flamme halten oder einen Rang erreichen. Solange sie nicht bestanden ist, wartet dein Licht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every ten levels, from 10 to 100: mint a Meesh, fulfill dreams, hold a Flame or reach a rank. Until it is passed, your light waits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada diez niveles, de 10 a 100: acuñar una Meesh, hacer realidad sueños, mantener una Llama o alcanzar un rango. Mientras no se supere, tu luz espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les dix niveaux, de 10 à 100 : frapper une Meesh, réaliser des rêves, tenir une Flamme ou atteindre un rang. Tant qu’elle n’est pas réussie, ta lumière attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni dieci livelli, da 10 a 100: coniare una Meesh, compiere sogni, tenere una Fiamma o raggiungere un rango. Finché non è superata, la tua luce aspetta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada dez níveis, de 10 a 100: cunhar uma Meesh, realizar sonhos, manter uma Chama ou alcançar um título. Enquanto ela não for vencida, a sua luz espera."
          }
        }
      }
    },
    "game.rules.concept.tailwind.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنحك ⁦+25 %⁩ على شرارات أفعالك ما دام مستواك أدنى من ذروة نورك بسبعة مستويات أو أكثر، ويتوقف حين يعود الفرق إلى 6."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "+25 % auf die Funken deiner Aktionen, solange dein Level 7 oder mehr Level unter deinem hellsten Licht liegt. Er endet, sobald der Abstand wieder auf 6 sinkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+25 % on the sparks of your moves while your level is 7 or more levels below your highest light. It stops as soon as the gap falls back to 6."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "+25 % en las chispas de tus gestos mientras tu nivel esté 7 niveles o más por debajo de tu luz más alta. Se detiene en cuanto la diferencia vuelve a 6."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "+25 % sur les étincelles de tes gestes tant que ton niveau est 7 niveaux ou plus sous ta plus haute lumière. Il s’arrête dès que l’écart retombe à 6."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "+25 % sulle scintille dei tuoi gesti finché il tuo livello è 7 livelli o più sotto la tua luce più alta. Si ferma appena la distanza torna a 6."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "+25% nas faíscas dos seus gestos enquanto o seu nível estiver 7 níveis ou mais abaixo do auge da sua luz. Ele para assim que a diferença volta a 6."
          }
        }
      }
    },
    "game.rules.concept.duo.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرة في الأسبوع، تحالف مع صديق مقبول، يُفتح عند المستوى 20 لكليكما. إن حقّق كلٌّ منكما حصته تضاعفت المكافأة. وهو يُقدّم رحلتك بضع خطوات أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal pro Woche ein Bündnis mit einem bestätigten Freund, offen ab Level 20 für euch beide. Erfüllt jeder seinen Teil, verdoppelt sich die Belohnung. Es bringt deine Reise auch ein paar Schritte voran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a week, an alliance with an accepted friend, open from level 20 for both of you. If each of you does your part, the reward doubles. It also carries your journey a few strides further."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez por semana, una alianza con un amigo aceptado, abierta desde el nivel 20 para los dos. Si cada uno hace realidad su parte, la recompensa se duplica. También hace avanzar tu viaje unos pasos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par semaine, une alliance avec un ami accepté, ouverte au niveau 20 pour vous deux. Si chacun réalise sa part, la récompense double. Elle fait aussi avancer ton voyage de quelques pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta a settimana, un’alleanza con un amico accettato, aperta dal livello 20 per entrambi. Se ciascuno compie la sua parte, la ricompensa raddoppia. Fa anche avanzare il tuo viaggio di qualche passo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por semana, uma aliança com um amigo aceito, aberta a partir do nível 20 para vocês dois. Se cada um realizar a sua parte, a recompensa dobra. Ela também faz a sua viagem avançar alguns passos."
          }
        }
      }
    },
