    "visitor.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ حسابك أو سجّل الدخول للتفاعل والتعليق وقراءة كل شيء بلغتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle dein Konto oder melde dich an, um zu reagieren, zu kommentieren und alles in deiner Sprache zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create your account or sign in to react, comment and read everything in your language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tu cuenta o inicia sesión para reaccionar, comentar y leerlo todo en tu idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez votre compte ou connectez-vous pour réagir, commenter et tout lire dans votre langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea il tuo account o accedi per reagire, commentare e leggere tutto nella tua lingua."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie sua conta ou entre para reagir, comentar e ler tudo no seu idioma."
          }
        }
      }
    },
