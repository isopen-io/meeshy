          "stringUnit": {
            "state": "translated",
            "value": "Esta ação é irreversível. O link não estará mais acessível."
          }
        }
      }
    },
    "Cette action est irreversible. Toutes vos donnees vocales seront supprimees conformement au RGPD.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الإجراء لا رجعة فيه. ستُحذف جميع بياناتك الصوتية وفقًا للائحة حماية البيانات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion ist unwiderruflich. Alle Ihre Stimmdaten werden gemäß DSGVO gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action is irreversible. All your voice data will be deleted in compliance with GDPR."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción es irreversible. Todos tus datos vocales serán eliminados conforme al RGPD."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione è irreversibile. Tutti i tuoi dati vocali saranno eliminati in conformità al GDPR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação é irreversível. Todos os seus dados vocais serão excluídos conforme o RGPD."
          }
        }
      }
    },
