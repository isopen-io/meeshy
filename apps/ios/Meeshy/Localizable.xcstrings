    "about.description.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy منصة مراسلة فورية عالية الأداء مع ترجمة متعددة اللغات واستنساخ صوتي وتشفير من طرف إلى طرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy ist eine leistungsstarke Echtzeit-Messaging-Plattform mit mehrsprachiger Übersetzung, Voice-Cloning und Ende-zu-Ende-Verschlüsselung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy is a high-performance real-time messaging platform with multilingual translation, voice cloning and end-to-end encryption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy es una plataforma de mensajería en tiempo real de alto rendimiento con traducción multilingüe, clonación de voz y cifrado de extremo a extremo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy est une plateforme de messagerie en temps réel haute performance avec traduction multilingue, clonage vocal et chiffrement de bout en bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy è una piattaforma di messaggistica in tempo reale ad alte prestazioni con traduzione multilingue, clonazione vocale e crittografia end-to-end."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Meeshy é uma plataforma de mensagens em tempo real de alto desempenho com tradução multilíngue, clonagem de voz e criptografia de ponta a ponta."
          }
        }
      }
    },
