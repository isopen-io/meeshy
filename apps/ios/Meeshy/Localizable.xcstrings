    "forward.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضم إلى محادثة أو ابدأ واحدة لإعادة توجيه الرسائل إليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tritt einer Unterhaltung bei oder starte eine, um Nachrichten weiterzuleiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join or start a conversation to forward messages here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete o inicia una conversación para reenviar mensajes aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez ou démarrez une conversation pour y transférer des messages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisciti o avvia una conversazione per inoltrarvi i messaggi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre ou inicie uma conversa para encaminhar mensagens aqui."
