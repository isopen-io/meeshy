    },
    "game.detail.star.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل انبعاث يفتح عصرًا جديدًا، منقوشًا إلى الأبد على حلقة مستواك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Wiedergeburt öffnet ein neues Zeitalter, für immer in deinen Level-Ring graviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each rebirth opens a new Age, engraved forever on your level ring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada renacimiento abre una nueva Edad, grabada para siempre en tu anillo de nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque renaissance ouvre un nouvel Âge, gravé pour toujours sur ton anneau de niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni rinascita apre una nuova Era, incisa per sempre sul tuo anello di livello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada renascimento abre uma nova Era, gravada para sempre no seu anel de nível."
          }
        }
      }
    },
    "game.detail.star.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احمل نورك إلى المستوى 100، ثم انبعث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag dein Licht bis Level 100, dann werde wiedergeboren."
