    "guestAttach.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون حساب، يقبل %1$@ رسائلك ورسائلك الصوتية وأيضًا %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Konto nimmt %1$@ deine Nachrichten, deine Sprachnachrichten und außerdem %2$@ an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without an account, %1$@ accepts your messages, your voice notes, plus %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, %1$@ acepta tus mensajes, tus notas de voz y también %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans compte, %1$@ accepte vos messages, vos vocaux, des %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza account, %1$@ accetta i tuoi messaggi, i tuoi vocali e anche %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, %1$@ aceita suas mensagens, seus áudios e também %2$@."
          }
        }
      }
    },
