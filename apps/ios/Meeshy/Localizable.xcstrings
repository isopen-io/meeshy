        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحضور والتوكي والاستماع مع العنوان والموقع المباشر، بموافقتك."
          }
        }
      }
    },
    "circles.level.close.opens": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta présence complète, le talkie et la catégorie de ce que tu écoutes."
