        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be hidden for you. Other participants keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se ocultará para ti. Los demás participantes la conservan."
          }
        },
