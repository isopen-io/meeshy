    "settings.notifications.bring.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إيقافه، لن يتمكن أحد من جعل هاتفك يرن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet kann niemand mehr dein Telefon klingeln lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned off, no one can make your phone ring anymore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, nadie podrá hacer sonar tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupé, personne ne peut plus faire sonner votre téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato, nessuno potrà più far squillare il tuo telefono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, ninguém mais poderá fazer seu telefone tocar."
          }
        }
      }
    },
    "settings.notifications.bring.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا يحدث إذا أوقفته؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was passiert, wenn ich es ausschalte?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happens if I turn it off?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué pasa si lo desactivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que se passe-t-il si je le coupe ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa succede se lo disattivo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que acontece se eu desativar?"
          }
        }
      }
    },
    "settings.security.2fa.backup_codes.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للدخول من دون هاتفك؛ الرموز الجديدة تلغي السابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Anmelden ohne Telefon; neue Codes machen die alten ungültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To get in without your phone; new codes cancel the old ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para entrar sin tu teléfono; los códigos nuevos anulan los anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour entrer sans votre téléphone ; de nouveaux codes annulent les anciens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per entrare senza telefono; i nuovi codici annullano i precedenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para entrar sem o telefone; novos códigos anulam os anteriores."
          }
        }
      }
    },
    "settings.privacy.last_seen.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المقرّبون يرون متى كنت نشطًا، والأصدقاء إن كنت متصلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertraute sehen, wann du aktiv warst, Freunde nur, ob du online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close contacts see when you were last active, friends only if you're online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cercanos ven cuándo estuviste activo, tus amigos si estás en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos proches voient quand vous étiez actif, vos amis si vous êtes en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli intimi vedono quando eri attivo, gli amici se sei online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus próximos veem quando você esteve ativo, amigos só se estiver online."
          }
        }
      }
    },
