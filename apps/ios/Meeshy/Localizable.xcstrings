    "game.concept.season.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدوم الرحلة ثمانية أسابيع في أرض لغة، وفي نهايتها كأس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reise führt acht Wochen durch ein Sprachland, mit Pokal am Ende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eight weeks in the land of a language, with a cup at the end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El viaje dura ocho semanas en tierra de idioma, con una copa al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voyage dure huit semaines en terre de langue, avec une coupe au bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il viaggio dura otto settimane in terra di lingua, e finisce in coppa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A viagem dura oito semanas em terra de idioma, com uma taça no fim."
          }
        }
      }
    },
    "game.concept.season.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل فصل محقّق يُقدّمك بضع خطوات، من محطة إلى محطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder erfüllte Akt bringt dich ein paar Schritte weiter, Rast um Rast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each act you complete carries you a few strides, from stop to stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada acto de tu sueño te hace avanzar unos pasos, de parada en parada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque acte réalisé te fait avancer de quelques pas, de halte en halte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni atto compiuto ti fa avanzare di qualche passo, di sosta in sosta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ato realizado faz você avançar alguns passos, de parada em parada."
          }
        }
      }
    },
    "game.concept.season.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقّق فصول حلمك لتتقدّم بضع خطوات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfülle die Akte deines Traums, um ein paar Schritte voranzukommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the acts of your dream to move a few strides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz realidad los actos de tu sueño para avanzar unos pasos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réalise les actes de ton rêve pour avancer de quelques pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compi gli atti del tuo sogno per avanzare di qualche passo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Realize os atos do seu sonho para avançar alguns passos."
          }
        }
      }
    },
    "game.concept.season.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحالف مع صديق: المكافأة تتضاعف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließ ein Bündnis mit einem Freund: Die Belohnung verdoppelt sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Form an alliance with a friend: the reward doubles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sella una alianza con un amigo: la recompensa se duplica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais alliance avec un ami : la récompense double."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stringi un’alleanza con un amico: la ricompensa raddoppia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça aliança com um amigo: a recompensa dobra."
          }
        }
      }
    },
    "game.concept.prestige.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانبعاث"
          }
        },
        "de": {
