          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light is enough: you can mint a Meesh on the Legacy page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu luz alcanza: puedes acuñar una Meesh en la ficha del Legado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta lumière suffit : tu peux frapper une Meesh dans la fiche de l’Héritage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua luce basta: puoi coniare una Meesh nella scheda dell’Eredità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua luz basta: você pode cunhar uma Meesh na ficha da Herança."
