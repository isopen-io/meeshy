            "value": "cada centésima moeda leva a luz deles"
          }
        }
      }
    },
    "game.frappe.ancestors.prism": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل قطعة ألفية تجمع كل اللغات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "jede tausendste Münze vereint alle Sprachen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "every thousandth coin unites every language"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cada milésima moneda reúne todos los idiomas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "chaque millième pièce réunit toutes les langues"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ogni millesima moneta riunisce tutte le lingue"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "cada milésima moeda reúne todos os idiomas"
          }
        }
      }
    },
    "game.frappe.say.silver": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Meesh رقم %@ تنضمّ إلى إرثك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nr. %@ kommt in dein Erbe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No. %@ joins your Legacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La n.º %@ se une a tu Legado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La n° %@ rejoint ton Héritage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La n. %@ entra nella tua Eredità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nº %@ entra na sua Herança."
          }
        }
      }
    },
    "game.frappe.say.gold": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Meesh رقم %@ ذهبية. رآها أجدادك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nr. %@ ist aus Gold. Deine Ahnen haben sie gesehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No. %@ is gold. Your ancestors saw it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La n.º %@ es de oro. Tus ancestros la vieron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La n° %@ est d’or. Tes aïeux l’ont vue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La n. %@ è d’oro. I tuoi antenati l’hanno vista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nº %@ é de ouro. Seus ancestrais a viram."
          }
        }
      }
    },
    "game.frappe.say.prism": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Meesh رقم %@ موشورية: كل اللغات تسطع فيها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nr. %@ ist aus Prisma: Alle Sprachen leuchten darin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No. %@ is prism: every language shines in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La n.º %@ es de prisma: todos los idiomas brillan en ella."
          }
        },
        "fr": {
          "stringUnit": {
