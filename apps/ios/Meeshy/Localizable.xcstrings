    "game.detail.fact.league_closes": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُغلق مبارزة الأسبوع مساء الأحد. عندها تُثبَّت المراكز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Turnier der Woche endet am Sonntagabend. Dann stehen die Plätze fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The week’s joust closes on Sunday evening. The places are then set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La justa de la semana se cierra el domingo por la noche. Los puestos quedan entonces fijados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La joute de la semaine se ferme dimanche soir. Les places sont alors figées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il torneo della settimana si chiude domenica sera. I posti allora si fissano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O torneio da semana se fecha no domingo à noite. Os lugares então se fixam."
          }
        }
      }
    },
    "game.detail.fact.league_friends": {
      "extractionState": "manual",
      "localizations": {
