    "2fa_backup_codes_instruction": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ برموز الاسترداد هذه في مكان آمن. يمكن استخدام كل رمز مرة واحدة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
