    "sessions.revokeAll.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبقى هذا الجهاز وحده متصلًا، وستحتاج الأجهزة الأخرى إلى تسجيل الدخول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur dieses Gerät bleibt angemeldet. Die anderen müssen sich erneut anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this device will stay signed in. The others will have to sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo este dispositivo seguirá con la sesión iniciada. Los demás tendrán que volver a iniciarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul cet appareil restera connecté. Les autres devront se reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo questo dispositivo resterà connesso. Gli altri dovranno accedere di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só este aparelho continuará conectado. Os outros precisarão entrar novamente."
          }
        }
      }
    },
