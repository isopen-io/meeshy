    "game.concept.league.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل أسبوع، تقيسك المبارزة بـ ⁦29⁩ بطلًا آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Woche misst dich das Turnier mit 29 anderen Helden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each week, the joust measures you against 29 other heroes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada semana, la justa te mide con otros 29 héroes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque semaine, la joute te mesure à 29 autres héros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni settimana, il torneo ti misura con altri 29 eroi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda semana, o torneio mede você com outros 29 heróis."
          }
        }
      }
    },
    "game.concept.league.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شرارات أسبوعك تحدّد مركزك؛ والأوائل يرتقون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Funken der Woche bestimmen deinen Platz; die Ersten steigen auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sparks of the week set your place; the first ones climb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chispas de la semana marcan tu puesto; los primeros suben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes étincelles de la semaine font ta place ; les premiers montent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scintille della settimana fanno il tuo posto; i primi salgono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas faíscas da semana fazem o seu lugar; os primeiros sobem."
          }
        }
      }
    },
    "game.concept.league.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العب قليلًا كل يوم: شرارات الأسبوع تتراكم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel jeden Tag ein wenig: Die Funken der Woche summieren sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a little every day: the week’s sparks add up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega un poco cada día: las chispas de la semana se suman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue un peu chaque jour : les étincelles de la semaine s’additionnent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca un po’ ogni giorno: le scintille della settimana si sommano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue um pouco todo dia: as faíscas da semana se somam."
          }
        }
      }
    },
    "game.concept.league.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استهدف المراكز الأولى قبل مساء الأحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziele vor Sonntagabend auf die ersten Plätze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim for the top spots before Sunday evening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta a los primeros puestos antes del domingo por la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vise les premières places avant dimanche soir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta ai primi posti prima di domenica sera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire nas primeiras posições antes de domingo à noite."
          }
        }
      }
    },
