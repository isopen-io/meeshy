    "settings.voice.orientation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بصوتك في رسائلك المترجمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte deine Stimme in deinen übersetzten Nachrichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your own voice in your translated messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva tu voz en tus mensajes traducidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre voix dans vos messages traduits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la tua voce nei messaggi tradotti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha sua voz nas suas mensagens traduzidas."
          }
        }
      }
    },
    "settings.transcription.orientation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر نسخة الرسالة الصوتية بلغتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription einer Sprachnachricht erscheint in deiner Sprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A voice message's transcript appears in your language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción de un audio se muestra en tu idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription d'un vocal s'affiche dans votre langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione di un vocale appare nella tua lingua."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição de um áudio aparece no seu idioma."
          }
        }
      }
    },
    "settings.interface.lentille_list.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل محادثة في القائمة تُقرأ بلغتك، بنظرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Unterhaltung der Liste liest sich auf einen Blick in deiner Sprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every conversation in the list reads in your language, at a glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada conversación de la lista se lee en tu idioma, de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque conversation de la liste se lit dans votre langue, d'un coup d'œil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni conversazione dell'elenco si legge nella tua lingua, a colpo d'occhio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada conversa da lista se lê no seu idioma, num relance."
          }
        }
      }
    },
    "settings.interface.riviere_mode.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المجموعات النشطة تُقرأ المحادثة في مسارات، مسار لكل صوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In aktiven Gruppen liest sich die Unterhaltung in Spuren, eine pro Stimme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In active groups, the conversation reads in lanes, one per voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los grupos activos, la conversación se lee en carriles, uno por voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les groupes actifs, la conversation se lit en couloirs, un par voix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei gruppi attivi la conversazione si legge in corsie, una per voce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em grupos ativos, a conversa se lê em faixas, uma por voz."
          }
        }
      }
    },
    "settings.privacy.encryption.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُختار التشفير من طرف إلى طرف لكل محادثة ولا يمكن التراجع عنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ende-zu-Ende-Verschlüsselung wählst du pro Unterhaltung, unwiderruflich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encryption is chosen per conversation and can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cifrado de extremo a extremo se elige por conversación y no se deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffrement de bout en bout se choisit par conversation et ne se défait pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cifratura end-to-end si sceglie per conversazione e non si annulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A criptografia de ponta a ponta é escolhida por conversa e não se desfaz."
          }
        }
      }
    },
    "settings.privacy.encryption.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا يتغير عندما تكون المحادثة مشفّرة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ändert sich, wenn eine Unterhaltung verschlüsselt ist?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What changes when a conversation is encrypted?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué cambia cuando una conversación está cifrada?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui change quand une conversation est chiffrée ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa cambia quando una conversazione è cifrata?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que muda quando uma conversa é criptografada?"
          }
        }
      }
    },
    "settings.privacy.encryption.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرى الخادم النص الصريح أبدًا: تتم الترجمة على جهازك، وتغيب الميزات التي تتطلب قراءة الرسالة. تُرفض الرسالة غير المشفّرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server sieht den Klartext nie: Die Übersetzung erfolgt auf deinem Gerät, und Funktionen, die die Nachricht lesen müssten, fehlen. Eine Nachricht im Klartext wird abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server never sees the plain text: translation happens on your device, and features that need to read the message are absent. A plain message is refused there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor nunca ve el texto en claro: la traducción se hace en tu dispositivo y faltan las funciones que exigen leer el mensaje. Un mensaje en claro se rechaza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne voit jamais le clair : la traduction se fait sur votre appareil, et les fonctions qui exigent de lire le message sont absentes. Un message en clair y est refusé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non vede mai il testo in chiaro: la traduzione avviene sul tuo dispositivo e le funzioni che richiedono di leggere il messaggio non ci sono. Un messaggio in chiaro viene rifiutato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor nunca vê o texto em claro: a tradução é feita no seu aparelho e os recursos que exigem ler a mensagem não existem. Uma mensagem em claro é recusada."
          }
        }
      }
    },
