    "game.flame_panel.bonus": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل يوم من اللهب يغذّي أحلامك: ⁦+%@ %%⁩ من الشرارات لكل فصل، حتى ⁦+%@ %%⁩."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Tag deiner Flamme nährt deine Träume: +%@ %% Funken pro Akt, bis zu +%@ %%."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each day of Flame feeds your dreams: +%@ %% sparks per act, up to +%@ %%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día de Llama alimenta tus sueños: +%@ %% de chispas por acto, hasta +%@ %%."
          }
        },
        "fr": {
          "stringUnit": {
