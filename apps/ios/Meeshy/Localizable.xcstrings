    "circles.settings.shareListening.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى هذا الشخص أنك تستمع إلى الموسيقى؛ والعنوان فقط إذا منحته إياه في طقس الدم."
          }
        },
        "de": {
          "stringUnit": {
