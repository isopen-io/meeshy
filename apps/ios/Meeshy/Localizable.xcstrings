    "game2.duo.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعقد تحالفًا مع صديق مقبول: إن حقّق كلٌّ منكما حصته خلال الأسبوع، تتضاعف المكافأة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe ein Bündnis mit einem bestätigten Freund: Wenn jeder in der Woche seinen Teil erfüllt, verdoppelt sich die Belohnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Form an alliance with an accepted friend: if each of you does your part within the week, the reward doubles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una alianza con un amigo aceptado: si cada uno hace realidad su parte en la semana, la recompensa se duplica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais alliance avec un ami accepté : si chacun réalise sa part dans la semaine, la récompense double."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stringi un’alleanza con un amico accettato: se ciascuno compie la sua parte entro la settimana, la ricompensa raddoppia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça aliança com um amigo aceito: se cada um realizar a sua parte na semana, a recompensa dobra."
          }
        }
      }
    },
    "game2.duo.locked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح التحالف عند المستوى ⁦%1$@⁩ لكليكما. أنت في المستوى ⁦%2$@⁩."
