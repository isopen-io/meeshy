    "game.constellation.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في سماء أجدادك، عشر شظايا نجم تُضيء نجمة. وكل نجمة تهديك زينة للملف الشخصي، دون أي أفضلية في اللعب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Himmel deiner Ahnen lassen zehn Sternfragmente einen Stern aufleuchten. Jeder schenkt dir einen Profilschmuck, ohne Spielvorteil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your ancestors’ sky, ten star fragments light a star. Each one offers you a profile adornment, with no game advantage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el cielo de tus ancestros, diez fragmentos de estrella encienden una estrella. Cada una te ofrece un adorno de perfil, sin ventaja de juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le ciel de tes aïeux, dix fragments d’étoile allument une étoile. Chacune t’offre une parure de profil, sans avantage de jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel cielo dei tuoi antenati, dieci frammenti di stella accendono una stella. Ognuna ti offre un ornamento del profilo, senza vantaggi di gioco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No céu dos seus ancestrais, dez fragmentos de estrela acendem uma estrela. Cada uma oferece a você um adorno de perfil, sem vantagem de jogo."
          }
        }
      }
    },
