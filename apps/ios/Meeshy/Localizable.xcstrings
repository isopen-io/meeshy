            "state": "translated",
            "value": "Die Wiedergeburt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebirth"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Renacimiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Renaissance"
          }
        },
        "it": {
