    "game.detail.rank.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شعارك يُظهر رتبتك، الاسم الذي يمنحك إياه العالم. وهي لا تتراجع أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wappen zeigt deinen Rang, den Namen, den dir die Welt gibt. Er weicht nie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your crest shows your rank, the name the world gives you. It never goes back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu blasón muestra tu rango, el nombre que el mundo te da. Nunca retrocede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton blason montre ton rang, le nom que le monde te donne. Il ne recule jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo blasone mostra il tuo rango, il nome che il mondo ti dà. Non arretra mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu brasão mostra o seu título, o nome que o mundo dá a você. Ele nunca recua."
          }
        }
      }
    },
    "game.detail.rank.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نمِّ مجدك: سُكّ عملات Meesh، واحمل نورك أعلى من أي وقت مضى، وحقّق المآثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass deinen Ruhm wachsen: Präge Meeshes, trag dein Licht höher als je zuvor, vollbringe Heldentaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make your glory grow: mint Meeshes, carry your light higher than ever, perform great deeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz crecer tu gloria: acuña Meeshes, lleva tu luz más alto que nunca, logra hazañas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais grandir ta gloire : frappe des Meeshes, porte ta lumière plus haut que jamais, accomplis des hauts faits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai crescere la tua gloria: conia Meesh, porta la tua luce più in alto che mai, compi imprese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça a sua glória crescer: cunhe Meeshes, leve sua luz mais alto do que nunca, cumpra façanhas."
          }
        }
      }
    },
    "game.detail.flame.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكل لهبك يكبر مع أيامك المتتالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Form deiner Flamme wächst mit deinen Tagen am Stück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The form of your Flame grows with your days in a row."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma de tu Llama crece con tus días seguidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La forme de ta Flamme grandit avec tes jours d’affilée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma della tua Fiamma cresce con i tuoi giorni di fila."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A forma da sua Chama cresce com os seus dias seguidos."
          }
        }
      }
    },
    "game.detail.flame.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلما كبر، غذّى أحلامك أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je größer sie ist, desto mehr nährt sie deine Träume."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bigger it is, the more it feeds your dreams."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más grande es, más alimenta tus sueños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus elle est grande, plus elle nourrit tes rêves."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più è grande, più nutre i tuoi sogni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto maior ela fica, mais ela alimenta seus sonhos."
          }
        }
      }
    },
    "game.detail.freeze.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القنديل يُبقي لهبك مشتعلًا في يوم لم تفعل فيه شيئًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Hüterin hält deine Flamme an einem Tag am Brennen, an dem du nichts gemacht hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vigil keeps your Flame lit on a day when you did nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Vela mantiene tu Llama encendida un día en que no hiciste nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une Veilleuse garde ta Flamme allumée un jour où tu n’as rien fait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Lucerna tiene accesa la tua Fiamma in un giorno in cui non hai fatto nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma Lamparina mantém sua Chama acesa num dia em que você não fez nada."
          }
        }
      }
    },
    "game.detail.freeze.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خذه بعملات Meesh، أو اعثر عليه في العطيّة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rufe sie mit deinen Meeshes, oder finde sie in der Gabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take it with your Meeshes, or find it in the Offering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tómala con tus Meeshes, o encuéntrala en la Ofrenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends-la avec tes Meeshes, ou trouve-la dans l’Offrande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendila con le tue Meesh, o trovala nell’Offerta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue-a com as suas Meeshes, ou encontre-a na Oferenda."
          }
        }
      }
    },
    "game.detail.mission.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفصل هدف صغير تحقّقه اليوم، في حلم هذه الليلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Akt ist ein kleines Ziel, das du heute erfüllst, im Traum dieser Nacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An act is a small goal to reach today, in tonight’s dream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acto es una pequeña meta que hacer realidad hoy, en el sueño de esta noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acte est un petit but à réaliser aujourd’hui, dans le rêve de cette nuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atto è un piccolo obiettivo da compiere oggi, nel sogno di stanotte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ato é uma pequena meta para realizar hoje, no sonho desta noite."
          }
        }
      }
    },
    "game.detail.mission.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلق شرارات ويقرّبك من العطيّة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er lässt Funken sprühen und bringt dich der Gabe näher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It makes sparks fly and brings you closer to the Offering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace brotar chispas y te acerca a la Ofrenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fait jaillir des étincelles et te rapproche de l’Offrande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa scaturire scintille e ti avvicina all’Offerta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele faz saltar faíscas e deixa você mais perto da Oferenda."
          }
        }
      }
    },
    "game.detail.chest.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر العطيّة حين تتحقّق فصول الحلم الثلاثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gabe erscheint, wenn die drei Akte des Traums erfüllt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Offering appears when the dream’s three acts are complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Ofrenda aparece cuando los tres actos del sueño se han hecho realidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Offrande apparaît quand les trois actes du rêve sont réalisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Offerta appare quando i tre atti del sogno sono compiuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Oferenda aparece quando os três atos do sonho estão realizados."
          }
        }
      }
    },
    "game.detail.chest.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هدية محجوبة: شرارات، ومجد، وأحيانًا علاوة، أو شظية نجم، أو قنديل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein verhülltes Geschenk: Funken, Ruhm, manchmal ein Bonus, ein Sternfragment oder eine Hüterin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A veiled gift: sparks, glory, sometimes a bonus, a star fragment or a Vigil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un regalo envuelto: chispas, gloria y, a veces, una prima, un fragmento de estrella o una Vela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un présent voilé : des étincelles, de la gloire, parfois une prime, un fragment d’étoile ou une Veilleuse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dono velato: scintille, gloria, a volte un premio, un frammento di stella o una Lucerna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um presente velado: faíscas, glória, às vezes um prêmio, um fragmento de estrela ou uma Lamparina."
          }
        }
      }
    },
    "game.detail.coin.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Meesh هي نورك مصوغًا في قطعة مرقّمة. كل قطعة تحمل رقمها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Meesh ist dein Licht, gebannt in eine nummerierte Münze. Jede Münze trägt ihre Nummer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Meesh is your light bound into a numbered coin. Each coin carries its number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Meesh es tu luz fijada en una moneda numerada. Cada moneda lleva su número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Meesh, c’est ta lumière figée dans une pièce numérotée. Chaque pièce porte son numéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Meesh è la tua luce fissata in una moneta numerata. Ogni moneta porta il suo numero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Meesh é a sua luz cristalizada numa moeda numerada. Cada moeda traz o seu número."
          }
        }
      }
    },
    "game.detail.coin.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سُكّها بنورك حين يكفي: يُصاغ فيها جزء منه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Präge sie mit deinem Licht, sobald es reicht: Ein Teil davon wird darin gebannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mint it with your light as soon as there’s enough: a part of it is bound inside."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acúñala con tu luz en cuanto alcance: una parte se fija en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frappe-la avec ta lumière dès qu’elle suffit : une part s’y fige."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coniala con la tua luce appena basta: una parte vi si fissa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunhe-a com a sua luz assim que ela bastar: uma parte se cristaliza nela."
          }
        }
      }
    },
    "game.detail.ring.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحلقة تُظهر مستواك: نورك يملؤها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ring zeigt dein Level: Dein Licht füllt ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ring shows your level: your light fills it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anillo muestra tu nivel: tu luz lo llena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anneau montre ton niveau : ta lumière le remplit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anello mostra il tuo livello: la tua luce lo riempie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O anel mostra o seu nível: sua luz o enche."
          }
        }
      }
    },
    "game.detail.ring.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أطلق شرارات: حين تمتلئ الحلقة، يبلغ نورك مستوى جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Funken sprühen: Ist der Ring voll, gewinnt dein Licht ein Level."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sparks fly: when the ring is full, your light gains a level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz brotar chispas: cuando el anillo está lleno, tu luz gana un nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais jaillir des étincelles : quand l’anneau est plein, ta lumière gagne un niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai scaturire scintille: quando l’anello è pieno, la tua luce guadagna un livello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça saltar faíscas: quando o anel fica cheio, sua luz ganha um nível."
          }
        }
      }
    },
    "game.detail.treasury.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرثك يكبر بعملات Meesh التي تحتفظ بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Erbe wächst mit den Meeshes, die du behältst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your legacy grows with the Meeshes you keep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu legado crece con las Meeshes que guardas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton héritage grandit avec les Meeshes que tu gardes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua eredità cresce con le Meesh che custodisci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua herança cresce com as Meeshes que você guarda."
          }
        }
      }
    },
    "game.detail.treasury.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بعملات Meesh بدل إنفاقها: ينتقل إرثك إلى الوعاء التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte deine Meeshes, statt sie auszugeben: Dein Erbe wandert ins nächste Behältnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Meeshes instead of spending them: your legacy moves to the next container."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus Meeshes en vez de gastarlas: tu legado pasa al recipiente siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde tes Meeshes au lieu de les dépenser : ton héritage passe au contenant suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Custodisci le tue Meesh invece di spenderle: la tua eredità passa alla custodia successiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde suas Meeshes em vez de gastá-las: sua herança passa ao recipiente seguinte."
          }
        }
      }
    },
    "game.detail.elan.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفئة تجمع إجراءات متشابهة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Familie fasst ähnliche Aktionen zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A family groups actions that are alike."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una familia reúne gestos que se parecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une famille regroupe des gestes qui se ressemblent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una famiglia riunisce gesti che si somigliano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma família reúne gestos parecidos."
          }
        }
      }
    },
    "game.detail.elan.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل إجراء يُطلق شرارات. عدة فئات نشطة تُشعل زخمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Aktion lässt Funken sprühen. Mehrere aktive Familien lösen einen Schwung aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each move makes sparks fly. Several active families set off momentum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada gesto hace brotar chispas. Varias familias activas desatan un impulso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque geste fait jaillir des étincelles. Plusieurs familles actives déclenchent un élan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni gesto fa scaturire scintille. Più famiglie attive fanno scattare uno slancio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada gesto faz saltar faíscas. Várias famílias ativas acionam um impulso."
          }
        }
      }
    },
    "game.detail.fact.tier": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عشرون حالة: واحدة كل عشرة مستويات حتى 100، ثم واحدة لكل مئة، والتفرد من 1000."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwanzig Gestalten: eine alle zehn Level bis 100, dann eine je hundert, und die Singularität ab 1000."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twenty phases: one every ten levels up to 100, then one per hundred, and Singularity from 1000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Veinte estados: uno cada diez niveles hasta 100, luego uno por centena, y la Singularidad desde 1000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vingt états : un tous les dix niveaux jusqu’à 100, puis un par centaine, et la Singularité dès 1000."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Venti stati: uno ogni dieci livelli fino a 100, poi uno per centinaio, e la Singolarità da 1000."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinte estados: um a cada dez níveis até 100, depois um por centena, e a Singularidade a partir de 1000."
          }
        }
      }
    },
    "game.detail.fact.score": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنه نورك: الشرارات التي لديك. هو يصنع مستواك، والسكّ يصوغ جزءًا منه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein Licht: die Funken, die du hast. Es macht dein Level, und eine Prägung bannt einen Teil davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your light: the sparks you have. It makes your level, and a mint binds part of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es tu luz: las chispas que tienes. Hace tu nivel, y acuñar fija una parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est ta lumière : les étincelles que tu as. Elle fait ton niveau, et une frappe en fige une part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È la tua luce: le scintille che hai. Fa il tuo livello, e un conio ne fissa una parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É a sua luz: as faíscas que você tem. Ela faz o seu nível, e uma cunhagem cristaliza uma parte dela."
          }
        }
      }
    },
    "game.detail.fact.level_next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الشرارات التي تقود نورك إلى المستوى التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind die Funken, die dein Licht zum nächsten Level führen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the sparks that lead your light to the next level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son las chispas que llevan tu luz al nivel siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les étincelles qui mènent ta lumière au niveau suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono le scintille che portano la tua luce al livello successivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São as faíscas que levam a sua luz ao nível seguinte."
          }
        }
      }
    },
    "game.detail.fact.level_record": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه ذروة نورك: أعلى مستوى بلغته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein hellstes Licht: das höchste Level, das du erreicht hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your highest light: the highest level you have reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es tu luz más alta: el nivel más alto que has alcanzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est ta plus haute lumière : le plus haut niveau que tu as atteint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È la tua luce più alta: il livello più alto che hai raggiunto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o auge da sua luz: o nível mais alto que você alcançou."
          }
        }
      }
    },
    "game.detail.fact.tailwind": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنحك ⁦+25 %⁩ على أفعالك ما دام مستواك أدنى من ذروة نورك بسبعة مستويات أو أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "+25 % auf deine Aktionen, solange dein Level 7 oder mehr Level unter deinem hellsten Licht liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+25 % on your moves while your level is 7 or more levels below your highest light."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "+25 % en tus gestos mientras tu nivel esté 7 o más niveles bajo tu luz más alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "+25 % sur tes gestes tant que ton niveau est 7 niveaux ou plus sous ta plus haute lumière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "+25 % sui tuoi gesti finché il tuo livello è 7 livelli o più sotto la tua luce più alta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "+25% nos seus gestos enquanto o seu nível estiver 7 níveis ou mais abaixo do auge da sua luz."
          }
        }
      }
    },
    "game.detail.fact.mint_price": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجزء من نورك الذي ستصوغه Meesh التالية. والقواعد تشرح كيف يُحسب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist der Teil deines Lichts, den deine nächste Meesh bannt. Die Regeln erklären die Rechnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the part of your light your next Meesh will bind. The rules say how it’s worked out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la parte de tu luz que fijará tu próxima Meesh. Las reglas dicen cómo se calcula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est la part de ta lumière que ta prochaine Meesh figera. Les règles disent comment elle se calcule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È la parte della tua luce che la tua prossima Meesh fisserà. Le regole dicono come si calcola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É a parte da sua luz que a sua próxima Meesh vai cristalizar. As regras dizem como ela se calcula."
          }
        }
      }
    },
    "game.detail.fact.mint_missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الشرارات التي تنقص نورك لسكّ Meesh التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind die Funken, die deinem Licht für deine nächste Meesh fehlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the sparks your light still lacks to mint your next Meesh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son las chispas que le faltan a tu luz para acuñar tu próxima Meesh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les étincelles qui manquent à ta lumière pour frapper ta prochaine Meesh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono le scintille che mancano alla tua luce per coniare la tua prossima Meesh."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São as faíscas que faltam à sua luz para cunhar a sua próxima Meesh."
          }
        }
      }
    },
    "game.detail.fact.can_mint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
