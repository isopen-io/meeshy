    "composer.audience.scope": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجمهور يخص المنشور، لا الشريحة: تغيير النمط يحافظ عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zielgruppe gehört zum Beitrag, nie zu einer Folie: Ein Profilwechsel behält sie bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audience belongs to the publication, never to a slide: switching profile keeps it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La audiencia pertenece a la publicación, nunca a una diapositiva: cambiar de perfil la conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audience appartient à la publication, jamais à une slide : changer de profil la conserve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pubblico appartiene alla pubblicazione, mai a una slide: cambiare profilo lo conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O público pertence à publicação, nunca a um slide: mudar de perfil o mantém."
          }
        }
      }
    },
