    "story.viewer.navigation.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على اليسار للقصة السابقة، وعلى اليمين للتالية، واستمر بالضغط للإيقاف المؤقت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links tippen für die vorherige Story, rechts für die nächste, halten zum Pausieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap left for the previous story, right for the next, hold to pause"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca a la izquierda para la historia anterior, a la derecha para la siguiente, mantén pulsado para pausar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher à gauche pour la story précédente, à droite pour la suivante, maintenir pour mettre en pause"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca a sinistra per la storia precedente, a destra per la successiva, tieni premuto per mettere in pausa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque à esquerda para a história anterior, à direita para a próxima, segure para pausar"
          }
        }
