          "stringUnit": {
            "state": "translated",
            "value": "The audience belongs to the publication, never to a slide: switching profile keeps it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La audiencia pertenece a la publicación, nunca a una diapositiva: cambiar de perfil la conserva."
          }
        },
        "fr": {
          "stringUnit": {
