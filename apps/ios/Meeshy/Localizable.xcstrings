    "game.fiche.mint.mee.wait": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قليل من النور بعد، ونسكّ معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch ein wenig Licht, dann prägen wir zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little more light, and we mint together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco más de luz y acuñamos juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore un peu de lumière, et on frappe ensemble."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora un po’ di luce, e coniamo insieme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais um pouco de luz, e cunhamos juntos."
          }
        }
      }
    },
    "game.fiche.mint.missing": {
