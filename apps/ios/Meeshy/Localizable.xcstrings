    "auth.signup.password.why.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون كلمة مرور، ستسجّل الدخول دائمًا عبر رابط يصلك بالبريد الإلكتروني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Passwort meldest du dich immer über einen Link per E-Mail an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a password, you always sign in with a link sent by email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin contraseña, siempre inicias sesión con un enlace recibido por correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans mot de passe, vous vous connectez toujours par un lien reçu par e-mail."
