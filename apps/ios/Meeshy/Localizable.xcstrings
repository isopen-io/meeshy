        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello Meeshy! %1$@ here, just arrived. Anyone speak %2$@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hola Meeshy! Aquí %1$@, recién llegado/a. ¿Alguien habla %2$@?"
