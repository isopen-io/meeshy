            "state": "translated",
            "value": "You win the journey cup, a dated medal and %@ glory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganas la copa del viaje, una medalla fechada y %@ de gloria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu gagnes la coupe du voyage, une médaille datée et %@ de gloire."
