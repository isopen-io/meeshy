      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد موجودًا، أو أنه مخصص لجمهوره فقط. سجّل الدخول لمشاهدته إن كان موجّهًا إليك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er existiert nicht mehr oder ist nur für sein Publikum bestimmt. Melde dich an, um ihn zu sehen, falls er für dich gedacht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It no longer exists, or it’s only for its audience. Sign in to see it if it was meant for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no existe, o está reservado a su audiencia. Inicia sesión para verlo si va dirigido a ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’existe plus, ou il est réservé à son audience. Connectez-vous pour le voir s’il vous est destiné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non esiste più, oppure è riservato al suo pubblico. Accedi per vederlo se è destinato a te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele não existe mais ou é reservado ao seu público. Entre para vê-lo se ele foi destinado a você."
          }
        }
      }
