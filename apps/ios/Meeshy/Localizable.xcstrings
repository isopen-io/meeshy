    "game2.guide.moment.atlas_stamp.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تبادلت الرسائل فعلًا بهذه اللغة: رسالة مرسلة وأخرى مستلمة."
          }
        },
        "de": {
