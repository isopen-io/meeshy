          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore o aplicativo: algumas façanhas estão escondidas."
          }
        }
      }
    },
    "game.concept.succes.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أندرها تُنمّي مجدك أكثر من غيرها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die seltensten lassen deinen Ruhm am meisten wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rarest ones make your glory grow the most."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las más raras son las que más hacen crecer tu gloria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plus rares font le plus grandir ta gloire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le più rare fanno crescere di più la tua gloria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mais raras são as que mais fazem a sua glória crescer."
          }
        }
      }
    },
