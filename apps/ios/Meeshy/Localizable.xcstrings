          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua leggenda entra in una nuova Era, con un trofeo numerato e %@ di gloria. Il tuo rango non arretra mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
