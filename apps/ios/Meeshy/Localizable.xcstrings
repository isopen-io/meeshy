    "circles.settings.blockBring.detail": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses Bring n’arriveront plus chez vous. Cette personne n’en est pas prévenue."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their Brings will no longer reach you. They are not notified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus Bring ya no te llegarán. Esta persona no recibe ningún aviso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Bring erreichen dich nicht mehr. Die Person wird nicht benachrichtigt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi Bring non ti arriveranno più. Questa persona non viene avvisata."
          }
        },
