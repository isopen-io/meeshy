    "e2ee.devices.notice.failed.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتغير شيء. تحقق من اتصالك ثم أعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wurde geändert. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changed. Check your connection, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ha cambiado nada. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a changé. Vérifiez votre connexion, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è cambiato nulla. Controlla la connessione e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada mudou. Verifique sua conexão e tente novamente."
          }
        }
      }
    },
    "e2ee.devices.section.header": {
      "extractionState": "manual",
