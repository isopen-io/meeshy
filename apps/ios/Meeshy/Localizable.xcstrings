    "game2.guide.moment.prestige.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسطورتك تدخل عصرًا جديدًا، مع كأس مرقّمة و%@ من المجد. ورتبتك لا تتراجع أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Legende tritt in ein neues Zeitalter, mit einer nummerierten Trophäe und %@ Ruhm. Dein Rang weicht nie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your legend enters a new Age, with a numbered trophy and %@ glory. Your rank never goes back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu leyenda entra en una nueva Edad, con un trofeo numerado y %@ de gloria. Tu rango nunca retrocede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
