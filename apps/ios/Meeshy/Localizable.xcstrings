        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar novamente"
          }
        }
      }
    },
    "feed.nearby.consent.exactBadge": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمّا المكان المعروض على المنشور فيُرسَل بدقة إعداد مشاركة موقعك — وهي حاليًا دقيقة تمامًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der auf dem Beitrag angezeigte Ort wird dagegen mit der Genauigkeit deiner Standortfreigabe gesendet – derzeit exakt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The place shown on the post, however, is sent at your location-sharing precision — currently exact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cambio, el lugar mostrado en la publicación se envía con la precisión de tu ajuste de compartir ubicación: actualmente exacta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lieu affiché sur la publication part, lui, à la précision de votre partage de position — actuellement exacte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il luogo mostrato sul post viene invece inviato con la precisione della tua condivisione della posizione: attualmente esatta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já o local exibido na publicação é enviado com a precisão do seu compartilhamento de localização — atualmente exata."
          }
        }
      }
    },
    "feed.nearby.precision.applied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيكون هذا المحتوى قابلًا للعثور عليه بدقة «%@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
