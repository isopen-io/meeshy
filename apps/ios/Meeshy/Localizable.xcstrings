    },
    "game.detail.gem.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ بين أوائل مبارزتك لترتقي إلى الحلقة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lande unter den Ersten deines Turniers, um in den nächsten Kreis aufzusteigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish among the first of your joust to climb to the next circle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina entre los primeros de tu justa para subir al círculo siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finis parmi les premiers de ta joute pour gravir le cercle suivant."
