    "conversation.encryption.note.revert.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك دائمًا فتح محادثة أخرى، دون تشفير تام بين الطرفين، مع الأشخاص أنفسهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jederzeit eine andere Unterhaltung ohne Ende-zu-Ende-Verschlüsselung mit denselben Personen öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can always open another conversation, without end-to-end encryption, with the same people."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre podrás abrir otra conversación, sin cifrado de extremo a extremo, con las mismas personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez toujours ouvrir une autre conversation, sans chiffrement de bout en bout, avec les mêmes personnes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai sempre aprire un’altra conversazione, senza crittografia end-to-end, con le stesse persone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você sempre poderá abrir outra conversa, sem criptografia de ponta a ponta, com as mesmas pessoas."
          }
        }
      }
    },
    "conversation.encryption.note.revertDirect.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك دائمًا أن تفتح بجانبها محادثة أخرى، دون تشفير تام بين الطرفين، مع هذا الشخص: كلتاهما في القائمة، وهذه مميّزة بقفل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst daneben jederzeit eine andere Unterhaltung ohne Ende-zu-Ende-Verschlüsselung mit dieser Person öffnen: Beide stehen in der Liste, diese mit einem Schloss markiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can always open another conversation alongside, without end-to-end encryption, with this person: both are in the list, this one marked with a padlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre podrás abrir al lado otra conversación, sin cifrado de extremo a extremo, con esta persona: las dos están en la lista, esta marcada con un candado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez toujours ouvrir à côté une autre conversation, sans chiffrement de bout en bout, avec cette personne : les deux sont dans la liste, celle-ci marquée d’un cadenas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai sempre aprire accanto un’altra conversazione, senza crittografia end-to-end, con questa persona: entrambe sono nell’elenco, questa segnata da un lucchetto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você sempre poderá abrir ao lado outra conversa, sem criptografia de ponta a ponta, com esta pessoa: as duas estão na lista, esta marcada com um cadeado."
          }
        }
      }
    },
    "conversation.encryption.note.hybridLayer.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وبين جهازين متوافقين، تتيح طبقة ثانية أيضًا التحقق من أن الرسالة النصية لم تُعدَّل في الطريق؛ وعند غيابها، لا يُعرض أي شيء على أنه موثَّق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen zwei kompatiblen Geräten lässt sich mit einer zweiten Schicht zusätzlich prüfen, dass eine Textnachricht unterwegs nicht verändert wurde; fehlt sie, wird nichts als geprüft dargestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Between two compatible devices, a second layer also lets you check that a text message was not altered on the way; when it is missing, nothing is presented as verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre dos dispositivos compatibles, una segunda capa permite además comprobar que un mensaje de texto no se modificó por el camino; cuando falta, nada se presenta como verificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre deux appareils compatibles, une seconde couche permet en plus de vérifier qu’un message texte n’a pas été modifié en chemin ; quand elle manque, rien n’est présenté comme vérifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra due dispositivi compatibili, un secondo livello permette inoltre di verificare che un messaggio di testo non sia stato modificato lungo il percorso; quando manca, nulla viene presentato come verificato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre dois aparelhos compatíveis, uma segunda camada permite ainda verificar que uma mensagem de texto não foi alterada no caminho; quando ela falta, nada é apresentado como verificado."
          }
        }
      }
    },
    "share.link.create.access.birthday_required.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
