    "settings.media.capture.rendered.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقائيًا عند تأكيد التعديل. وإلا فإن سهم التعديل يحفظها عند الطلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch beim Bestätigen der Bearbeitung. Sonst sichert sie der Pfeil der Bearbeitung auf Wunsch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically when you confirm the edit. Otherwise, the arrow in the edit view saves it on demand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automáticamente al validar la edición. Si no, la flecha de la edición la guarda cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiquement en validant la retouche. Sinon, la flèche de la retouche l'enregistre à la demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticamente quando confermi la modifica. Altrimenti, la freccia della modifica la salva su richiesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticamente ao confirmar a edição. Caso contrário, a seta da edição a salva quando você quiser."
          }
        }
      }
    },
