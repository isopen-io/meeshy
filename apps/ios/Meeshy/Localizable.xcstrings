    "game.detail.player.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بطل من مبارزتك. لا ترى إلا اسمه في المبارزة وشرارات أسبوعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Held deines Turniers. Du siehst nur seinen Turniernamen und seine Funken der Woche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hero of your joust. You only see their joust name and their sparks of the week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un héroe de tu justa. Solo ves su nombre de justa y sus chispas de la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un héros de ta joute. Tu ne vois que son nom de joute et ses étincelles de la semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un eroe del tuo torneo. Vedi solo il suo nome di torneo e le sue scintille della settimana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um herói do seu torneio. Você só vê o nome de torneio dele e as faíscas da semana."
          }
        }
      }
    },
    "game.detail.badge.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوسام يُظهر كم مرة قمت بإجراء ما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Medaille zeigt, wie oft du eine Aktion gemacht hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A medal shows how many times you’ve made a move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una medalla muestra cuántas veces has hecho un gesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une médaille montre combien de fois tu as fait un geste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una medaglia mostra quante volte hai fatto un gesto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma medalha mostra quantas vezes você fez um gesto."
          }
        }
      }
    },
    "game.detail.badge.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرّر هذا الإجراء: عند كل درجة يتغيّر معدن الوسام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach diese Aktion wieder: Bei jeder Schwelle wechselt die Medaille das Material."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make that move again: at each threshold, the medal changes material."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite ese gesto: en cada umbral, la medalla cambia de material."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refais ce geste : à chaque seuil, la médaille change de matière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifai quel gesto: a ogni soglia, la medaglia cambia materia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Refaça esse gesto: a cada limiar, a medalha muda de material."
          }
        }
      }
    },
    "game.detail.succes.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المأثرة تُخلّد لحظة نادرة من أسطورتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Heldentat hält einen seltenen Moment deiner Legende fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A great deed marks a rare moment in your legend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hazaña marca un momento raro de tu leyenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un haut fait marque un moment rare de ta légende."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’impresa segna un momento raro della tua leggenda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma façanha marca um momento raro da sua lenda."
          }
        }
      }
    },
    "game.detail.succes.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع ما تطلبه: تتحقّق دفعة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfülle, was sie verlangt: Sie gelingt auf einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gather what it asks for: it is done in one go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne lo que pide: se logra de una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réunis ce qu’il demande : il s’accomplit d’un coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riunisci ciò che chiede: si compie in un colpo solo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúna o que ela pede: ela se cumpre de uma vez."
          }
        }
      }
    },
    "game.detail.defi.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحدي درجة تتجاوزها في فئة من الإجراءات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Herausforderung ist eine Stufe in einer Familie von Aktionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A challenge is a tier to clear in a family of actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un desafío es un escalón que superar en una familia de gestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un défi est un palier à franchir dans une famille de gestes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sfida è un gradino da superare in una famiglia di gesti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um desafio é um patamar a vencer numa família de gestos."
          }
        }
      }
    },
    "game.detail.defi.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابلغ العدد المطلوب: تُفتح الدرجة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreiche die verlangte Zahl: Die nächste Stufe öffnet sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach the number it asks for: the next tier opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcanza el número pedido: se abre el escalón siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteins le nombre demandé : le palier suivant s’ouvre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiungi il numero richiesto: si apre il gradino successivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcance o número pedido: o patamar seguinte se abre."
          }
        }
      }
    },
    "game.detail.trophy.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكأس يحفظ ذكرى فوز. لا يمنح شيئًا: إنه للعرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Trophäe bewahrt die Erinnerung an einen Sieg. Sie bringt nichts: Man zeigt sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A trophy keeps the memory of a win. It earns nothing: it’s for show."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trofeo guarda el recuerdo de una victoria. No da nada: se enseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trophée garde la trace d’une victoire. Il ne rapporte rien : il se montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trofeo conserva il ricordo di una vittoria. Non rende nulla: si mostra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um troféu guarda a lembrança de uma vitória. Não rende nada: é para mostrar."
          }
        }
      }
    },
    "game.detail.trophy.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ في قمة مبارزتك، أو أتمّ رحلة، أو انبعث، أو حافظ على لهبك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lande ganz oben in deinem Turnier, vollende eine Reise, werde wiedergeboren oder halte deine Flamme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish at the top of your joust, complete a journey, be reborn or keep your Flame alive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina arriba en tu justa, termina un viaje, renace o mantén tu Llama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finis en haut de ta joute, achève un voyage, renais ou tiens ta Flamme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finisci in cima al tuo torneo, porta a termine un viaggio, rinasci o tieni viva la tua Fiamma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine no alto do seu torneio, complete uma viagem, renasça ou mantenha sua Chama."
          }
        }
      }
    },
    "game.detail.stamp.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الختم يثبت أنك تبادلت الرسائل فعلًا بهذه اللغة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Stempel beweist, dass du dich in dieser Sprache wirklich ausgetauscht hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stamp proves you really chatted in this language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sello demuestra que has conversado de verdad en este idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tampon prouve que tu as vraiment échangé dans cette langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un timbro prova che hai davvero conversato in questa lingua."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um carimbo prova que você conversou de verdade neste idioma."
          }
        }
      }
    },
    "game.detail.stamp.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل رسالة بهذه اللغة، واستقبل واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende eine Nachricht in dieser Sprache und erhalte eine zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a message in this language, and get one back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un mensaje en este idioma y recibe otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un message dans cette langue, et reçois-en un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un messaggio in questa lingua e ricevine uno."
          }
        },
        "pt-BR": {
