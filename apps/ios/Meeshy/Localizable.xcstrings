    "guest.ended.expired.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا الرابط يتيح الوصول إلى المحادثة. اطلب رابطًا جديدًا من الشخص الذي أرسله إليك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link öffnet die Unterhaltung nicht mehr. Bitte die Person, die ihn dir geschickt hat, um einen neuen Link."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link no longer opens the conversation. Ask the person who sent it for a new link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace ya no da acceso a la conversación. Pide un enlace nuevo a la persona que te lo envió."
