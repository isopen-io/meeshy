    "settings.media.capture.original.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الصورة أو الفيديو الخام، دون تأثيرات أو إطار، في الصور مع كل لقطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das unbearbeitete Foto oder Video, ohne Effekt oder Rahmen, wird bei jeder Aufnahme in Fotos gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The raw photo or video, with no effect or frame, is saved to Photos with every shot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto o el vídeo sin procesar, sin efectos ni marco, se guarda en Fotos con cada toma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo ou la vidéo brute, sans effet ni cadre, rejoint Photos à chaque prise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto o il video originale, senza effetti né cornice, viene salvato in Foto a ogni scatto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto ou o vídeo bruto, sem efeito nem moldura, é salvo no Fotos a cada captura."
          }
        }
      }
    },
