    "game.atlas.ranks.line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجدك يُنمّي رتبتك. ولا تتراجع أبدًا، حتى عندما تسكّ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ruhm lässt deinen Rang wachsen. Er weicht nie zurück, auch nicht, wenn du prägst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your glory grows your rank. It never goes back, even when you mint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu gloria hace crecer tu rango. Nunca retrocede, ni siquiera cuando acuñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta gloire fait grandir ton rang. Il ne recule jamais, même quand tu frappes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua gloria fa crescere il tuo rango. Non arretra mai, nemmeno quando conii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua glória faz seu título crescer. Ele nunca recua, nem quando você cunha."
          }
        }
      }
    },
    "game.atlas.ranks.myth": {
      "extractionState": "manual",
