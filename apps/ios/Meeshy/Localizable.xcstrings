    "game.guide.moment.new_tier.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نورك يسطع في %@!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Licht strahlt als %@!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light shines as %@!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Tu luz brilla en %@!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta lumière brille en %@ !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua luce brilla come %@!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua luz agora é %@!"
          }
        }
      }
    },
    "game.guide.moment.new_tier.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نورك يعبر عشرين حالة: واحدة كل عشرة مستويات حتى 100، ثم واحدة كل مئة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Licht wandelt sich durch zwanzig Gestalten: eine alle zehn Level bis 100, danach eine je hundert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light passes through twenty phases: one every ten levels up to 100, then one per hundred."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu luz atraviesa veinte estados: uno cada diez niveles hasta el 100, luego uno por centena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta lumière traverse vingt états : un tous les dix niveaux jusqu’au 100, puis un par centaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua luce attraversa venti stati: uno ogni dieci livelli fino al 100, poi uno per centinaio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua luz atravessa vinte estados: um a cada dez níveis até o 100, depois um por centena."
          }
        }
      }
    },
    "game.guide.moment.new_tier.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالته التالية تستيقظ عند المستوى %@."
