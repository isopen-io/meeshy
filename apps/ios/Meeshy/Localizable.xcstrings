    "circles.ritual.consent.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل الختم، اختر ما تشاركه مع %@. يمكنك رفض أي مشاركة والعودة إليها لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle vor dem Besiegeln, was du mit %@ teilst. Jede Freigabe kannst du ablehnen, und du kannst sie später ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before sealing, choose what you share with %@. Each share can be declined, and you can come back to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de sellar, elige qué compartes con %@. Cada uso compartido puede rechazarse y podrás volver a él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de sceller, choisis ce que tu partages avec %@. Chaque partage est refusable, et tu pourras y revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di sigillare, scegli cosa condividi con %@. Ogni condivisione si può rifiutare e potrai tornarci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de selar, escolha o que você compartilha com %@. Cada compartilhamento pode ser recusado e você poderá voltar a ele."
          }
        }
      }
    },
    "circles.ritual.consent.listeningTitle": {
