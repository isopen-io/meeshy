    "game.guide.moment.missions_unlocked.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل إليك أجدادك حلمك الأول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Ahnen schicken dir deinen ersten Traum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ancestors send you your first dream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ancestros te envían tu primer sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes aïeux t’envoient ton premier rêve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi antenati ti mandano il tuo primo sogno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus ancestrais enviam o seu primeiro sonho."
          }
        }
      }
    },
    "game.guide.moment.missions_unlocked.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ليلة، حلم من ثلاثة فصول. حقّقها، فتظهر العطيّة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Nacht ein Traum in drei Akten. Erfülle sie, und die Gabe erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each night, a dream in three acts. Complete them, and the Offering appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada noche, un sueño en tres actos. Hazlos realidad y aparece la Ofrenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque nuit, un rêve en trois actes. Réalise-les, et l’Offrande apparaît."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni notte, un sogno in tre atti. Compili, e appare l’Offerta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda noite, um sonho em três atos. Realize-os, e a Oferenda aparece."
          }
        }
      }
    },
    "game.guide.moment.missions_unlocked.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
