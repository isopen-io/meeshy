    "e2ee.devices.step.read.done": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم: هذا الجهاز يراسله ويقرأ رسائله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledigt: Dieses Gerät schreibt ihm und liest es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done: this device writes to it and reads it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho: este dispositivo le escribe y lo lee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est fait : cet appareil lui écrit et le lit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto: questo dispositivo gli scrive e lo legge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito: este dispositivo escreve para ele e o lê."
          }
        }
      }
    },
    "e2ee.devices.step.read.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على «%@»، افتح أجهزتي المشفّرة › إظهار رمزي، ثم امسحه هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf „%@“ Meine verschlüsselten Geräte › Meinen Code zeigen und lies ihn hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On “%@”, open My encrypted devices › Show my code, then scan it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «%@», abre Mis dispositivos cifrados › Mostrar mi código y léelo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur « %@ », ouvrez Mes appareils chiffrés › Montrer mon code, puis lisez-le ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su «%@», apri I miei dispositivi crittografati › Mostra il mio codice, poi leggilo qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em “%@”, abra Meus dispositivos criptografados › Mostrar meu código e leia-o aqui."
          }
        }
      }
    },
    "e2ee.devices.step.read.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة رمزه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seinen Code scannen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
