    "signInLink.deviceConfirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُطلب هذا الرابط من هذا الجهاز. إنه يفتح %@: لا تتابع إلا إذا كان ملكك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link wurde nicht von diesem Gerät angefordert. Er öffnet %@: Fahre nur fort, wenn es dir gehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link was not requested from this device. It opens %@: continue only if it is yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace no se solicitó desde este dispositivo. Abre %@: continúa solo si es tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien n'a pas été demandé depuis cet appareil. Il ouvre %@ : continuez seulement s'il vous appartient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo link non è stato richiesto da questo dispositivo. Apre %@: continua solo se è tuo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link não foi solicitado neste aparelho. Ele abre %@: só continue se for sua."
          }
        }
      }
    },
    "signInLink.deviceConfirm.messageReplacing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُطلب هذا الرابط من هذا الجهاز. إنه يفتح %1$@ بدلًا من %2$@ (الذي يبقى في محدد الحسابات): لا تتابع إلا إذا كان ملكك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link wurde nicht von diesem Gerät angefordert. Er öffnet %1$@ anstelle von %2$@ (bleibt in der Kontoauswahl): Fahre nur fort, wenn es dir gehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link was not requested from this device. It opens %1$@ instead of %2$@ (which stays in the account switcher): continue only if it is yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace no se solicitó desde este dispositivo. Abre %1$@ en lugar de %2$@ (que sigue en el selector de cuentas): continúa solo si es tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien n'a pas été demandé depuis cet appareil. Il ouvre %1$@ à la place de %2$@ (qui reste au sélecteur de comptes) : continuez seulement s'il vous appartient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo link non è stato richiesto da questo dispositivo. Apre %1$@ al posto di %2$@ (che resta nel selettore di account): continua solo se è tuo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link não foi solicitado neste aparelho. Ele abre %1$@ no lugar de %2$@ (que continua no seletor de contas): só continue se for sua."
          }
        }
      }
    },
