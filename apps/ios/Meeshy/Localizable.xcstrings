    "settings.privacy.calls.hide_ip": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء عنوان IP الخاص بي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine IP-Adresse verbergen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide my IP address"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar mi dirección IP"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer mon adresse IP"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi il mio indirizzo IP"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar meu endereço IP"
          }
        }
      }
    },
    "settings.privacy.calls.hide_ip.info": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرّ مكالماتك عبر خادم ترحيل من Meeshy: لا يرى محاورك عنوان IP الخاص بك. قد يكون الاتصال أبطأ قليلاً. ينطبق هذا الإعداد على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anrufe laufen über ein Meeshy-Relais: Dein Gegenüber sieht deine IP-Adresse nicht. Die Verbindung kann etwas langsamer sein. Diese Einstellung gilt für dieses Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your calls go through a Meeshy relay: the other person does not see your IP address. The connection may be a little slower. This setting applies to this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus llamadas pasan por un relé de Meeshy: tu interlocutor no ve tu dirección IP. La conexión puede ser un poco más lenta. Este ajuste se aplica a este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos appels passent par un relais Meeshy : votre correspondant ne voit pas votre adresse IP. La connexion peut être un peu plus lente. Ce réglage vaut pour cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue chiamate passano da un relay Meeshy: il tuo interlocutore non vede il tuo indirizzo IP. La connessione può essere un po' più lenta. Questa impostazione vale per questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas chamadas passam por um relé da Meeshy: seu interlocutor não vê seu endereço IP. A conexão pode ser um pouco mais lenta. Esta configuração vale para este aparelho."
          }
        }
      }
    },
    "settings.privacy.calls.hide_ip.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا يفعل «إخفاء عنوان IP الخاص بي»؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was bewirkt „Meine IP-Adresse verbergen“?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does “Hide my IP address” do?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué hace «Ocultar mi dirección IP»?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que fait « Masquer mon adresse IP » ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa fa «Nascondi il mio indirizzo IP»?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que faz “Ocultar meu endereço IP”?"
          }
        }
      }
    },
    "settings.privacy.calls_non_contacts": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكالمات من خارج جهات الاتصال"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufe von Nicht-Kontakten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls from non-contacts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llamadas de no contactos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appels hors contacts"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiamate da non contatti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chamadas de não contatos"
          }
        }
      }
    },
    "settings.privacy.calls_non_contacts.info": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إيقافه، لا يستطيع إلا أصدقاؤك جعل هاتفك يرن. يرى الآخرون أنك لا تقبل إلا المكالمات من جهات اتصالك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviert können nur deine Freunde dein Telefon klingeln lassen. Andere sehen, dass du nur Anrufe von deinen Kontakten annimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, only your friends can make your phone ring. Others see that you only accept calls from your contacts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, solo tus amigos pueden hacer sonar tu teléfono. Los demás ven que solo aceptas llamadas de tus contactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, seuls vos amis peuvent vous faire sonner. Les autres voient que vous n'acceptez que les appels de vos contacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, solo i tuoi amici possono far squillare il tuo telefono. Gli altri vedono che accetti solo chiamate dai tuoi contatti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, só seus amigos podem fazer seu telefone tocar. Os outros veem que você só aceita chamadas dos seus contatos."
          }
        }
      }
    },
    "settings.privacy.calls_non_contacts.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من يستطيع الاتصال بي؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer kann mich anrufen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who can call me?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quién puede llamarme?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui peut m'appeler ?"
          }
        },
        "it": {
