    "about.licenses.meeshy.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنشر الكود المصدري لـ Meeshy بموجب ترخيص MIT. يتضمن هذا التطبيق مكتبة libsignal ‏(Signal Messenger) المنشورة بموجب ترخيص GNU AGPL-3.0، لذا فإن التطبيق الموزَّع عمل مرخَّص بموجب ترخيص AGPL-3.0 فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Quellcode von Meeshy wird unter der MIT-Lizenz veröffentlicht. Diese App enthält libsignal (Signal Messenger), veröffentlicht unter der GNU AGPL-3.0: Die verteilte App ist daher ein Werk, das ausschließlich unter der AGPL-3.0 lizenziert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy’s source code is published under the MIT license. This app includes libsignal (Signal Messenger), published under the GNU AGPL-3.0: the distributed app is therefore a work licensed under the AGPL-3.0 only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código fuente de Meeshy se publica bajo la licencia MIT. Esta aplicación incluye libsignal (Signal Messenger), publicado bajo la licencia GNU AGPL-3.0: la aplicación distribuida es, por tanto, una obra bajo la licencia AGPL-3.0 únicamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code source de Meeshy est publié sous licence MIT. Cette application intègre libsignal (Signal Messenger), publié sous licence GNU AGPL-3.0 : l’application distribuée est donc une œuvre sous licence AGPL-3.0 uniquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice sorgente di Meeshy è pubblicato con licenza MIT. Questa app include libsignal (Signal Messenger), pubblicato con licenza GNU AGPL-3.0: l’app distribuita è quindi un’opera concessa esclusivamente con licenza AGPL-3.0."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código-fonte do Meeshy é publicado sob a licença MIT. Este aplicativo inclui a libsignal (Signal Messenger), publicada sob a licença GNU AGPL-3.0: o aplicativo distribuído é, portanto, uma obra sob a licença AGPL-3.0 somente."
          }
        }
      }
    },
