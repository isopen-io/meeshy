    "circles.ritual.consent.locationLive.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى مكاني باستمرار ما دامت المشاركة مفعّلة."
          }
        },
        "de": {
