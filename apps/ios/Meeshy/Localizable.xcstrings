    "game.error.chest_not_ready": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقّق أولًا فصول الحلم الثلاثة: ستظهر العطيّة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfülle zuerst die drei Akte des Traums: Dann erscheint die Gabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the dream’s three acts first: the Offering will appear."
          }
