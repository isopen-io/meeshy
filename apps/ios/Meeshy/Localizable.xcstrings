    "conversation.obsolete.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُمحى كل محتوى «%@» لدى جميع الأعضاء، وستختفي المحادثة من قوائمهم. هذا نهائي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Inhalte von „%@“ werden für alle Mitglieder gelöscht, und die Unterhaltung verschwindet aus ihren Listen. Das ist endgültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All content in “%@” will be erased for every member, and the conversation will disappear from their lists. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el contenido de «%@» se borrará para todos los miembros y la conversación desaparecerá de sus listas. Es definitivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le contenu de « %@ » sera effacé pour tous les membres, et la conversation disparaîtra de leurs listes. C'est définitif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto il contenuto di «%@» sarà cancellato per tutti i membri e la conversazione scomparirà dai loro elenchi. È definitivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o conteúdo de “%@” será apagado para todos os membros, e a conversa desaparecerá das listas deles. É definitivo."
          }
        }
      }
    },
    "conversation.obsolete.error": {
      "extractionState": "manual",
      "localizations": {
