    "settings.media.opening.camera.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفتح الكاميرا خلف المشهد فور فتح المحرّر. اضغط مطولًا على المشهد للتصوير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera öffnet sich hinter der Szene, sobald der Editor aufgeht. Halte die Szene gedrückt, um zu filmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera opens behind the scene as soon as the composer opens. Hold the scene to film."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se abre detrás de la escena en cuanto se abre el editor. Mantén pulsada la escena para grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra s'ouvre derrière la scène dès l'ouverture du composer. Maintenez la scène pour filmer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera si apre dietro la scena appena si apre l'editor. Tieni premuta la scena per registrare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera abre atrás da cena assim que o editor abre. Toque e segure a cena para gravar."
          }
        }
      }
    },
