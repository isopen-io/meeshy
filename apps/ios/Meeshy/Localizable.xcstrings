    "game2.settings.hidden.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفي اللعبة على هذا الجهاز، ويغلق كؤوسك ورتبتك وإرثك وأطلسك أمام الآخرين، ويخرجك من المبارزة العامة. تبقى الشرارات والكؤوس محفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet das Spiel auf diesem Gerät aus, verbirgt Trophäen, Rang, Erbe und Atlas vor anderen, nimmt dich aus dem öffentlichen Turnier. Funken und Trophäen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the game on this device, closes your trophies, rank, Legacy and Atlas to others, takes you out of the public joust. Sparks and trophies are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta el juego en este dispositivo, cierra tus trofeos, tu rango, tu Legado y tu Atlas a los demás, te saca de la justa pública. Chispas y trofeos se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque le jeu sur cet appareil, ferme tes trophées, ton rang, ton Héritage et ton Atlas aux autres, te retire de la joute publique. Étincelles et trophées gardés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde il gioco su questo dispositivo, chiude trofei, rango, Eredità e Atlante agli altri, ti toglie dal torneo pubblico. Scintille e trofei restano custoditi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esconde o jogo neste aparelho, fecha seus troféus, seu título, sua Herança e seu Atlas para os outros, tira você do torneio público. Faíscas e troféus são guardados."
          }
        }
      }
    },
