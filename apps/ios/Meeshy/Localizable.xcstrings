    "game2.atlas.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أطلسك خاص افتراضيًا: قد تكشف اللغة الكثير عنك. تحتفظ اللعبة باللغة والاتجاهين والتاريخ فقط — لا بالطرف الآخر ولا بالمحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Atlas ist standardmäßig privat: Eine Sprache kann viel über dich verraten. Das Spiel speichert die Sprache, beide Richtungen und das Datum — nie das Gegenüber oder die Unterhaltung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Atlas is private by default: a language can say a lot about you. The game keeps the language, both directions and the date — never the other person or the conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Atlas es privado por defecto: un idioma puede decir mucho de ti. El juego guarda el idioma, los dos sentidos y la fecha, nunca al interlocutor ni la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton Atlas est privé par défaut : une langue peut en dire long sur toi. Le jeu garde la langue, les deux sens et la date — jamais l’interlocuteur ni la conversation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Atlante è privato per impostazione predefinita: una lingua può dire molto di te. Il gioco conserva la lingua, i due sensi e la data — mai l’interlocutore né la conversazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Atlas é privado por padrão: um idioma pode dizer muito sobre você. O jogo guarda o idioma, os dois sentidos e a data — nunca o interlocutor nem a conversa."
          }
        }
      }
    },
    "game2.atlas.empty": {
