    "security.verify.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرسائل مع %@ مشفّرة من طرف إلى طرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten mit %@ sind Ende-zu-Ende-verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages with %@ are end-to-end encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes con %@ están cifrados de extremo a extremo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages avec %@ sont chiffrés de bout en bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi con %@ sono crittografati end-to-end."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens com %@ são criptografadas de ponta a ponta."
          }
        }
      }
    },
    "security.verify.howto": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للتحقق، قارن هذا الرقم بالرقم الظاهر على جهاز %@، أو امسح رمز الاستجابة السريعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche zum Überprüfen diese Nummer mit der auf dem Gerät von %@, oder scanne den QR-Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To verify, compare this number with the one shown on %@'s device, or scan their QR code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para verificar, compara este número con el que aparece en el dispositivo de %@, o escanea su código QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vérifier, comparez ce nombre avec celui affiché sur l'appareil de %@, ou scannez son code QR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per verificare, confronta questo numero con quello mostrato sul dispositivo di %@, oppure scansiona il suo codice QR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para verificar, compare este número com o exibido no aparelho de %@, ou escaneie o código QR."
          }
        }
      }
    },
