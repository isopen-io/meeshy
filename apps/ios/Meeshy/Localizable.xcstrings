    "circles.ritual.consent.listeningTitle.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى العنوان والمصدر مباشرةً ما دامت المشاركة مفعّلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person sieht Titel und Quelle live, solange die Freigabe aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They see the title and source, live, while sharing is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve el título y la fuente, en vivo, mientras el uso compartido está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il voit le titre et la source, en direct, tant que le partage est actif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vede titolo e fonte, in tempo reale, finché la condivisione è attiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê o título e a fonte, ao vivo, enquanto o compartilhamento estiver ativo."
          }
        }
      }
    },
    "circles.ritual.consent.locationHistory": {
