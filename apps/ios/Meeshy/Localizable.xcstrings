    "game2.guide.moment.league_relegated.next_far": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اصعد من جديد هذا الأسبوع: كل شرارة لها وزنها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steig diese Woche wieder auf: Jeder Funke zählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Climb back this week: every spark counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a subir esta semana: cada chispa cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remonte dès cette semaine : chaque étincelle compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risali già questa settimana: ogni scintilla conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte a subir esta semana: cada faísca conta."
          }
        }
      }
    },
    "game2.guide.moment.league_relegated.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اصعد من جديد هذا الأسبوع: %@ حتى الحلقة التالية."
          }
        },
        "de": {
          "stringUnit": {
