    },
    "game.concept.meesh.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملات Meesh التي تحتفظ بها تصنع الإرث الذي تتركه لسلالتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Meeshes, die du behältst, bilden das Erbe für deine Linie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Meeshes you keep form the legacy you leave to your line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Meeshes que guardas forman el legado que dejas a tu linaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Meeshes que tu gardes forment l’héritage que tu laisses à ta lignée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Meesh che custodisci formano l’eredità che lasci alla tua stirpe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Meeshes que você guarda formam a herança da sua linhagem."
          }
        }
      }
    },
    "game.concept.meesh.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سكّ Meesh يصوغ جزءًا من نورك في قطعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Meesh zu prägen bannt einen Teil deines Lichts in eine Münze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minting a Meesh binds part of your light into a coin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuñar una Meesh fija una parte de tu luz en una moneda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frapper une Meesh fige une part de ta lumière dans une pièce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coniare una Meesh fissa una parte della tua luce in una moneta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunhar uma Meesh cristaliza uma parte da sua luz numa moeda."
          }
        }
      }
    },
    "game.concept.meesh.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بعملات Meesh: ينتقل إرثك من وعاء إلى الذي يليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte deine Meeshes: Dein Erbe wandert von einem Behältnis ins nächste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Meeshes: your legacy moves from one container to the next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus Meeshes: tu legado pasa de un recipiente al siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde tes Meeshes : ton héritage passe d’un contenant au suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Custodisci le tue Meesh: la tua eredità passa da una custodia alla successiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde suas Meeshes: sua herança passa de um recipiente ao seguinte."
          }
        }
      }
    },
    "game.concept.meesh.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنفقها لتسهر على لهبك أو لتبدّل فصلًا من حلمك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib sie aus, um über deine Flamme zu wachen oder einen Akt deines Traums zu tauschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend them to watch over your Flame or to change an act of your dream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gástalas para velar por tu Llama o cambiar un acto de tu sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépense-les pour veiller sur ta Flamme ou changer un acte de ton rêve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spendile per vegliare sulla tua Fiamma o cambiare un atto del tuo sogno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaste-as para cuidar da sua Chama ou trocar um ato do seu sonho."
          }
        }
      }
    },
    "game.concept.glory.name": {
