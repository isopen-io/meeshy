    "game2.guide.moment.league_first.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل أسبوع، تقيس نفسك مع 29 بطلًا آخر. السبعة الأوائل يرتقون إلى الحلقة التالية، والخمسة الأخيرون يهبطون، وتبدأ الشرارات من الصفر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Woche misst du dich mit 29 anderen Helden. Die ersten 7 steigen in den nächsten Kreis auf, die letzten 5 steigen ab, und die Funken beginnen wieder bei null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each week, you measure yourself against 29 other heroes. The top 7 climb to the next circle, the bottom 5 go back down, and the sparks start again from zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada semana te mides con otros 29 héroes. Los 7 primeros suben al círculo siguiente, los 5 últimos bajan, y las chispas vuelven a cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque semaine, tu te mesures à 29 autres héros. Les 7 premiers gravissent le cercle suivant, les 5 derniers redescendent, et les étincelles repartent de zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni settimana ti misuri con altri 29 eroi. I primi 7 salgono al cerchio successivo, gli ultimi 5 riscendono, e le scintille ripartono da zero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda semana, você se mede com outros 29 heróis. Os 7 primeiros sobem para o círculo seguinte, os 5 últimos voltam a descer, e as faíscas recomeçam do zero."
          }
        }
      }
    },
