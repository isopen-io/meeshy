    "Cela supprimera tous les medias mis en cache localement. Ils seront retelecharges si necessaire.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جميع الوسائط المخزَّنة محليًا. وسيُعاد تنزيلها عند الحاجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht alle lokal zwischengespeicherten Medien. Sie werden bei Bedarf erneut heruntergeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete all locally cached media. They will be re-downloaded if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará todos los medios almacenados localmente. Se volverán a descargar si es necesario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati tutti i media memorizzati localmente. Saranno riscaricati se necessario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso excluirá todas as mídias armazenadas localmente. Elas serão baixadas novamente se necessário."
          }
        }
      }
    },
    "Cette action est irreversible": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
