    "game.state.level.progress": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نورك يسطع في المستوى %1$@: %2$@ من %3$@ في هذا المستوى، و%4$@ حتى المستوى %5$@."
          }
        },
        "de": {
