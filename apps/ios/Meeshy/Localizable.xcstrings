            "value": "Vinci la coppa del viaggio, una medaglia datata e %@ di gloria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ganha a taça da viagem, uma medalha datada e %@ de glória."
          }
        }
      }
    },
