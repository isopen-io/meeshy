    "game.guide.moment.flame_at_risk.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطفئ عند منتصف الليل إن لم تقم بأي إجراء: %@ من اللهب تنتظر من ينقذها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erlischt um Mitternacht, wenn du keine Aktion machst: %@ Flamme zu retten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes out at midnight if you make no move: %@ of Flame to save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se apaga a medianoche si no haces ningún gesto: %@ de Llama que salvar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle s’éteint à minuit si tu ne fais aucun geste : %@ de Flamme à sauver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si spegne a mezzanotte se non fai nessun gesto: %@ di Fiamma da salvare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela se apaga à meia-noite se você não fizer nenhum gesto: %@ de Chama para salvar."
          }
        }
      }
    },
    "game.guide.moment.flame_at_risk.next": {
      "extractionState": "manual",
