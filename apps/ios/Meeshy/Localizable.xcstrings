        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao a tutti 👋 Sono %1$@, parlo %2$@. Di dove siete?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oi, gente 👋 Eu sou %1$@, falo %2$@. De onde vocês são?"
          }
        }
      }
    },
    "onboarding.greeting.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا Meeshy! معكم %1$@، وصلت للتو. هل يتحدث أحد %2$@؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo Meeshy! Hier ist %1$@, gerade angekommen. Spricht jemand %2$@?"
