    "conversation.encryption.detail.activationFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التفعيل لا يمكن التراجع عنه. اختر الوضع الذي يناسب احتياجاتك في الترجمة والخصوصية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktivierung ist unumkehrbar. Wähle den Modus, der zu deinen Übersetzungs- und Datenschutzanforderungen passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activation is irreversible. Choose the mode that fits your translation and privacy needs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La activación es irreversible. Elige el modo que se ajuste a tus necesidades de traducción y privacidad."
