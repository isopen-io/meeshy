    "game.guide.moment.return_after_absence.short": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا بعودتك: ابدأ بالفصل الأول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zurück: Beginne mit dem ersten Akt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back: start with the first act."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenido de nuevo: empieza por el primer acto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon retour : commence par le premier acte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
