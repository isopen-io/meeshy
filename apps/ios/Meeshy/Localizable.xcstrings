        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta lumière compte %1$@, soit %2$@ : assez pour frapper la Meesh n° %3$@, qui en figera %4$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua luce conta %1$@, cioè %2$@: abbastanza per coniare la Meesh n. %3$@, che ne fisserà %4$@."
