    "share.links.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرابط يدعو إلى محادثة: أنت تحدد ما يمكن للضيوف فعله وحتى متى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Link lädt in eine Unterhaltung ein: Du legst fest, was Gäste tun dürfen und bis wann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link invites people into a conversation: you set what guests can do and until when."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace invita a una conversación: tú decides qué pueden hacer los invitados y hasta cuándo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien invite dans une conversation : vous fixez ce que les invités peuvent faire et jusqu’à quand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un link invita in una conversazione: stabilisci cosa possono fare gli ospiti e fino a quando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link convida para uma conversa: você define o que os convidados podem fazer e até quando."
          }
        }
      }
    },
    "conversation.encryption.note.revert.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا لو أردت العودة دون تشفير؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und wenn ich ohne Verschlüsselung zurück will?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What if I want to go back without encryption?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Y si quiero volver sin cifrado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et si je veux revenir sans chiffrement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E se voglio tornare senza cifratura?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E se eu quiser voltar sem criptografia?"
          }
        }
      }
    },
    "conversation.encryption.note.serverSays.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا لو قال الخادم عكس ذلك؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und wenn der Server etwas anderes sagt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What if the server says otherwise?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Y si el servidor dice lo contrario?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et si le serveur dit le contraire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E se il server dice il contrario?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E se o servidor disser o contrário?"
          }
        }
      }
    },
    "conversation.encryption.note.serverSays.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى لو عرضها الخادم لاحقًا بشكل مختلف، لن يكتب حسابك فيها من هذا الجهاز دون تشفير تام بين الطرفين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst wenn der Server sie später anders darstellt, schreibt dein Konto von diesem Gerät aus nie wieder ohne Ende-zu-Ende-Verschlüsselung darin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if the server later presented it otherwise, your account no longer writes in it without end-to-end encryption from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunque el servidor la presentara después de otro modo, tu cuenta ya no escribe en ella sin cifrado de extremo a extremo desde este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même si le serveur la présentait ensuite autrement, votre compte n’y écrit plus sans chiffrement de bout en bout depuis cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche se il server la presentasse poi diversamente, il tuo account non vi scrive più senza crittografia end-to-end da questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo que o servidor a apresente depois de outra forma, sua conta não escreve mais nela sem criptografia de ponta a ponta a partir deste aparelho."
          }
        }
      }
    },
    "conversation.encryption.note.hybridLayer.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
