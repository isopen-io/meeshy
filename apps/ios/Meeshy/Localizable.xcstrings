    "e2ee.devices.approve.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تعتمد إلا جهازًا يخصّك وأمامك، ولا تعتمد أبدًا رمزًا وصلك في رسالة أو عرضه عليك شخص آخر. سيتمكن من قراءة الرسائل المشفّرة التي تكتبها من هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genehmige nur ein Gerät, das dir gehört und vor dir liegt – niemals einen Code aus einer Nachricht oder von jemand anderem. Es kann die verschlüsselten Nachrichten lesen, die du von diesem schreibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only approve a device that is yours and in front of you — never a code received in a message or shown by someone else. It will be able to read the encrypted messages you write from this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba solo un dispositivo que sea tuyo y esté delante de ti, nunca un código recibido por mensaje o mostrado por otra persona. Podrá leer los mensajes cifrados que escribas desde este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’approuvez qu’un appareil qui est à vous et devant vous, jamais un code reçu par message ou montré par quelqu’un d’autre. Il pourra lire les messages chiffrés que vous écrivez depuis celui-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva solo un dispositivo tuo e davanti a te, mai un codice ricevuto per messaggio o mostrato da altri. Potrà leggere i messaggi crittografati che scrivi da questo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove apenas um dispositivo que seja seu e esteja à sua frente, nunca um código recebido por mensagem ou mostrado por outra pessoa. Ele poderá ler as mensagens criptografadas que você escreve a partir deste."
          }
        }
      }
    },
