    "talkie.info.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدمه فقط في حالات الطوارئ القصوى: يُسمع صوتك لديهم حتى لو كان Meeshy في الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur im äußersten Notfall verwenden: Deine Stimme ist bei ihnen zu hören, auch wenn Meeshy im Hintergrund ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use it only in an extreme emergency: your voice plays on their phone even when Meeshy is in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsalo solo en caso de extrema urgencia: tu voz suena en su teléfono aunque Meeshy esté en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À utiliser en cas d’extrême urgence : votre voix sort chez eux même si Meeshy est en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da usare solo in caso di estrema urgenza: la tua voce esce dal loro telefono anche se Meeshy è in background."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use apenas em caso de extrema urgência: sua voz sai no telefone delas mesmo com o Meeshy em segundo plano."
          }
        }
      }
    },
