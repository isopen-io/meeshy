    "signInLink.switchAccount.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح هذا الرابط حسابًا آخر غير %2$@: %1$@. لا تفتحه إلا إذا كان ملكك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link öffnet ein ANDERES Konto als %2$@: %1$@. Öffne es nur, wenn es dir gehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link opens an account OTHER than %2$@: %1$@. Only open it if it is yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace abre OTRA cuenta distinta de %2$@: %1$@. Ábrela solo si es tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien ouvre un AUTRE compte que %2$@ : %1$@. N'ouvrez que s'il vous appartient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo link apre un ALTRO account diverso da %2$@: %1$@. Aprilo solo se è tuo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link abre OUTRA conta, diferente de %2$@: %1$@. Só abra se for sua."
          }
        }
      }
    },
    "signInLink.switchAccount.messageUnknownCurrent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح هذا الرابط حسابًا آخر غير الحساب المفتوح: %@. لا تفتحه إلا إذا كان ملكك."
          }
