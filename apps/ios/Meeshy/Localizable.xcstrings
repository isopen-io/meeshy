            "state": "translated",
            "value": "Too many people without a connection to you today. Remove some, or try again tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas personas sin vínculo contigo hoy. Quita algunas o inténtalo de nuevo mañana."
