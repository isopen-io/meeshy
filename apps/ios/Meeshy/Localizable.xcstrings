    "game.atlas.coin.line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل Meesh مرقّمة: عملة ذهبية كل مئة، ومنشور كل ألف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Meesh ist nummeriert: alle hundert eine Goldmünze, alle tausend ein Prisma."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Meesh is numbered: a gold coin every hundred, a prism every thousand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada Meesh está numerada: una moneda de oro cada cien, un prisma cada mil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque Meesh est numérotée : une pièce d’or tous les cent, un prisme tous les mille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni Meesh è numerata: una moneta d’oro ogni cento, un prisma ogni mille."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada Meesh é numerada: uma moeda de ouro a cada cem, um prisma a cada mil."
          }
        }
      }
    },
