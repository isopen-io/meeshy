    "feed.nearby.empty.none.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا فقط المنشورات «القابلة للاكتشاف بالقرب»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheinen nur Beiträge, die „in der Nähe auffindbar“ sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only posts marked “discoverable nearby” appear here."
          }
