            "state": "translated",
            "value": "Niemand kann diesen Beitrag kommentieren. Du kannst Kommentare über sein Menü wieder aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one will be able to comment on this post. You can turn comments back on from its menu."
          }
        },
        "es": {
