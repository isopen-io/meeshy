        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un timbro per ogni lingua davvero scambiata: un messaggio inviato, uno ricevuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um carimbo por idioma realmente trocado: uma mensagem enviada, uma recebida."
          }
        }
