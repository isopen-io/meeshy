    "bring.confirm.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring مخصص للحالات الطارئة القصوى فقط. يرنّ حتى يوقفه %@، دقيقتين على الأكثر. Meeshy ليس خدمة طوارئ: عند الخطر اتصل بخدمات الطوارئ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring ist nur für extreme Notfälle. Es klingelt, bis %@ es stoppt, höchstens zwei Minuten. Meeshy ist kein Notdienst: Bei Gefahr ruf den Notruf an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring is for extreme emergencies only. It rings until %@ stops it, two minutes at most. Meeshy is not an emergency service: if you’re in danger, call emergency services."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bring es solo para urgencias extremas. Suena hasta que %@ lo detenga, dos minutos como máximo. Meeshy no es un servicio de emergencias: si hay peligro, llama a los servicios de emergencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bring est réservé aux urgences extrêmes. Il sonne jusqu’à ce que %@ l’arrête, deux minutes au plus. Meeshy n’est pas un service d’urgence : en cas de danger, appelez les secours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Bring è solo per le emergenze estreme. Squilla finché %@ non lo ferma, al massimo due minuti. Meeshy non è un servizio di emergenza: in caso di pericolo, chiama i soccorsi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bring é só para emergências extremas. Ele toca até %@ parar, no máximo dois minutos. O Meeshy não é um serviço de emergência: em caso de perigo, ligue para os serviços de emergência."
          }
        }
      }
    },
