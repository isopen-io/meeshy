    "game.atlas.flames.line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوم إضافي ويكبر لهبك: من الجمرة إلى الشمس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag mehr und Deine Flamme wächst: von der Glut bis zur Sonne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One more day and your Flame grows: from ember to sun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día más y tu Llama crece: de la brasa al sol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jour de plus et ta Flamme grandit : de la braise jusqu’au soleil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno in più e la tua Fiamma cresce: dalla brace al sole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais um dia e sua Chama cresce: da brasa ao sol."
          }
        }
      }
    },
