    "window.main.already_open.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النافذة الرئيسية مفتوحة في مكان آخر. يمكن لمحادثة أو للمقاطع أن تكون في نافذة خاصة بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptfenster ist bereits woanders geöffnet. Eine Unterhaltung oder die Reels können ein eigenes Fenster haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main window is open elsewhere. A conversation or the reels can have their own window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana principal está abierta en otro lugar. Una conversación o los reels pueden tener su propia ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre principale est ouverte ailleurs. Une conversation ou les réels peuvent, eux, avoir leur propre fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra principale è aperta altrove. Una conversazione o i reel possono avere una finestra propria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela principal está aberta em outro lugar. Uma conversa ou os reels podem ter a própria janela."
          }
        }
