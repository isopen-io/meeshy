    "game.missions.locked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند المستوى 5، يرسل إليك أجدادك كل ليلة حلمًا من ثلاثة فصول، وعطيّة. أنت في المستوى %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab Level 5 schicken dir deine Ahnen jede Nacht einen Traum in drei Akten, und eine Gabe. Du bist auf Level %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At level 5, your ancestors send you a dream in three acts each night, and an Offering. You are at level %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el nivel 5, tus ancestros te envían cada noche un sueño en tres actos, y una Ofrenda. Estás en el nivel %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au niveau 5, tes aïeux t’envoient chaque nuit un rêve en trois actes, et une Offrande. Tu es au niveau %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al livello 5, i tuoi antenati ti mandano ogni notte un sogno in tre atti, e un’Offerta. Sei al livello %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No nível 5, seus ancestrais enviam toda noite um sonho em três atos, e uma Oferenda. Você está no nível %@."
          }
        }
      }
    },
    "game.missions.prism_day": {
