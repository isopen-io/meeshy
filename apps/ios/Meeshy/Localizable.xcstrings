    "feed.nearby.empty.none.why.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون صاحب المنشور قد فعّل «قابل للاكتشاف بالقرب». المنشورات السابقة لهذا الخيار غير مدرجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Autor muss „in der Nähe auffindbar“ aktiviert haben. Beiträge von vor dieser Option sind nicht dabei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The author must have turned on “discoverable nearby”. Posts published before that option are not listed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El autor debe haber activado «localizable en las cercanías». Las publicaciones anteriores a esa opción no figuran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
