    "composer.sound.role.foreground.borrowed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل صوت المكتبة منسوبًا إلى مؤلفه: لا يمكن أن يصبح مرفقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ton aus der Bibliothek bleibt seinem Urheber zugeschrieben: Er kann kein Anhang werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A library sound stays credited to its author: it cannot become an attachment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sonido de la biblioteca sigue acreditado a su autor: no puede convertirse en un adjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un son de la bibliothèque reste crédité à son auteur : il ne peut pas devenir une pièce jointe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un suono della libreria resta accreditato al suo autore: non può diventare un allegato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um som da biblioteca continua creditado ao autor: não pode virar um anexo."
          }
        }
      }
    },
