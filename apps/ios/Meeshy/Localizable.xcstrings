    "La vérification du numéro de sécurité sera disponible une fois que les deux participants auront échangé leurs clés de chiffrement.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتاح التحقق من رقم الأمان بمجرد أن يتبادل الطرفان مفاتيح التشفير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherheitsnummer-Verifizierung wird verfügbar, sobald beide Teilnehmer ihre Verschlüsselungsschlüssel ausgetauscht haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety number verification will be available once both participants have exchanged their encryption keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación del número de seguridad estará disponible una vez que ambos participantes hayan intercambiado sus claves de cifrado."
