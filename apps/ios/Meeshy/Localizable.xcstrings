    "settings.data.storage.cache.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسرّع الذاكرة المؤقتة تحميل الوسائط وتقلّل استهلاك البيانات. تُحذف الملفات المخزّنة تلقائيًا بعد 7 أيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cache lädt Medien schneller und spart Datenvolumen. Zwischengespeicherte Dateien werden nach 7 Tagen automatisch gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cache loads media faster and reduces data usage. Cached files are deleted automatically after 7 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caché carga los archivos más rápido y reduce el consumo de datos. Los archivos en caché se eliminan automáticamente al cabo de 7 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cache permet de charger les médias plus rapidement et réduit la consommation de données. Les fichiers mis en cache sont automatiquement supprimés après 7 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cache carica i contenuti più rapidamente e riduce il consumo di dati. I file memorizzati vengono eliminati automaticamente dopo 7 giorni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cache carrega as mídias mais rápido e reduz o consumo de dados. Os arquivos em cache são apagados automaticamente após 7 dias."
          }
        }
      }
    },
