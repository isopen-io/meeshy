            "state": "translated",
            "value": "Das Erbe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Legacy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Legado"
