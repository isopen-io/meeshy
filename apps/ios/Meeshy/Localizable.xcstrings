    "feed.nearby.empty.none.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا فقط المنشورات التي فعّل صاحبها خيار «قابل للاكتشاف بالقرب». المنشورات السابقة لهذا الخيار غير مدرجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheinen nur Beiträge, deren Autor „in der Nähe auffindbar“ aktiviert hat. Beiträge von vor dieser Option sind nicht dabei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only posts whose author turned on “discoverable nearby” appear here. Posts published before that option are not listed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo aparecen las publicaciones cuyo autor activó «localizable en las cercanías». Las publicaciones anteriores a esa opción no figuran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les publications dont l'auteur a activé « trouvable à proximité » apparaissent ici. Les publications antérieures à cette option n'y figurent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui compaiono solo i post il cui autore ha attivato «individuabile nelle vicinanze». I post precedenti a questa opzione non sono inclusi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui aparecem apenas as publicações cujo autor ativou «localizável por perto». As publicações anteriores a essa opção não constam."
          }
        }
      }
    },
    "feed.nearby.empty.retry": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة المحاولة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
