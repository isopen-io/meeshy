    "game.detail.fact.flame_state": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقول إن كان لهبك مشتعلًا، أو يرتجف، أو يحرسه قنديل، أو انطفأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er sagt, ob deine Flamme brennt, flackert, von einer Hüterin bewacht wird oder erloschen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It tells whether your Flame burns, flickers, is guarded by a Vigil or has gone out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice si tu Llama arde, vacila, la guarda una Vela o se ha apagado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dit si ta Flamme brûle, vacille, est gardée par une Veilleuse ou s’est éteinte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice se la tua Fiamma arde, vacilla, è custodita da una Lucerna o si è spenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra se a sua Chama arde, vacila, está sob o cuidado de uma Lamparina ou se apagou."
          }
        }
      }
    },
    "game.detail.fact.missions_done": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاثة فصول لكل حلم. حين تتحقّق، تُظهر العطيّة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Akte pro Traum. Sind sie erfüllt, erscheint die Gabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three acts per dream. Once complete, they make the Offering appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres actos por sueño. Una vez hechos realidad, hacen aparecer la Ofrenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois actes par rêve. Une fois réalisés, ils font apparaître l’Offrande."
