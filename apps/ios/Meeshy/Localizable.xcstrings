    "onboarding.greeting.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا بالجميع 👋 أنا %1$@، أتحدث %2$@. من أين أنتم؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo zusammen 👋 Ich bin %1$@ und spreche %2$@. Woher kommt ihr?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi everyone 👋 I'm %1$@, I speak %2$@. Where are you all from?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola a todos 👋 Soy %1$@, hablo %2$@. ¿De dónde son?"
