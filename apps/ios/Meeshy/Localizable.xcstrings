        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse pedido já foi usado em outra ação — tente de novo."
          }
        }
      }
    },
    "game.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكتمل العملية — تحقّق من اتصالك وأعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nicht geklappt — prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not go through — check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ha salido bien: revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça n’a pas abouti — vérifie ta connexion et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è andata a buon fine: controlla la connessione e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deu certo — verifique sua conexão e tente de novo."
          }
