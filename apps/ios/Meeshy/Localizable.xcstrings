    "onboarding.page2.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسِل رسالة صوتية بلغتك، ويسمعها أصدقاؤك بلغتهم وبصوتك أنت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende eine Sprachnachricht auf Französisch – deine Freunde hören sie in ihrer Sprache mit deiner Stimme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a voice message in French, your friends hear it in their language with your voice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un mensaje de voz en francés y tus amigos lo escuchan en su idioma con tu voz"
