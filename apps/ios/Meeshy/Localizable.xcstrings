    "e2ee.devices.revoke.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يرسل هذا الجهاز إليه رسائلك المشفّرة بعد الآن ولن يقرأ رسائله. يمكنك اعتماده مجددًا بقراءة رمزه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät sendet ihm deine verschlüsselten Nachrichten nicht mehr und liest seine nicht mehr. Du kannst es erneut genehmigen, indem du seinen Code scannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device will no longer send it your encrypted messages or read its own. You can approve it again by scanning its code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo ya no le enviará tus mensajes cifrados ni leerá los suyos. Podrás aprobarlo de nuevo leyendo su código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil-ci ne lui enverra plus vos messages chiffrés et ne lira plus les siens. Vous pourrez l’approuver de nouveau en lisant son code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non gli invierà più i tuoi messaggi crittografati e non leggerà più i suoi. Potrai approvarlo di nuovo leggendo il suo codice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não enviará mais suas mensagens criptografadas para ele nem lerá as dele. Você poderá aprová-lo de novo lendo o código dele."
          }
        }
      }
    },
    "e2ee.devices.retire.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتلقى أي رسالة مشفّرة بعد الآن. لكي يشفّر من جديد، عليه أن يسجّل بهوية جديدة ثم يُعتمد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es erhält keine verschlüsselte Nachricht mehr. Um wieder zu verschlüsseln, muss es sich mit einer neuen Identität neu registrieren und dann genehmigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will no longer receive any encrypted message. To encrypt again, it must re-register under a new identity, then be approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no recibirá ningún mensaje cifrado. Para volver a cifrar, deberá registrarse de nuevo con una identidad nueva y luego ser aprobado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne recevra plus aucun message chiffré. Pour chiffrer de nouveau, il devra se réinscrire sous une nouvelle identité, puis être approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riceverà più alcun messaggio crittografato. Per crittografare di nuovo, dovrà registrarsi con una nuova identità e poi essere approvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele não receberá mais nenhuma mensagem criptografada. Para criptografar de novo, precisará se registrar com uma nova identidade e depois ser aprovado."
          }
        }
      }
    },
    "e2ee.devices.scanner.instruction": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه الكاميرا إلى الرمز الذي يعرضه جهازك الآخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Kamera auf den Code deines anderen Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point at the code shown by your other device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta al código que muestra tu otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visez le code montré par votre autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra il codice mostrato dall’altro dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte para o código exibido pelo seu outro dispositivo."
          }
        }
      }
    },
    "e2ee.devices.scan": {
      "extractionState": "manual",
      "localizations": {
