    "settings.transcription.auto.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل تُنسخ الرسائل الصوتية الواردة فور وصولها، وإلا فعند الطلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert, werden empfangene Sprachnachrichten sofort transkribiert, sonst auf Abruf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On, received voice messages are transcribed on arrival; otherwise, on demand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado, los audios recibidos se transcriben al llegar; si no, a petición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé, les vocaux reçus sont transcrits à leur arrivée ; sinon, à la demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo, i vocali ricevuti si trascrivono all'arrivo; altrimenti, su richiesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado, os áudios recebidos são transcritos ao chegar; senão, sob demanda."
          }
        }
      }
    },
