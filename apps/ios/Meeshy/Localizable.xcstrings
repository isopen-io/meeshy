    "conversation.encryption.detail.immutabilityFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد التفعيل، لا يمكن تعطيل التشفير في هذه المحادثة. هذا يحمي من التراجع الأمني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Aktivierung kann die Verschlüsselung für diese Unterhaltung nicht mehr deaktiviert werden. Das schützt vor Sicherheitsregressionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once enabled, encryption cannot be disabled for this conversation. This protects against security regressions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez activado, el cifrado no se puede desactivar en esta conversación. Esto protege frente a regresiones de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, le chiffrement ne peut plus être désactivé pour cette conversation. Cela protège contre les régressions de sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta attivata, la crittografia non può essere disattivata per questa conversazione. Questo protegge da regressioni di sicurezza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de ativada, a criptografia não pode ser desativada nesta conversa. Isso protege contra regressões de segurança."
          }
        }
      }
    },
