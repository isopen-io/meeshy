    "game.guide.moment.first_mint_possible.means_drop": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frapper fige %@ de ta lumière dans une pièce : ton niveau baisse d’autant, et tu gagnes +%@ de gloire."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minting binds %@ of your light into a coin: your level drops by as much, and you gain +%@ glory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuñar fija %@ de tu luz en una moneda: tu nivel baja otro tanto, y ganas +%@ de gloria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prägen bannt %@ deines Lichts in eine Münze: Dein Level sinkt um ebenso viel, und du gewinnst +%@ Ruhm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coniare fissa %@ della tua luce in una moneta: il tuo livello scende di altrettanto, e guadagni +%@ di gloria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunhar cristaliza %@ da sua luz numa moeda: seu nível baixa na mesma medida, e você ganha +%@ de glória."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السكّ يصوغ %@ من نورك في قطعة: فينخفض مستواك بقدره، وتكسب ⁦+%@⁩ من المجد."
          }
        }
      }
    },
