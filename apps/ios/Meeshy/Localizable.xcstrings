    "audio.consent.notice.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الموافقة الصوتية لتُنسَخ رسائلك الصوتية نصًّا وتُترجَم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die Sprach-Einwilligung, damit deine Sprachnachrichten transkribiert und übersetzt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable voice consent so your audio messages are transcribed and translated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el consentimiento de voz para que tus mensajes de audio sean transcritos y traducidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active le consentement vocal pour que tes messages audio soient transcrits et traduits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il consenso vocale affinché i tuoi messaggi audio siano trascritti e tradotti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o consentimento de voz para que suas mensagens de áudio sejam transcritas e traduzidas."
          }
        }
      }
    },
