    "game.fiche.mint.sentence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُثبّت ⁦%1$@⁩ من نورك، الذي يبلغ ⁦%2$@⁩."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie hält %1$@ deines Lichts fest, das %2$@ zählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It sets %1$@ of your light into the coin; your light holds %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija %1$@ de tu luz, que cuenta %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle fige %1$@ de ta lumière, qui en compte %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissa %1$@ della tua luce, che ne conta %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela fixa %1$@ da sua luz, que tem %2$@."
          }
        }
      }
    },
