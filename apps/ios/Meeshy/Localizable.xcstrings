    },
    "game.detail.seal.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خاتم الرحلة قطعة للجمع. لا يغيّر شيئًا في اللعبة."
          }
        },
        "de": {
