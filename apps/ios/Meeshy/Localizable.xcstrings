    "game.concept.showcase.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كؤوسك تحفظ أثر انتصاراتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Trophäen bewahren die Spur deiner Siege."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trophies keep the memory of your victories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus trofeos guardan la huella de tus victorias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes trophées gardent la trace de tes victoires."
