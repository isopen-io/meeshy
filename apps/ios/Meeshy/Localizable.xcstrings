    "game.detail.step.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدّم بضع خطوات بفصول حلمك وبالتحالف، ثم استلم المحطة."
          }
        },
        "de": {
          "stringUnit": {
