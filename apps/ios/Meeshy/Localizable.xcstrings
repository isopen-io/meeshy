    "call.transcript.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ النصي محلي على هذا الجهاز، ولا يُرسل أبدًا إلى خادم Meeshy — وقد يظهر في نسخة احتياطية على iCloud أو Finder لهذا الجهاز. ويشمل كلام محدّثك كما ورد أثناء المكالمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkription lokal auf diesem Gerät, niemals an den Meeshy-Server gesendet — kann in einem iCloud/Finder-Backup dieses Geräts enthalten sein. Enthält die während des Anrufs empfangenen Worte Ihres Gesprächspartners."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription local to this device, never sent to the Meeshy server — may be included in this device's iCloud/Finder backup. Includes your interlocutor's words as received during the call."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcripción local en este dispositivo, nunca enviada al servidor de Meeshy — puede incluirse en una copia de seguridad de iCloud/Finder de este dispositivo. Incluye las palabras de tu interlocutor tal como se recibieron durante la llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription locale à cet appareil, jamais envoyée au serveur Meeshy — peut figurer dans une sauvegarde iCloud/Finder de cet appareil. Inclut les paroles de votre interlocuteur, telles que reçues pendant l'appel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione locale a questo dispositivo, mai inviata al server Meeshy — può comparire in un backup iCloud/Finder di questo dispositivo. Include le parole del tuo interlocutore, così come ricevute durante la chiamata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrição local neste aparelho, nunca enviada ao servidor Meeshy — pode estar incluída em um backup iCloud/Finder deste aparelho. Inclui as palavras do seu interlocutor, conforme recebidas durante a chamada."
          }
        }
      }
    },
