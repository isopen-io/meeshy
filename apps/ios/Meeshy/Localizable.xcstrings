    },
    "game.concept.showcase.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل كأس يأخذ مكانه وحده. أنت تختار الترتيب ومن يراها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Pokal landet von selbst dort. Du bestimmst, wer sie sieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each cup lands there by itself. You choose the order and who sees it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada copa se coloca sola. Tú eliges el orden y quién la ve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque coupe s’y range toute seule. Tu choisis l’ordre et qui la voit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni coppa ci arriva da sola. Tu scegli l’ordine e chi la vede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada taça vai para lá sozinha. Você escolhe a ordem e quem a vê."
          }
        }
      }
    },
    "game.concept.showcase.tip.1": {
