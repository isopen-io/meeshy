    "onboarding.page2.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسِل رسالة صوتية بلغتك، ويسمعها أصدقاؤك بلغتهم وبصوتك أنت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende eine Sprachnachricht auf Französisch – deine Freunde hören sie in ihrer Sprache mit deiner Stimme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a voice message in French, your friends hear it in their language with your voice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un mensaje de voz en francés y tus amigos lo escuchan en su idioma con tu voz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un vocal en français, vos amis l'écoutent dans leur langue avec votre voix"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un vocale in italiano, i tuoi amici lo ascoltano nella loro lingua con la tua voce"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie um áudio em francês e seus amigos o ouvem no idioma deles com a sua voz"
          }
        }
      }
    },
