            "value": "اختر فيديو أو مقطعًا صوتيًا من محادثتكما: يشغّله %@ في الوقت نفسه معك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Video oder Audio aus eurem Chat: %@ spielt es gleichzeitig mit dir ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a video or an audio from your conversation: %@ plays it at the same time as you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un vídeo o un audio de vuestra conversación: %@ lo reproduce a la vez que tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une vidéo ou un audio de votre conversation : %@ le lit en même temps que vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un video o un audio della vostra conversazione: %@ lo riproduce insieme a te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um vídeo ou um áudio da conversa: %@ reproduz ao mesmo tempo que você."
          }
        }
      }
    },
