    },
    "bring.explain": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحالة طارئة قصوى: يرنّ هاتفه حتى وهو مقفل. قد يعرض آيفون في الوضع الصامت تنبيهًا ذا أولوية فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen extremen Notfall: Das Telefon klingelt, auch gesperrt. Ein iPhone im Lautlos-Modus zeigt je nach Einstellung nur einen dringenden Hinweis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For an extreme emergency: their phone rings, even when locked. Depending on settings, an iPhone on silent may only show a priority alert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para una urgencia extrema: su teléfono suena, incluso bloqueado. Según sus ajustes, un iPhone en silencio puede mostrar solo una alerta prioritaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une urgence extrême : son téléphone sonne, même verrouillé. Selon ses réglages, un iPhone en silencieux peut n’afficher qu’une alerte prioritaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un’emergenza estrema: il suo telefono squilla, anche bloccato. In base alle impostazioni, un iPhone in silenzioso può mostrare solo un avviso prioritario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para uma emergência extrema: o telefone dela toca, mesmo bloqueado. Conforme os ajustes, um iPhone no silencioso pode mostrar só um alerta prioritário."
          }
        }
      }
    },
