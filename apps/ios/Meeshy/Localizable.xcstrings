    "game2.guide.moment.season_end.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغت المحطة ⁦%@⁩ من 40. لم يضع شيء: مستواك ورتبتك كما هما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist bis zur Rast %@ von 40 gekommen. Nichts geht verloren: Dein Level und dein Rang bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You went as far as stop %@ of 40. Nothing is lost: your level and your rank don’t move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegaste hasta la parada %@ de 40. No se pierde nada: tu nivel y tu rango no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es allé jusqu’à la halte %@ sur 40. Rien n’est perdu : ton niveau et ton rang ne bougent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei arrivato fino alla sosta %@ su 40. Non si perde nulla: il tuo livello e il tuo rango non cambiano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você chegou até a parada %@ de 40. Nada se perde: seu nível e seu título não mudam."
          }
        }
      }
    },
    "game2.guide.moment.season_end.means_done": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تربح كأس الرحلة، ووسامًا مؤرّخًا، و%@ من المجد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
