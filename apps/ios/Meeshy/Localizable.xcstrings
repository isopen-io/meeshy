            "value": "رسائل هذه المحادثة مشفّرة من طرف إلى طرف. لا أحد، ولا حتى Meeshy، يستطيع قراءتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten in dieser Unterhaltung sind Ende-zu-Ende-verschlüsselt. Niemand, nicht einmal Meeshy, kann sie lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages in this conversation are end-to-end encrypted. No one, not even Meeshy, can read them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes de esta conversación están cifrados de extremo a extremo. Nadie, ni siquiera Meeshy, puede leerlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages dans cette conversation sont chiffrés de bout en bout. Personne, pas même Meeshy, ne peut les lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi di questa conversazione sono crittografati end-to-end. Nessuno, nemmeno Meeshy, può leggerli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens desta conversa são criptografadas de ponta a ponta. Ninguém, nem mesmo o Meeshy, pode lê-las."
          }
        }
      }
    },
