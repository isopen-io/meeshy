    "call.control.video.paused.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لإيقاف الكاميرا. سيُستأنف الفيديو تلقائيًا إذا تحسّن الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, um die Kamera auszuschalten. Das Video wird automatisch fortgesetzt, wenn sich die Verbindung verbessert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to turn off the camera. Video resumes automatically if the connection improves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para apagar la cámara. El vídeo se reanuda automáticamente si mejora la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour éteindre la caméra. La vidéo reprend automatiquement si la connexion s'améliore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per spegnere la fotocamera. Il video riprende automaticamente se la connessione migliora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para desligar a câmera. O vídeo é retomado automaticamente se a conexão melhorar."
          }
        }
      }
    },
