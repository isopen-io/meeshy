          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a few strides with the acts of your dream and the alliance, then claim the stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza unos pasos con los actos de tu sueño y la alianza, y luego reclama la parada."
