    "settings.media.outgoing.location.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتراضيًا، يُزال موقع GPS من كل صورة قبل إرسالها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig wird die GPS-Position vor dem Senden aus jedem Foto entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, the GPS position is removed from every photo before it is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, la posición GPS se elimina de cada foto antes de enviarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, la position GPS est retirée de chaque photo avant l'envoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostazione predefinita, la posizione GPS viene rimossa da ogni foto prima dell'invio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, a posição GPS é removida de cada foto antes do envio."
          }
        }
      }
    },
