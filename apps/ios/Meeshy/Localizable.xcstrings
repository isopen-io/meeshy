    "share.sheet.encryption.warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» غير مشفّرة: ستخرج هذه الرسالة هناك من التشفير التام بين الطرفين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht verschlüsselt: Dort verlässt diese Nachricht die Ende-zu-Ende-Verschlüsselung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” isn’t encrypted: this message will leave end-to-end encryption there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no está cifrada: allí este mensaje saldrá del cifrado de extremo a extremo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas chiffrée : ce message y sortira du chiffrement de bout en bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» non è cifrata: lì questo messaggio uscirà dalla crittografia end-to-end."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não é criptografada: lá esta mensagem sairá da criptografia de ponta a ponta."
          }
        }
      }
    },
    "share.refused.encrypted-destination": {
