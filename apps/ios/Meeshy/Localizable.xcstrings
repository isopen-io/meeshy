    "settings.media.autosave.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنضم الصور ومقاطع الفيديو المستلمة إلى ألبوم Meeshy مرة واحدة. لا تُحفظ أبدًا الوسائط المؤقتة أو الضبابية أو ذات العرض الواحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfangene Bilder und Videos landen einmalig im Meeshy-Album. Nie ein flüchtiges, verschwommenes oder Einmal-Medium."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received images and videos join the Meeshy album, once. Never an ephemeral, blurred or view-once media."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes y vídeos recibidos se guardan en el álbum Meeshy, una sola vez. Nunca un contenido efímero, difuminado o de visualización única."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images et vidéos reçues rejoignent l'album Meeshy, une seule fois. Jamais un média éphémère, flouté ou à vue unique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini e i video ricevuti finiscono nell'album Meeshy, una sola volta. Mai un contenuto effimero, sfocato o visualizzabile una volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens e vídeos recebidos vão para o álbum Meeshy, uma única vez. Nunca uma mídia efêmera, desfocada ou de visualização única."
          }
        }
      }
    },
