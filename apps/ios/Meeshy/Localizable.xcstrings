    "feed.nearby.empty.unavailable.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على الخادم الاستجابة. الأمر لا يتعلق بنطاق بحثك — أعد المحاولة بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server konnte nicht antworten. Es liegt nicht an deinem Suchradius – versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not answer. This is not about your search radius — try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no pudo responder. No es por tu radio de búsqueda: inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas pu répondre. Ce n'est pas votre rayon de recherche — réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non ha potuto rispondere. Non dipende dal tuo raggio di ricerca: riprova tra un istante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não conseguiu responder. Não é o seu raio de busca — tente novamente em instantes."
          }
        }
      }
    },
