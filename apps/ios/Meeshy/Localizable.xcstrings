    "message.translation.e2ee.serverRefused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشفّرة تمامًا بين الطرفين: تُترجم على جهازك، وليس عبر الخادم أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende-zu-Ende-verschlüsselt: auf deinem Gerät übersetzt, nie vom Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted: translated on your device, never by the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrada de extremo a extremo: traducida en tu dispositivo, nunca por el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffrée de bout en bout : traduite sur votre appareil, jamais par le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crittografata end-to-end: tradotta sul tuo dispositivo, mai dal server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografada de ponta a ponta: traduzida no seu aparelho, nunca pelo servidor."
          }
        }
      }
    },
