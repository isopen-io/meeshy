    "game2.guide.moment.league_relegated.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخمسة الأخيرون في كل مبارزة يهبطون. لا بأس: تبدأ الشرارات من الصفر ولا ينخفض شيء آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten 5 jedes Turniers steigen ab. Nicht schlimm: Die Funken beginnen wieder bei null, und sonst sinkt nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bottom 5 of each joust go back down. No big deal: the sparks start again from zero and nothing else goes down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 5 últimos de cada justa bajan. No pasa nada: las chispas vuelven a cero y nada más baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 5 derniers de chaque joute redescendent. Ce n’est pas grave : les étincelles repartent de zéro et rien d’autre ne baisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ultimi 5 di ogni torneo riscendono. Non è grave: le scintille ripartono da zero e nient’altro cala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os 5 últimos de cada torneio voltam a descer. Não é grave: as faíscas recomeçam do zero e nada mais baixa."
          }
        }
      }
    },
    "game2.guide.moment.league_relegated.what": {
