        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will have to sign in again to access your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tendrá que volver a iniciar sesión para acceder a tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devra se reconnecter pour accéder à votre compte."
