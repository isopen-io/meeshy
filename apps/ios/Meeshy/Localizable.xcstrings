    "onboarding.age.refused.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الانضمام إلينا عند بلوغك 13 عامًا. سيتم تسجيل خروجك الآن."
          }
        },
        "de": {
