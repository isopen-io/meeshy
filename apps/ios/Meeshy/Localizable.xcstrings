    },
    "forward.duration.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختفي النسخة في موعد أقصاه مدة الرسالة الأصلية، ولا يمكن إعادة توجيهها مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie verschwindet spätestens nach der Dauer der ursprünglichen Nachricht und kann nicht erneut weitergeleitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy disappears no later than the original message's duration, and can't be forwarded again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia desaparece como máximo tras la duración del mensaje original y no podrá reenviarse de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie disparaît au plus tard après la durée du message d’origine, et ne pourra pas être transférée à son tour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia scompare al più tardi dopo la durata del messaggio originale e non potrà essere inoltrata di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia desaparece no máximo após a duração da mensagem original e não poderá ser encaminhada novamente."
          }
        }
      }
    },
    "forward.duration.title": {
      "extractionState": "manual",
