    "settings.privacy.online_status.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إيقافها لا يرى أحد النقطة. تظل الكتابة دليلًا على نشاطك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviert sieht niemand den Punkt. Schreiben verrät deine Aktivität trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned off, nobody sees the dot. Typing still shows you're active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, nadie ve el punto. Escribir sigue mostrando tu actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivée, personne ne voit ce point. Écrire reste une preuve d'activité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato, nessuno vede il punto. Scrivere mostra comunque la tua attività."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, ninguém vê o ponto. Escrever ainda mostra sua atividade."
          }
        }
      }
    },
