          "stringUnit": {
            "state": "translated",
            "value": "Os Bring dela não vão mais chegar até você. Essa pessoa não é avisada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تصلك نداءات Bring منه بعد الآن. لن يتم إعلام هذا الشخص."
