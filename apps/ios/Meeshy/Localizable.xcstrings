    "game.detail.fact.streak": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا عدد الأيام المتتالية التي اشتعل فيها لهبك: إجراء واحد على الأقل كل يوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So viele Tage am Stück hat deine Flamme gebrannt: mindestens eine Aktion an jedem Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how many days in a row your Flame has burned: at least one move every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el número de días seguidos en que tu Llama ha ardido: al menos un gesto cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le nombre de jours d’affilée où ta Flamme a brûlé : au moins un geste chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il numero di giorni di fila in cui la tua Fiamma ha arso: almeno un gesto ogni giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o número de dias seguidos em que sua Chama ardeu: pelo menos um gesto por dia."
          }
        }
      }
    },
    "game.detail.fact.streak_record": {
      "extractionState": "manual",
