    "game.atlas.tiers.line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عشرون حالة، من الشرارة إلى التفرد: تتغيّر حلقتك مع كل حالة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwanzig Gestalten, vom Funken bis zur Singularität: Dein Ring ändert sich mit jeder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twenty phases, from Spark to Singularity: your ring changes with each one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Veinte estados, de la Chispa a la Singularidad: tu anillo cambia en cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vingt états, de l’Étincelle à la Singularité : ton anneau change à chacun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Venti stati, dalla Scintilla alla Singolarità: il tuo anello cambia a ognuno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinte estados, da Faísca à Singularidade: seu anel muda a cada um."
          }
        }
      }
    },
