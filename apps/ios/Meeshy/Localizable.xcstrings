    "circles.settings.blockTalkie.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُسمع صوته مباشرةً على جهازك بعد الآن: سيصلك كرسالة صوتية. لن يتم إعلام هذا الشخص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimme wird nicht mehr direkt bei dir abgespielt, sondern kommt als Sprachnachricht an. Die Person wird nicht benachrichtigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their voice will no longer play directly on your device: it will arrive as a voice message. They are not notified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su voz ya no sonará directamente en tu dispositivo: llegará como mensaje de voz. Esta persona no recibe ningún aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa voix ne sortira plus directement chez vous : elle arrivera en message vocal. Cette personne n’en est pas prévenue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua voce non verrà più riprodotta direttamente sul tuo dispositivo: arriverà come messaggio vocale. Questa persona non viene avvisata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz dela não vai mais tocar diretamente no seu aparelho: chegará como mensagem de voz. Essa pessoa não é avisada."
          }
        }
      }
    },
