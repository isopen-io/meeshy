            "value": "No aparelho"
          }
        }
      }
    },
    "e2ee.devices.code.digits.a11y": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرقام الرمز: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziffern des Codes: %@"
          }
        },
        "en": {
