      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد منشورات لاكتشافها ضمن %lld كم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Beitrag im Umkreis von %lld km."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No post to discover within %lld km."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna publicación para descubrir en un radio de %lld km."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune publication à découvrir dans un rayon de %lld km."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun post da scoprire entro %lld km."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma publicação para descobrir num raio de %lld km."
          }
        }
      }
    },
