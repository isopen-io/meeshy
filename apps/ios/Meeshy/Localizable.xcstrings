    "e2ee.devices.step.show.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحصول على اعتماد «%@»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von „%@“ genehmigen lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get approved by “%@”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacerme aprobar por «%@»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Me faire approuver par « %@ »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatti approvare da «%@»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser aprovado por “%@”"
          }
        }
      }
    },
    "e2ee.devices.step.show.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على «%@»، المس «قراءة رمزه» أمام هذا الجهاز واقرأ الرمز أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „%@“ bei diesem Gerät auf „Seinen Code scannen“ und scanne den Code unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On “%@”, tap “Scan its code” next to this device and scan the code below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «%@», toca «Leer su código» junto a este dispositivo y lee el código de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur « %@ », touchez « Lire son code » face à cet appareil et lisez le code ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su «%@», tocca «Leggi il suo codice» accanto a questo dispositivo e leggi il codice qui sotto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em “%@”, toque em “Ler o código dele” ao lado deste dispositivo e leia o código abaixo."
          }
        }
      }
    },
