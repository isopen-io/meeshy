    "post.daily_limit.comment": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغتَ حدّ التعليقات — شراراتك لا تتغيّر. يُستأنف عند الساعة %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommentarlimit erreicht – deine Funken bleiben unberührt. Weiter ab %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment limit reached — your sparks are untouched. Resumes at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de comentarios alcanzado: tus chispas no se tocan. Se reanuda a las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de commentaires atteinte — vos étincelles ne bougent pas. Reprise à %@."
