    "e2ee.devices.notice.noMatch.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز ليس لأي من أجهزتك. لم تتم الموافقة على شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code gehört keinem deiner Geräte. Es wurde nichts genehmigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code belongs to none of your devices. Nothing was approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código no es de ninguno de tus dispositivos. No se aprobó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code n’est celui d’aucun de vos appareils. Rien n’a été approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice non è di nessuno dei tuoi dispositivi. Nulla è stato approvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código não é de nenhum dos seus dispositivos. Nada foi aprovado."
          }
        }
      }
    },
    "e2ee.devices.notice.approved.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن لم تفعل بعد، اقرأ أيضًا رمز هذا الجهاز من الجهاز الآخر: ستصبح رسائلك المشفّرة مقروءة على الجهازين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls noch nicht geschehen, scanne auch den Code dieses Geräts mit dem anderen: Dann sind deine verschlüsselten Nachrichten auf beiden lesbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you haven’t yet, also scan this device’s code from the other one: your encrypted messages will then be readable on both."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aún no lo has hecho, lee también el código de este dispositivo desde el otro: tus mensajes cifrados se leerán entonces en ambos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ce n’est pas déjà fait, lisez aussi le code de cet appareil depuis l’autre : vos messages chiffrés se liront alors sur les deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non l’hai già fatto, leggi anche il codice di questo dispositivo dall’altro: i tuoi messaggi crittografati saranno leggibili su entrambi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ainda não fez, leia também o código deste dispositivo a partir do outro: suas mensagens criptografadas poderão ser lidas nos dois."
          }
        }
      }
    },
    "e2ee.devices.notice.deviceChanged.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت القائمة. لم تتم إزالة شيء: تحقّق منها أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste hat sich geändert. Es wurde nichts entfernt – prüfe sie zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list has changed. Nothing was removed: check it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista ha cambiado. No se eliminó nada: revísala primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste a changé. Rien n’a été retiré : vérifiez-la d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elenco è cambiato. Non è stato rimosso nulla: controllalo prima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista mudou. Nada foi removido: verifique-a antes."
          }
        }
      }
    },
    "e2ee.devices.notice.deviceChanged.title": {
      "extractionState": "manual",
