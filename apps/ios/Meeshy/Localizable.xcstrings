    "security.verify.unavailable.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتوفر التحقق من رقم الأمان بعد تبادل الطرفين مفاتيح التشفير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Überprüfung der Sicherheitsnummer ist verfügbar, sobald beide Teilnehmer ihre Schlüssel ausgetauscht haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety number verification will be available once both participants have exchanged their encryption keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación del número de seguridad estará disponible cuando ambos participantes hayan intercambiado sus claves de cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification du numéro de sécurité sera disponible une fois que les deux participants auront échangé leurs clés de chiffrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La verifica del numero di sicurezza sarà disponibile quando entrambi i partecipanti avranno scambiato le chiavi di crittografia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação do número de segurança ficará disponível quando ambos os participantes trocarem suas chaves de criptografia."
          }
        }
      }
    },
