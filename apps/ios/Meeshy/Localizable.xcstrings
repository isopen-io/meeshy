    "starred.messages.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطوّلًا على رسالة واختر «إضافة إلى المفضّلة» لتجدها هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine Nachricht gedrückt und wähle „Zu Favoriten hinzufügen“, um sie hier wiederzufinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold a message and choose \\\"Add to favourites\\\" to find it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un mensaje y elige «Añadir a favoritos» para encontrarlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur un message et choisissez \\\"Ajouter aux favoris\\\" pour le retrouver ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un messaggio e scegli «Aggiungi ai preferiti» per ritrovarlo qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha uma mensagem pressionada e escolha “Adicionar aos favoritos” para encontrá-la aqui."
          }
        }
      }
    },
