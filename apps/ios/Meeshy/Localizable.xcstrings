            "state": "translated",
            "value": "Comece pelo ato mais fácil."
          }
        }
      }
    },
    "game.concept.missions.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعجبك فصل؟ بدّله، مرة واحدة في اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Akt gefällt dir nicht? Tausche ihn, einmal pro Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t like an act? Change it, once a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No te gusta un acto? Cámbialo, una vez al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acte ne te plaît pas ? Change-le, une fois par jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atto non ti piace? Cambialo, una volta al giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não gostou de um ato? Troque-o, uma vez por dia."
          }
        }
      }
    },
    "game.concept.league.name": {
