    },
    "circles.level.friend.opens": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta présence « en ligne », sans l'heure, et le Bring."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your “online” presence, without the time, and Bring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu presencia «en línea», sin la hora, y el Bring."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua presença “online”, sem o horário, e o Bring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Präsenz „online“, ohne Uhrzeit, und Bring."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua presenza «online», senza l’orario, e il Bring."
          }
