    "game.concept.elans.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزخم يضاعف شرارات إجراءاتك القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schwung vervielfacht die Funken deiner nächsten Aktionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentum multiplies the sparks of your next actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un impulso multiplica las chispas de tus próximos gestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élan multiplie les étincelles de tes prochains gestes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno slancio moltiplica le scintille dei tuoi prossimi gesti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um impulso multiplica as faíscas dos seus próximos gestos."
          }
        }
      }
    },
    "game.concept.elans.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإجراءات من عدة فئات في هذه الأيام لتفعيله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach in diesen Tagen Aktionen aus mehreren Familien, um ihn auszulösen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do actions from several families these days to trigger it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz gestos de varias familias estos días para activarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais des gestes de plusieurs familles ces jours-ci pour le déclencher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai gesti di più famiglie in questi giorni per attivarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça gestos de várias famílias nestes dias para ativá-lo."
          }
        }
      }
    },
    "game.concept.elans.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نوّع إجراءاتك: اكتب، انشر، علّق، تفاعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle ab: schreiben, posten, kommentieren, reagieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mix it up: write, post, comment, react."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varía tus gestos: escribe, publica, comenta, reacciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varie tes gestes : écris, publie, commente, réagis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Varia i tuoi gesti: scrivi, pubblica, commenta, reagisci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Varie seus gestos: escreva, publique, comente, reaja."
          }
        }
      }
    },
    "game.concept.elans.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُد عدة أيام متتالية لتحافظ عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm mehrere Tage in Folge wieder, um ihn zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back several days in a row to keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve varios días seguidos para mantenerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviens plusieurs jours de suite pour le garder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna più giorni di fila per mantenerlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte vários dias seguidos para mantê-lo."
          }
        }
      }
    },
