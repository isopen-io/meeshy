    "game2.settings.league.off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت لست في المبارزة العامة. تبقى مبارزة أصدقائك مفتوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht im öffentlichen Turnier. Dein Turnier der Freunde bleibt offen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not in the public joust. Your Friends’ Joust stays open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No estás en la justa pública. Tu Justa de los amigos sigue abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n’es pas dans la joute publique. Ta Joute des amis reste ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sei nel torneo pubblico. Il tuo Torneo degli amici resta aperto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não está no torneio público. Seu Torneio dos amigos continua aberto."
          }
        }
      }
    },
