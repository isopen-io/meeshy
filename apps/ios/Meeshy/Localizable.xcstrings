    "game.concept.badges.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوسام يُظهر أكثر ما تفعله على Meeshy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Medaille zeigt, was du auf Meeshy am meisten tust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A medal shows what you do most on Meeshy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una medalla muestra lo que más practicas en Meeshy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une médaille montre ce que tu pratiques le plus sur Meeshy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una medaglia mostra ciò che fai di più su Meeshy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma medalha mostra o que você mais pratica no Meeshy."
          }
        }
      }
    },
    "game.concept.badges.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرّر إجراءً: يتغيّر معدن وسامه، من النحاس إلى المنشور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole die Aktion: Die Medaille wird von Kupfer bis Prisma veredelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat a move: its medal changes material, from copper to prism."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite un gesto: su medalla cambia de material, del cobre al prisma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répète un geste : sa médaille change de matière, du cuivre au prisme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti un gesto: la sua medaglia cambia materia, dal rame al prisma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita um gesto: a medalha dele muda de material, do cobre ao prisma."
          }
        }
      }
    },
    "game.concept.badges.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر إجراءً تحبه وكرّره كثيرًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such dir eine Aktion aus, die du magst, und mach sie oft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick an action you like and do it often."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un gesto que te guste y repítelo a menudo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un geste que tu aimes et refais-le souvent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un gesto che ti piace e ripetilo spesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um gesto de que você gosta e repita-o sempre."
          }
        }
      }
    },
    "game.concept.badges.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوسام المنطفئ يشتعل من جديد: لا شيء يضيع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erloschene Medaille entzündet sich neu: Nichts geht verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A medal that went out lights up again: nothing is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una medalla apagada se vuelve a encender: nada se pierde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une médaille éteinte se rallume : rien n’est perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una medaglia spenta si riaccende: niente è perduto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma medalha apagada volta a acender: nada se perde."
          }
        }
      }
    },
    "game.concept.defis.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحديات"
          }
        },
        "de": {
