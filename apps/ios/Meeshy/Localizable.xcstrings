    "game2.guide.moment.league_promoted.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهيت في المركز %1$@ من مبارزة %2$@: السبعة الأوائل يرتقون إلى الحلقة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das %2$@-Turnier auf Platz %1$@ beendet: Die ersten 7 steigen in den nächsten Kreis auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You finished in place %1$@ of the %2$@ joust: the top 7 climb to the next circle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminaste en el puesto %1$@ de la justa %2$@: los 7 primeros suben al círculo siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as fini à la place %1$@ de la joute %2$@ : les 7 premiers gravissent le cercle suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai finito al posto %1$@ del torneo di %2$@: i primi 7 salgono al cerchio successivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você terminou em %1$@º lugar no torneio %2$@: os 7 primeiros sobem para o círculo seguinte."
          }
        }
      }
    },
