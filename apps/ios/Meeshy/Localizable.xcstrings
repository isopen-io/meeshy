    "e2ee.devices.step.read.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعتماد «%@» على هذا الجهاز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
