    "talkie.send.explain": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز لاسلكي للطوارئ لأقرب الناس إليك: اضغط مطولًا وتحدّث، يخرج صوتك لدى %@ دون الحاجة إلى الرد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notfall-Walkie-Talkie für deine Allernächsten: Gedrückt halten und sprechen, deine Stimme ist bei %@ ohne Abheben zu hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency walkie-talkie, for your closest people: hold and talk, your voice plays on %@’s side without them picking up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkie-talkie de urgencia, para tus más cercanos: mantén pulsado y habla, tu voz suena en el lado de %@ sin descolgar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkie d’urgence, pour vos très proches : maintenez et parlez, votre voix sort chez %@ sans décrocher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkie-talkie d’emergenza, per i tuoi più vicini: tieni premuto e parla, la tua voce esce da %@ senza rispondere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkie-talkie de emergência, para seus mais próximos: segure e fale, sua voz sai do lado de %@ sem atender."
          }
        }
      }
    },
