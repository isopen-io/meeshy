    "game.state.points.missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نورك يضمّ %1$@، أي %2$@. ستصوغ Meesh رقم %3$@ منه %4$@: ينقصك %5$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Licht zählt %1$@, also %2$@. Meesh Nr. %3$@ wird %4$@ davon bannen: Es fehlen %5$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light holds %1$@, that is %2$@. Meesh no. %3$@ will bind %4$@ of it: %5$@ still to come."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu luz tiene %1$@, es decir, %2$@. La Meesh n.º %3$@ fijará %4$@: faltan %5$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta lumière compte %1$@, soit %2$@. La Meesh n° %3$@ en figera %4$@ : il manque %5$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua luce conta %1$@, cioè %2$@. La Meesh n. %3$@ ne fisserà %4$@: mancano %5$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua luz tem %1$@, ou seja, %2$@. A Meesh n.º %3$@ vai cristalizar %4$@: faltam %5$@."
          }
        }
      }
    },
    "game.state.points.ready": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نورك يضمّ %1$@، أي %2$@: ما يكفي لسكّ Meesh رقم %3$@، التي ستصوغ منه %4$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Licht zählt %1$@, also %2$@: genug, um Meesh Nr. %3$@ zu prägen, die %4$@ davon bannen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light holds %1$@, that is %2$@: enough to mint Meesh no. %3$@, which will bind %4$@ of it."
