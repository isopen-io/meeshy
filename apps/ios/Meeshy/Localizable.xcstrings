      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحتاج %@ إلى تسجيل الدخول مجددًا للوصول إلى حسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss sich erneut anmelden, um auf dein Konto zuzugreifen."
          }
