    "game.frappe.refused.shadow": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ظلّ يحجب نورك. شراراتك القادمة ستبدّده، ثم نسكّ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schatten verhüllt dein Licht. Deine nächsten Funken vertreiben ihn, dann prägen wir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shadow veils your light. Your next sparks will clear it, and we’ll mint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sombra cubre tu luz. Tus próximas chispas la disiparán, y acuñaremos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ombre voile ta lumière. Tes prochaines étincelles la dissiperont, et on frappera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’ombra vela la tua luce. Le tue prossime scintille la dissiperanno, e conieremo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sombra cobre sua luz. Suas próximas faíscas vão dissipá-la, e a gente cunha."
          }
        }
      }
    },
    "game.frappe.refused.locked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرثك ينتظر رتبة أعلى. مجدك سيفتحه، ثم نسكّ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Erbe wartet auf einen höheren Rang. Dein Ruhm öffnet es, dann prägen wir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Legacy is waiting for a higher rank. Your glory will open it, and we’ll mint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Legado espera un rango más alto. Tu gloria lo abrirá, y acuñaremos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton Héritage attend un rang plus haut. Ta gloire l’ouvrira, et on frappera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua Eredità attende un rango più alto. La tua gloria la aprirà, e conieremo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua Herança espera um título mais alto. Sua glória vai abri-la, e a gente cunha."
          }
        }
      }
    },
    "game.frappe.refused.light": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نورك لا يكفي بعد. شراراتك القادمة ستغذّيه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Licht reicht noch nicht. Deine nächsten Funken nähren es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light isn’t enough yet. Your next sparks will feed it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu luz aún no alcanza. Tus próximas chispas la alimentarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta lumière ne suffit pas encore. Tes prochaines étincelles la nourriront."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua luce non basta ancora. Le tue prossime scintille la nutriranno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua luz ainda não basta. Suas próximas faíscas vão alimentá-la."
          }
        }
      }
    },
    "game.frappe.refused.offline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا اتصال الآن. حين يعود، نسكّ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade keine Verbindung. Sobald sie zurück ist, prägen wir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection right now. As soon as it’s back, we mint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión por ahora. En cuanto vuelva, acuñamos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion pour l’instant. Dès qu’elle revient, on frappe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione per ora. Appena torna, coniamo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão por enquanto. Assim que ela voltar, a gente cunha."
          }
        }
      }
    },
    "game.frappe.refused.unknown": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمّ السكّ. لا شيء ضاع: نورك سليم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Prägen hat nicht stattgefunden. Nichts ist verloren: Dein Licht ist unversehrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mint didn’t happen. Nothing is lost: your light is whole."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acuñación no se hizo. No se pierde nada: tu luz está intacta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La frappe n’a pas eu lieu. Rien n’est perdu : ta lumière est intacte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conio non è avvenuto. Non si perde nulla: la tua luce è intatta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cunhagem não aconteceu. Nada se perde: sua luz está intacta."
          }
        }
      }
    },
