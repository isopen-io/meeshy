            "state": "translated",
            "value": "Sua luz cresce: primeiro nível alcançado."
          }
        }
      }
    },
    "game.guide.moment.first_level.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شراراتك تغذّي نورك: حين تمتلئ الحلقة، يبلغ مستوى جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Funken nähren dein Licht: Ist der Ring voll, gewinnt es ein Level."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sparks feed your light: when the ring is full, it gains a level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chispas alimentan tu luz: cuando el anillo está lleno, gana un nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes étincelles nourrissent ta lumière : quand l’anneau est plein, elle gagne un niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scintille nutrono la tua luce: quando l’anello è pieno, guadagna un livello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas faíscas alimentam a sua luz: quando o anel fica cheio, ela ganha um nível."
          }
        }
      }
    },
    "game.guide.moment.first_level.next": {
