    "circles.ritual.consent.locationHistory.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنه مراجعة تنقلاتي خلال آخر 30 يومًا، ويمكنني مسحها متى شئت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person kann meine Wege der letzten 30 Tage ansehen; ich kann sie jederzeit löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They can review my movements of the last 30 days; I can erase them whenever I want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede revisar mis desplazamientos de los últimos 30 días; puedo borrarlos cuando quiera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peut revoir mes déplacements des 30 derniers jours ; je peux les effacer quand je veux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può rivedere i miei spostamenti degli ultimi 30 giorni; posso cancellarli quando voglio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode rever meus deslocamentos dos últimos 30 dias; posso apagá-los quando quiser."
          }
        }
      }
    },
