      }
    },
    "game.detail.fact.mint_next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل Meesh تحمل رقمها. واحدة من كل مئة ذهبية، وواحدة من كل ألف من المنشور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Meesh trägt ihre Nummer. Jede hundertste ist aus Gold, jede tausendste aus Prisma."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each Meesh carries its number. One in a hundred is gold, one in a thousand prism."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada Meesh lleva su número. Una de cada cien es de oro, una de cada mil de prisma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque Meesh porte son numéro. Une sur cent est en or, une sur mille en prisme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni Meesh porta il suo numero. Una su cento è d’oro, una su mille di prisma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada Meesh tem o seu número. Uma em cem é de ouro, uma em mil de prisma."
          }
        }
      }
    },
    "game.detail.fact.mint_glory": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل سكّ يُنمّي مجدك بهذا القدر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Prägung lässt deinen Ruhm um so viel wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each mint makes your glory grow by this much."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada acuñación hace crecer tu gloria otro tanto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque frappe fait grandir ta gloire d’autant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni conio fa crescere la tua gloria di altrettanto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cunhagem faz a sua glória crescer nessa medida."
          }
