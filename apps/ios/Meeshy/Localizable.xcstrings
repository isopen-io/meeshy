        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, Meeshy! Aqui é %1$@, acabei de chegar. Alguém fala %2$@?"
          }
        }
      }
    },
    "onboarding.greeting.3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أهلًا! أنا %1$@. أكتب باللغة %2$@ وأنتم تقرؤونني بلغتكم 🌍"
          }
