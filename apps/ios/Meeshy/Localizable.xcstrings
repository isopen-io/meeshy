    "share.sheet.withheld.flame.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا يحدث لنسخة الشعلة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was passiert mit der Kopie einer Flamme?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happens to a flame’s copy?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué pasa con la copia de una llama?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que devient la copie d’une flamme ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che fine fa la copia di una fiamma?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
