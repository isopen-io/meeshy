    "settings.media.opening.library.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر صورك في منتصف الشاشة، والكاميرا مرئية خلفها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos erscheinen auf halber Höhe, die Kamera bleibt dahinter sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos appear halfway up, with the camera visible behind them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos aparecen a media altura, con la cámara visible detrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos s'ouvrent à mi-hauteur, la caméra visible derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue foto appaiono a metà altezza, con la fotocamera visibile dietro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fotos aparecem na metade da tela, com a câmera visível atrás."
          }
        }
      }
    },
