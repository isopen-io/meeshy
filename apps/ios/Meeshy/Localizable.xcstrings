            "value": "Auf dem Gerät"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’appareil"
          }
        },
        "it": {
          "stringUnit": {
