    "feed.nearby.consent.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يفهرس البحث القريب أبدًا موقعًا أدق من المنطقة المختارة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umkreissuche indexiert nie einen genaueren Standort als den gewählten Bereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby search never indexes a location more precise than the area you pick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda cercana nunca indexa una ubicación más precisa que la zona elegida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche à proximité n'indexe jamais une position plus précise que la zone choisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca nelle vicinanze non indicizza mai una posizione più precisa dell'area scelta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca por proximidade nunca indexa uma localização mais precisa que a área escolhida."
          }
        }
      }
    },
    "feed.nearby.consent.subtitle": {
      "extractionState": "manual",
      "localizations": {
