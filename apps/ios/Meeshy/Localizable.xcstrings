        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد بإمكان هذا الإصدار من Meeshy الاتصال بالخادم. ثبّت أحدث إصدار للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Meeshy-Version kann nicht mehr mit dem Server kommunizieren. Installiere die neueste Version, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Meeshy can no longer talk to the server. Install the latest version to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de Meeshy ya no puede comunicarse con el servidor. Instala la última versión para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
