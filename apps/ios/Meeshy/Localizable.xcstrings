    "game.atlas.leagues.line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل أسبوع تدخل مبارزتك: يرتقي السبعة الأوائل إلى الحلقة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Woche trittst du in dein Turnier: Die ersten sieben steigen in den nächsten Kreis auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every week, you enter your joust: the top seven climb to the next circle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada semana entras en tu justa: los siete primeros suben al círculo siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque semaine, tu entres dans ta joute : les sept premiers gravissent le cercle suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni settimana entri nel tuo torneo: i primi sette salgono al cerchio successivo."
