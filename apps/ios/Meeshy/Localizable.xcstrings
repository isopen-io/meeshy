    "game.guide.moment.level_100.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستوى 100: يمكن لنورك أن ينبعث!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Level 100: Dein Licht kann wiedergeboren werden!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level 100: your light can be reborn!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivel 100: ¡tu luz puede renacer!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau 100 : ta lumière peut renaître !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Livello 100: la tua luce può rinascere!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nível 100: sua luz pode renascer!"
          }
        }
      }
    },
    "game.guide.moment.level_100.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالانبعاث، يعود نورك شرارةً وتدخل أسطورتك عصرًا جديدًا، مع كأس من أجدادك. والانبعاث اختياري."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Wiedergeburt wird dein Licht wieder zum Funken, und deine Legende tritt in ein neues Zeitalter, mit einer Trophäe deiner Ahnen. Die Wiedergeburt ist freiwillig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you are reborn, your light becomes a Spark again and your legend enters a new Age, with a trophy from your ancestors. Rebirth is optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al renacer, tu luz vuelve a ser Chispa y tu leyenda entra en una nueva Edad, con un trofeo de tus ancestros. El renacimiento es opcional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En renaissant, ta lumière redevient Étincelle et ta légende entre dans un nouvel Âge, avec un trophée de tes aïeux. La renaissance est facultative."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinascendo, la tua luce torna Scintilla e la tua leggenda entra in una nuova Era, con un trofeo dei tuoi antenati. La rinascita è facoltativa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao renascer, sua luz volta a ser Faísca e sua lenda entra numa nova Era, com um troféu dos seus ancestrais. O renascimento é opcional."
          }
        }
      }
    },
    "game.guide.moment.level_100.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انبعث، أو دع نورك ينمو أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werde wiedergeboren, oder lass dein Licht weiter wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be reborn, or let your light keep growing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renace, o deja que tu luz crezca todavía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renais, ou laisse ta lumière grandir encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinasci, oppure lascia crescere ancora la tua luce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renasça, ou deixe sua luz crescer mais."
          }
        }
      }
    },
    "game.guide.moment.level_100.next_stay": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دع نورك ينمو ما شئت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dein Licht wachsen, so lange du willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let your light grow as much as you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que tu luz crezca tanto como quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse ta lumière grandir autant que tu veux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia crescere la tua luce quanto vuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe sua luz crescer o quanto você quiser."
          }
        }
      }
    },
    "game.guide.moment.level_100.short": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانبعاث ينفتح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergeburt öffnet sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebirth is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Renacimiento se abre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Renaissance s’ouvre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Rinascita si apre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Renascimento se abre."
          }
        }
      }
    },
    "game.guide.step.welcome.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا، أنا مي! مع ميو سنشرح لك اللعبة في سبع بطاقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo, ich bin Mee! Mit Meo erklären wir dir das Spiel in sieben Karten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I am Mee! With Meo, we will explain the game in seven cards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hola, soy Mee! Con Meo te explicamos el juego en siete tarjetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salut, c’est Mee ! Avec Meo, on t’explique le jeu en sept cartes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao, sono Mee! Con Meo ti spieghiamo il gioco in sette carte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oi, eu sou a Mee! Com o Meo, explicamos o jogo em sete cartões."
          }
        }
      }
    },
    "game.guide.step.welcome.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل إجراء مفيد يمنحك شرارات: الكتابة، والكلام، والنشر، والتفاعل، والدعوة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede nützliche Aktion bringt Funken: schreiben, sprechen, veröffentlichen, reagieren, einladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every useful action earns sparks: writing, talking, publishing, reacting, inviting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada gesto útil da chispas: escribir, hablar, publicar, reaccionar, invitar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque geste utile rapporte des étincelles : écrire, parler, publier, réagir, inviter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni gesto utile fa guadagnare scintille: scrivere, parlare, pubblicare, reagire, invitare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ação útil rende faíscas: escrever, falar, publicar, reagir, convidar."
          }
        }
      }
    },
    "game.guide.step.welcome.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بأول إجراء: أنا أترقّب شراراتك الأولى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach deine erste Aktion: Ich halte Ausschau nach deinen ersten Funken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make your first move: I’m watching for your first sparks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz tu primer gesto: yo vigilo tus primeras chispas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais ton premier geste : je guette tes premières étincelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai il tuo primo gesto: aspetto le tue prime scintille."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça seu primeiro gesto: estou de olho nas suas primeiras faíscas."
          }
        }
      }
    },
    "game.guide.step.first_points.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحسنت، هذه أولى شراراتك!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bravo, deine ersten Funken!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Well done, your first sparks!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bravo, tus primeras chispas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bravo, tes premières étincelles !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bravo, le tue prime scintille!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parabéns, suas primeiras faíscas!"
          }
        }
      }
    },
    "game.guide.step.first_points.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شراراتك تصنع نورك: إنها تملأ حلقتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Funken bilden dein Licht: Sie füllen deinen Ring."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sparks form your light: they fill your ring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chispas forman tu luz: llenan tu anillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes étincelles forment ta lumière : elles remplissent ton anneau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scintille formano la tua luce: riempiono il tuo anello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas faíscas formam a sua luz: elas enchem o seu anel."
          }
        }
      }
    },
    "game.guide.step.first_points.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد حلقتك وهي تمتلئ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh zu, wie sich dein Ring füllt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch your ring fill up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cómo se llena tu anillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde ton anneau se remplir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda il tuo anello riempirsi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o seu anel se encher."
          }
        }
      }
    },
    "game.guide.step.levels.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عشرون حالة لنورك، ومستويات تفتحها رتبتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwanzig Gestalten deines Lichts, und Level, die dein Rang öffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twenty phases of your light, and levels your rank opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Veinte estados de tu luz, y niveles que tu rango abre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vingt états de ta lumière, et des niveaux que ton rang ouvre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Venti stati della tua luce, e livelli che il tuo rango apre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinte estados da sua luz, e níveis que seu título abre."
          }
        }
      }
    },
    "game.guide.step.levels.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلّب كل مستوى شرارات أكثر قليلًا من الذي قبله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Level verlangt etwas mehr Funken als das vorherige."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each level asks for a few more sparks than the one before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nivel pide un poco más de chispas que el anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque niveau demande un peu plus d’étincelles que le précédent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni livello richiede un po’ più di scintille del precedente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nível pede um pouco mais de faíscas do que o anterior."
          }
        }
      }
    },
    "game.guide.step.levels.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند المستوى 5، يرسل إليك أجدادك حلمك الأول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab Level 5 schicken dir deine Ahnen deinen ersten Traum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At level 5, your ancestors send you your first dream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el nivel 5, tus ancestros te envían tu primer sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au niveau 5, tes aïeux t’envoient ton premier rêve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al livello 5, i tuoi antenati ti mandano il tuo primo sogno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No nível 5, seus ancestrais enviam o seu primeiro sonho."
          }
        }
      }
    },
    "game.guide.step.missions.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ليلة، حلم من ثلاثة فصول، وعطيّة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Nacht ein Traum in drei Akten, und eine Gabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each night, a dream in three acts, and an Offering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada noche, un sueño en tres actos, y una Ofrenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque nuit, un rêve en trois actes, et une Offrande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni notte, un sogno in tre atti, e un’Offerta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda noite, um sonho em três atos, e uma Oferenda."
          }
        }
      }
    },
    "game.guide.step.missions.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقّقها لتظهر العطيّة ولتغذّي لهبك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfülle sie, damit die Gabe erscheint und deine Flamme genährt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete them to make the Offering appear and to feed your Flame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazlos realidad para que aparezca la Ofrenda y alimentar tu Llama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réalise-les pour faire apparaître l’Offrande et nourrir ta Flamme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compili per far apparire l’Offerta e nutrire la tua Fiamma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Realize-os para fazer aparecer a Oferenda e alimentar a sua Chama."
          }
        }
      }
    },
    "game.guide.step.missions.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكبر اللهب ما دمت تعود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Flamme wächst, solange du wiederkommst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Flame grows as long as you come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Llama crece mientras vuelvas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une Flamme grandit tant que tu reviens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Fiamma cresce finché torni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma Chama cresce enquanto você voltar."
          }
        }
      }
    },
    "game.guide.step.flame.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكبر لهبك كل يوم تتحرّك فيه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Flamme wächst an jedem Tag, an dem du aktiv bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Flame grows every day you act."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Llama crece cada día que actúas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Flamme grandit chaque jour où tu agis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua Fiamma cresce ogni giorno in cui agisci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua Chama cresce a cada dia em que você age."
          }
        }
      }
    },
    "game.guide.step.flame.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل يوم من اللهب يضيف ⁦2 %%⁩ من الشرارات إلى أحلامك، حتى ⁦50 %%⁩. والقنديل يُبقيه مشتعلًا يوم غيابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Tag deiner Flamme schenkt deinen Träumen 2 %% mehr Funken, bis zu 50 %%. Eine Hüterin hält sie einen Tag deiner Abwesenheit am Brennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each day of Flame adds 2 %% sparks to your dreams, up to 50 %%. A Vigil keeps it lit for one day away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día de Llama añade un 2 %% de chispas a tus sueños, hasta un 50 %%. Una Vela la mantiene encendida un día de ausencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour de Flamme ajoute 2 %% d’étincelles à tes rêves, jusqu’à 50 %%. Une Veilleuse la garde allumée un jour d’absence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno di Fiamma aggiunge il 2 %% di scintille ai tuoi sogni, fino al 50 %%. Una Lucerna la tiene accesa per un giorno di assenza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dia de Chama soma 2%% de faíscas aos seus sonhos, até 50%%. Uma Lamparina a mantém acesa num dia de ausência."
          }
        }
      }
    },
    "game.guide.step.flame.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن تتحوّل شراراتك إلى Meesh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Funken können zu Meeshes werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sparks can become Meeshes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chispas pueden convertirse en Meeshes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes étincelles peuvent devenir des Meeshes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scintille possono diventare Meesh."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas faíscas podem virar Meeshes."
          }
        }
      }
    },
    "game.guide.step.mint.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين يكبر نورك بما يكفي، نسكّ Meesh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist dein Licht groß genug, prägt man eine Meesh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your light has grown enough, you can mint a Meesh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando tu luz es lo bastante grande, se acuña una Meesh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand ta lumière est assez grande, on frappe une Meesh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la tua luce è abbastanza grande, si conia una Meesh."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sua luz está grande o bastante, cunha-se uma Meesh."
          }
        }
      }
    },
    "game.guide.step.mint.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السكّ يصوغ جزءًا من نورك في القطعة: فينخفض مستواك بقدره، ولا تنخفض رتبتك أبدًا، وكل سكّ يمنحك مجدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prägen bannt einen Teil deines Lichts in die Münze: Dein Level sinkt um ebenso viel, dein Rang nie, und jede Prägung bringt dir Ruhm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minting binds part of your light into the coin: your level drops by as much, your rank never does, and every mint brings you glory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuñar fija una parte de tu luz en la moneda: tu nivel baja otro tanto, tu rango nunca, y cada acuñación te trae gloria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frapper fige une part de ta lumière dans la pièce : ton niveau baisse d’autant, ton rang jamais, et chaque frappe t’apporte de la gloire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coniare fissa una parte della tua luce nella moneta: il tuo livello scende di altrettanto, il tuo rango mai, e ogni conio ti porta gloria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunhar cristaliza uma parte da sua luz na moeda: seu nível baixa na mesma medida, seu título nunca, e cada cunhagem traz glória."
          }
        }
      }
    },
    "game.guide.step.mint.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجدك يمنحك اسمك: رتبتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ruhm gibt dir deinen Namen: deinen Rang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your glory gives you your name: your rank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu gloria te da tu nombre: tu rango."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta gloire te donne ton nom : ton rang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua gloria ti dà il tuo nome: il tuo rango."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua glória dá o seu nome: o seu título."
          }
        }
      }
    },
    "game.guide.step.rank.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتبتك لا تنخفض أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Rang sinkt nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rank never drops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rango nunca baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton rang ne baisse jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo rango non scende mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu título nunca baixa."
          }
        }
      }
    },
    "game.guide.step.rank.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السكّ، وتحقيق أحلامك، وتحقيق المآثر: كلها تُنمّي مجدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prägen, deine Träume erfüllen, Heldentaten vollbringen: Alles lässt deinen Ruhm wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minting, fulfilling your dreams, performing great deeds: everything makes your glory grow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuñar, hacer realidad tus sueños, lograr hazañas: todo hace crecer tu gloria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frapper, réaliser tes rêves, accomplir des hauts faits : tout fait grandir ta gloire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coniare, compiere i tuoi sogni, realizzare imprese: tutto fa crescere la tua gloria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunhar, realizar seus sonhos, cumprir façanhas: tudo faz a sua glória crescer."
          }
        }
      }
    },
    "game.guide.step.rank.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لنخلّد بدايتك بصورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten wir deinen Start in einem Foto fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let us capture your start in a photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inmortalicemos tu inicio con una foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Immortalisons ton départ en photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immortaliamo la tua partenza con una foto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos eternizar a sua largada com uma foto."
          }
        }
      }
    },
    "game.rules.1.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل إجراء يُطلق شرارات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Aktion lässt Funken sprühen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every move makes sparks fly"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada gesto hace brotar chispas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque geste fait jaillir des étincelles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni gesto fa scaturire scintille"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada gesto faz saltar faíscas"
          }
        }
      }
    },
    "game.rules.1.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتابة والكلام والنشر والتفاعل والدعوة: كل تبادل حقيقي يُطلق شرارات. ويُطلق المنشور شراراته بحسب من يستطيع رؤيته: العامة أو المجتمع أو الأصدقاء. الحدود تخصّ إجراءاتك، لا شراراتك أبدًا: الزخم واللهب والفعاليات تُطلق المزيد منها مع كل إجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben, sprechen, veröffentlichen, reagieren, einladen: Jeder echte Austausch lässt Funken sprühen. Ein Beitrag lässt sie sprühen, je nachdem, wer ihn sehen kann: öffentlich, Community oder Freunde. Die Limits gelten für deine Aktionen, nie für deine Funken: Schwung, Flamme und Events lassen bei jeder Aktion mehr davon sprühen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing, talking, posting, reacting, inviting: every real exchange makes sparks fly. A post makes them fly according to who can see it: public, community or friends. The limits apply to your moves, never to your sparks: momentum, the Flame and events make more fly with each move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir, hablar, publicar, reaccionar, invitar: cada intercambio de verdad hace brotar chispas. Una publicación las hace brotar según quién puede verla: público, comunidad o amigos. Los límites se aplican a tus gestos, nunca a tus chispas: los impulsos, la Llama y los eventos hacen brotar más en cada gesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrire, parler, publier, réagir, inviter : chaque vrai échange fait jaillir des étincelles. Une publication en fait jaillir selon qui peut la voir : public, communauté ou amis. Les limites portent sur tes gestes, jamais sur tes étincelles : élans, Flamme et événements en font jaillir plus à chaque geste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivere, parlare, pubblicare, reagire, invitare: ogni vero scambio fa scaturire scintille. Una pubblicazione ne fa scaturire secondo chi può vederla: pubblico, community o amici. I limiti riguardano i tuoi gesti, mai le tue scintille: slanci, Fiamma ed eventi ne fanno scaturire di più a ogni gesto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrever, falar, publicar, reagir, convidar: cada troca de verdade faz saltar faíscas. Uma publicação faz saltar faíscas conforme quem pode vê-la: público, comunidade ou amigos. Os limites valem para os seus gestos, nunca para as suas faíscas: impulsos, Chama e eventos fazem saltar mais a cada gesto."
          }
        }
      }
    },
    "game.rules.2.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشرارات تصنع نورك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Funken bilden dein Licht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparks form your light"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las chispas forman tu luz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étincelles forment ta lumière"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scintille formano la tua luce"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As faíscas formam a sua luz"
          }
        }
      }
    },
    "game.rules.2.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شراراتك معًا تصنع نورك، ومنه يُقرأ مستواك: مليون شرارة للمستوى 100. السكّ يصوغ جزءًا منه فينخفض مستواك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammen bilden deine Funken dein Licht, und dein Level ergibt sich daraus: eine Million Funken für Level 100. Eine Prägung bannt einen Teil davon und lässt das Level sinken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Together, your sparks form your light, and your level is read from it: a million sparks for level 100. A mint binds part of it, so it lowers your level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juntas, tus chispas forman tu luz, y tu nivel se lee en ella: un millón de chispas para el nivel 100. Acuñar fija una parte, así que lo hace bajar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensemble, tes étincelles forment ta lumière, et ton niveau se lit sur elle : un million d’étincelles pour le niveau 100. Une frappe en fige une part, donc le fait baisser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Insieme, le tue scintille formano la tua luce, e il tuo livello si legge su di lei: un milione di scintille per il livello 100. Un conio ne fissa una parte, quindi lo fa scendere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Juntas, suas faíscas formam a sua luz, e o seu nível se lê nela: um milhão de faíscas para o nível 100. Uma cunhagem cristaliza uma parte dela, então o faz baixar."
          }
        }
      }
    },
    "game.rules.3.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسكّ Meesh"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Man prägt Meeshes"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We mint Meeshes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acuñan Meeshes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On frappe des Meeshes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si coniano Meesh"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunham-se Meeshes"
          }
        }
      }
    },
    "game.rules.3.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُسكّ Meesh يدويًا: يُصاغ فيها جزء من نورك. ويتبع هذا الجزء رقم القطعة ومستواك الحالي: أصغر حين يكون مستواك منخفضًا، وكاملًا ابتداءً من المستوى 100. ويكبر بمقدار ⁦30%⁩ كل عشر مرات سكّ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Meesh prägst du von Hand: Ein Teil deines Lichts wird darin gebannt. Dieser Teil hängt von der Nummer der Münze und von deinem aktuellen Level ab: kleiner bei niedrigem Level, ganz ab Level 100. Alle zehn Prägungen wächst er um 30 %."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Meesh is minted by hand: part of your light is bound into it. That part depends on the coin’s number and on your current level: smaller when your level is low, whole from level 100. It grows by 30 % every ten mints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Meesh se acuña a mano: una parte de tu luz se fija en ella. Esa parte depende del número de la pieza y de tu nivel actual: más pequeña con un nivel bajo, entera desde el nivel 100. Crece un 30 % cada diez acuñaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une Meesh se frappe à la main : une part de ta lumière s’y fige. Cette part dépend du numéro de la pièce et de ton niveau actuel : plus petite quand ton niveau est bas, entière dès le niveau 100. Elle grandit de 30 % toutes les dix frappes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Meesh si conia a mano: una parte della tua luce vi si fissa. Questa parte dipende dal numero della moneta e dal tuo livello attuale: più piccola quando il tuo livello è basso, intera dal livello 100. Cresce del 30 % ogni dieci coni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma Meesh se cunha à mão: uma parte da sua luz se cristaliza nela. Essa parte depende do número da moeda e do seu nível atual: menor quando o seu nível é baixo, inteira a partir do nível 100. Ela cresce 30% a cada dez cunhagens."
          }
        }
      }
    },
    "game.rules.4.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السكّ يصوغ من نورك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prägen bannt dein Licht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minting binds your light"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuñar fija tu luz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frapper fige ta lumière"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coniare fissa la tua luce"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunhar cristaliza a sua luz"
          }
        }
      }
    },
    "game.rules.4.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجزء المصوغ يخرج من نورك، ومنه وحده: فينخفض مستواك بقدره. أما رتبتك وأوسمتك فلا تنخفض. وما تلقّيته يبقى لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gebannte Teil verlässt dein Licht, und nur dieses: Dein Level sinkt um ebenso viel. Dein Rang und deine Medaillen sinken nicht. Was du empfangen hast, bleibt empfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bound part leaves your light, and only that part: your level drops by as much. Your rank and your medals don’t drop. What you received stays received."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte fijada sale de tu luz, y solo de ella: tu nivel baja otro tanto. Tu rango y tus medallas no bajan. Lo recibido sigue recibido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La part figée quitte ta lumière, et seulement elle : ton niveau baisse d’autant. Ton rang et tes médailles ne baissent pas. Ce que tu as reçu reste reçu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte fissata lascia la tua luce, e solo lei: il tuo livello scende di altrettanto. Il tuo rango e le tue medaglie non scendono. Ciò che hai ricevuto resta ricevuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parte cristalizada sai da sua luz, e só ela: seu nível baixa na mesma medida. Seu título e suas medalhas não baixam. O que você recebeu continua recebido."
          }
        }
      }
    },
    "game.rules.5.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرتبة لا تتراجع أبدًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rang weicht nie zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rank never goes back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rango nunca retrocede"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rang ne recule jamais"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rango non arretra mai"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título nunca recua"
          }
        }
      }
    },
    "game.rules.5.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل سكّ، وكل مستوى تبلغه لأول مرة، وكل مأثرة، يُنمّي مجدك. والمجد يمنحك رتبتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Prägung, jedes zum ersten Mal erreichte Level, jede Heldentat lässt deinen Ruhm wachsen. Der Ruhm gibt dir deinen Rang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every mint, every level reached for the first time, every great deed makes your glory grow. Glory gives you your rank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada acuñación, cada nivel alcanzado por primera vez, cada hazaña hace crecer tu gloria. La gloria te da tu rango."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque frappe, chaque niveau atteint pour la première fois, chaque haut fait fait grandir ta gloire. La gloire te donne ton rang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni conio, ogni livello raggiunto per la prima volta, ogni impresa fa crescere la tua gloria. La gloria ti dà il tuo rango."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cunhagem, cada nível alcançado pela primeira vez, cada façanha faz a sua glória crescer. A glória dá o seu título."
          }
        }
      }
    },
    "game.rules.6.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإرث يُحفَظ أو يُنفَق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erbe wird bewahrt oder ausgegeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Legacy is kept or spent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Legado se guarda o se gasta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Héritage se garde ou se dépense"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Eredità si custodisce o si spende"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Herança se guarda ou se gasta"
          }
        }
      }
    },
    "game.rules.6.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتفاظ بعملات Meesh يُنمّي الإرث، من الكيس إلى الاحتياطي. وإنفاقها يسهر على اللهب أو يمنحك زينات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer seine Meeshes behält, lässt das Erbe wachsen, von der Börse bis zur Reserve. Wer sie ausgibt, wacht über die Flamme oder bekommt Schmuck."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping your Meeshes makes your legacy grow, from the Purse to the Reserve. Spending them watches over the Flame or offers adornments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar tus Meeshes hace crecer el legado, del Monedero a la Reserva. Gastarlas vela por la Llama u ofrece adornos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder ses Meeshes fait grandir l’héritage, de la Bourse à la Réserve. Les dépenser veille sur la Flamme ou offre des parures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Custodire le proprie Meesh fa crescere l’eredità, dalla Borsa alla Riserva. Spenderle veglia sulla Fiamma od offre ornamenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar as suas Meeshes faz a herança crescer, da Bolsa à Reserva. Gastá-las cuida da Chama ou oferece adornos."
          }
        }
      }
    },
    "game.rules.7.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل يوم يُحتسب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Tag zählt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every day counts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour compte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno conta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dia conta"
          }
        }
      }
    },
    "game.rules.7.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلم من ثلاثة فصول كل ليلة، وعطيّة، ولهب يكبر ما دمت تعود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Nacht ein Traum in drei Akten, eine Gabe, eine Flamme, die wächst, solange du wiederkommst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dream in three acts each night, an Offering, a Flame that grows as long as you come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sueño en tres actos cada noche, una Ofrenda, una Llama que crece mientras vuelvas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rêve en trois actes chaque nuit, une Offrande, une Flamme qui grandit tant qu’on revient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sogno in tre atti ogni notte, un’Offerta, una Fiamma che cresce finché si torna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um sonho em três atos toda noite, uma Oferenda, uma Chama que cresce enquanto você volta."
          }
        }
      }
    },
    "game.rules.8.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجداد يتجلّون"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ahnen zeigen sich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ancestors send signs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ancestros se manifiestan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aïeux se manifestent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli antenati si manifestano"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ancestrais se manifestam"
          }
        }
      }
    },
    "game.rules.8.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع كل ارتقاء، يتجلّى أجدادك: وكل علامة تُخلَّد في صورة مع مي وميو في سيرتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jeder Entwicklung zeigen sich deine Ahnen: Jedes Zeichen wird mit Mee und Meo als Foto in deiner Chronik verewigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At each evolution, your ancestors send you a sign: each sign is immortalized in a photo with Mee and Meo in your Chronicle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con cada evolución, tus ancestros se manifiestan: cada señal se inmortaliza en foto con Mee y Meo en tu Crónica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À chaque évolution, tes aïeux se manifestent : chaque signe s’immortalise en photo avec Mee et Meo dans ta Chronique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A ogni evoluzione, i tuoi antenati si manifestano: ogni segno si immortala in foto con Mee e Meo nella tua Cronaca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada evolução, seus ancestrais se manifestam: cada sinal fica eternizado numa foto com Mee e Meo na sua Crônica."
          }
        }
      }
    },
