    "story.sentinel.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لإصدار التطبيق لديك عرضها بعد. لم تُفقد: ستظهر تمامًا كما أنشأها صاحبها بعد التحديث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Version der App kann sie noch nicht darstellen. Sie ist nicht verloren: Nach dem Update erscheint sie genau so, wie ihr Autor sie gestaltet hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your version of the app can't paint it yet. It isn't lost: it will appear exactly as its author composed it once you update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu versión de la aplicación aún no sabe pintarla. No se ha perdido: se mostrará tal y como la compuso su autor después de la actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre version de l'application ne sait pas encore la peindre. Elle n'est pas perdue : elle s'affichera telle que son auteur l'a composée après la mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua versione dell'app non sa ancora disegnarla. Non è persa: dopo l'aggiornamento apparirà esattamente come l'ha composta il suo autore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua versão do aplicativo ainda não sabe desenhá-la. Ela não está perdida: será exibida exatamente como seu autor a compôs após a atualização."
          }
        }
      }
    },
