    "game.guide.moment.first_level.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نورك ينمو: اجتزت المستوى الأول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Licht wächst: Das erste Level ist geschafft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light grows: first level crossed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu luz crece: primer nivel cruzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta lumière grandit : premier niveau franchi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
