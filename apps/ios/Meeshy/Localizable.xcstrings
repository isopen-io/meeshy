            "state": "translated",
            "value": "«%@» sarà nascosta per te. Gli altri partecipanti la conservano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” será ocultada para você. Os outros participantes a mantêm."
          }
        }
