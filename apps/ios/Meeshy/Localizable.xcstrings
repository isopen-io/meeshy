        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يترجم الاستنساخ الصوتي رسائلك الصوتية بصوتك أنت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmklonen übersetzt Ihre Audionachrichten mit Ihrer eigenen Stimme"
          }
        },
        "en": {
