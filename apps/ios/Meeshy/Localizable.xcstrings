    "game.flame_panel.relight_missing_window": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إعادة إشعاله خلال 48 ساعة من انطفائه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu entzünden ist in den 48 h nach dem Erlöschen möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relighting is possible within 48 h of it going out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puede volver a encender en las 48 h siguientes a que se apague."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rallumage possible dans les 48 h qui suivent l’extinction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi riaccenderla nelle 48 ore successive allo spegnimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá para reacender nas 48 h seguintes ao apagamento."
          }
        }
      }
    },
    "game.flame_panel.relight_closed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إعادة إشعال هذا اللهب بعد الآن. يبدأ لهب جديد مع إجرائك التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Flamme kann nicht mehr neu entzündet werden. Eine neue Flamme beginnt mit deiner nächsten Aktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Flame can no longer be relit. A new Flame starts with your next action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Llama ya no se puede volver a encender. Una nueva Llama empieza con tu próximo gesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette Flamme ne peut plus être rallumée. Une nouvelle Flamme commence dès ton prochain geste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa Fiamma non può più essere riaccesa. Una nuova Fiamma inizia con il tuo prossimo gesto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Chama não pode mais ser reacendida. Uma nova Chama começa com a sua próxima ação."
          }
        }
      }
    },
