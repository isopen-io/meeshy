    "conversation.obsolete.refused_pending_request": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إلا لمستلم الطلب جعلها متقادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Empfänger der Anfrage kann sie als veraltet markieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the recipient of the request can make it obsolete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el destinatario de la solicitud puede volverla obsoleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le destinataire de la demande peut la rendre obsolète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo il destinatario della richiesta può renderla obsoleta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o destinatário da solicitação pode torná-la obsoleta."
          }
        }
      }
    },
    "conversation.obsoleted.notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبحت هذه المحادثة متقادمة: مُحي محتواها لدى الجميع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung wurde als veraltet markiert: Ihr Inhalt wurde für alle gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation was made obsolete: its content was erased for everyone."
          }
        },
        "es": {
