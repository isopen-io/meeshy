    "share.sheet.withheld.encrypted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُنشَر الرسالة المشفّرة. تُعاد توجيهها وتُنسَخ وتُحفَظ على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
