    "game.atlas.tiers.prestige": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُتاح الانبعاث عند المستوى %@: وهو اختياري، ويمكن لنورك أن يواصل النمو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergeburt öffnet sich ab Level %@: Sie ist freiwillig, dein Licht kann auch weiter wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebirth opens at level %@: it’s optional, your light can also keep growing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El renacimiento se ofrece en el nivel %@: es opcional, tu luz también puede seguir creciendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La renaissance s’offre au niveau %@ : elle est facultative, ta lumière peut aussi grandir encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rinascita si offre al livello %@: è facoltativa, la tua luce può anche continuare a crescere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O renascimento se oferece no nível %@: é opcional, sua luz também pode continuar crescendo."
          }
        }
      }
    },
    "game.atlas.tiers.glory": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجد العبور الأول: %@ لكل مستوى حتى %@، ثم %@ كل عشرة مستويات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhm beim ersten Erreichen: %@ pro Level bis %@, danach %@ alle zehn Level."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First-pass glory: %@ per level up to %@, then %@ every ten levels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La gloria del primer paso: %@ por nivel hasta el %@, luego %@ cada diez niveles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La gloire du premier passage : %@ par niveau jusqu’au %@, puis %@ tous les dix niveaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La gloria del primo passaggio: %@ per livello fino al %@, poi %@ ogni dieci livelli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A glória da primeira passagem: %@ por nível até o %@, depois %@ a cada dez níveis."
          }
        }
      }
    },
