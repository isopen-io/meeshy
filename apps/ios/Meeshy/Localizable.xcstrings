    "share.sheet.withheld.flame.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختفي نسختها أيضًا ولا يُعاد توجيهها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Kopie verschwindet ebenfalls und wird nicht erneut weitergeleitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its copy disappears too and can’t be forwarded again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su copia también desaparece y no se vuelve a reenviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa copie disparaît aussi et ne se retransfère pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche la sua copia scompare e non si inoltra di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua cópia também desaparece e não é encaminhada de novo."
          }
        }
      }
    },
    "circles.intro": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes liens, classés par proximité : plus le cercle est proche, plus la personne voit de toi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your links, sorted by closeness: the closer the circle, the more that person sees of you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus vínculos, ordenados por cercanía: cuanto más cerca el círculo, más ve de ti esa persona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus vínculos, ordenados por proximidade: quanto mais próximo o círculo, mais a pessoa vê de você."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Verbindungen, nach Nähe geordnet: Je näher der Kreis, desto mehr sieht die Person von dir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi legami, ordinati per vicinanza: più il cerchio è vicino, più la persona vede di te."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "روابطك مرتّبة حسب القرب: كلما اقتربت الدائرة، رأى الشخص منك أكثر."
          }
        }
      }
    },
    "circles.level.blood.opens": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Présence, talkie, écoute avec titre et position en direct, selon ton accord."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence, talkie, listening with title and live location, if you agree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presencia, talkie, escucha con título y ubicación en directo, si lo permites."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Presença, talkie, o que você ouve com título e localização ao vivo, se permitir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Präsenz, Talkie, Hören samt Titel und Live-Standort, wenn du zustimmst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Presenza, talkie, ascolto con titolo e posizione in diretta, se acconsenti."
          }
