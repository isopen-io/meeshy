    "call.transcript.disclaimer.endToEnd": {
      "comment": "Mention du journal d'après l'appel dans une conversation chiffrée de bout en bout : rien ne quitte l'appareil (#17864).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ النصي محفوظ على هذا الجهاز فقط: لا يغادر شيء محادثة مشفّرة من طرف إلى طرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkription nur auf diesem Gerät gespeichert: Aus einer Ende-zu-Ende-verschlüsselten Unterhaltung verlässt nichts das Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript kept on this device only: nothing leaves an end-to-end encrypted conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcripción guardada solo en este dispositivo: nada sale de una conversación cifrada de extremo a extremo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription gardée sur cet appareil seulement : rien ne quitte une conversation chiffrée de bout en bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione conservata solo su questo dispositivo: nulla esce da una conversazione cifrata end-to-end."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrição guardada somente neste dispositivo: nada sai de uma conversa com criptografia de ponta a ponta."
          }
        }
      }
    },
    "call.transcript.disclaimer.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين توجد هذه النسخة النصية؟"
          }
        },
        "de": {
