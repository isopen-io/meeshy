    "game2.league.consent.withdraw_info": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك سحب موافقتك في أي وقت بلمسة واحدة، هنا أو من الإعدادات. تُحذف بيانات مبارزتك بعد 4 أسابيع كحدٍّ أقصى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst deine Einwilligung jederzeit mit einer Berührung zurückziehen, hier oder in den Einstellungen. Deine Turnierdaten werden spätestens 4 Wochen danach gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can withdraw your consent at any time with one tap, here or in settings. Your joust data is deleted within 4 weeks at the latest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes retirar tu consentimiento en cualquier momento con un gesto, aquí o en los ajustes. Tus datos de justa se eliminan como máximo 4 semanas después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux retirer ton accord à tout moment, d’un geste, ici ou dans les réglages. Tes données de joute sont supprimées au plus tard 4 semaines après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi ritirare il consenso in qualsiasi momento, con un gesto, qui o nelle impostazioni. I tuoi dati di torneo vengono eliminati al più tardi 4 settimane dopo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode retirar o seu acordo a qualquer momento, com um gesto, aqui ou nos ajustes. Seus dados de torneio são apagados no máximo 4 semanas depois."
          }
        }
      }
    },
    "game2.league.consent.risk": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطر يجب أن تعرفه: من يوم إلى آخر، يُظهر مجموعك أنك لعبت في ذلك اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Risiko, das du kennen solltest: Von einem Tag zum nächsten zeigt dein Gesamtstand, dass du an diesem Tag gespielt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A risk to be aware of: from one day to the next, your total shows that you played that day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un riesgo que debes conocer: de un día a otro, tu total muestra que jugaste ese día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un risque à connaître : d’un jour à l’autre, ton total montre que tu as joué ce jour-là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rischio da conoscere: da un giorno all’altro, il tuo totale mostra che hai giocato quel giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um risco a conhecer: de um dia para o outro, seu total mostra que você jogou naquele dia."
          }
        }
      }
    },
    "game2.league.consent.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف يُحدَّد مكانك: بحسب الشرارات التي تُطلقها إجراءاتك، مع أبطال بنشاط متقارب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie du eingeteilt wirst: nach den Funken, die deine Aktionen sprühen lassen, mit Helden von ähnlicher Aktivität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How you’re placed: by the sparks your moves make fly, alongside heroes of similar activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo te colocamos: según las chispas que brotan de tus gestos, con héroes de actividad parecida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment on te place : selon les étincelles qui jaillissent de tes gestes, avec des héros d’activité semblable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come vieni piazzato: in base alle scintille che scaturiscono dai tuoi gesti, con eroi di attività simile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como você é colocado: pelas faíscas que saltam dos seus gestos, com heróis de atividade parecida."
          }
        }
      }
    },
    "game2.league.consent.who": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من يراه: حتى 29 بطلًا آخر في مبارزتك لا تعرفهم. لا اسم ولا صورة ولا لغة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer es sieht: bis zu 29 weitere Helden deines Turniers, die du nicht kennst. Kein Name, kein Foto, keine Sprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who sees it: up to 29 other heroes in your joust, whom you don’t know. No name, no photo, no language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién lo ve: hasta 29 héroes más de tu justa, que no conoces. Ningún nombre, ninguna foto, ningún idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui le voit : jusqu’à 29 autres héros de ta joute, que tu ne connais pas. Aucun nom, aucune photo, aucune langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi lo vede: fino a 29 altri eroi del tuo torneo, che non conosci. Nessun nome, nessuna foto, nessuna lingua."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem vê: até 29 outros heróis do seu torneio, que você não conhece. Nenhum nome, nenhuma foto, nenhum idioma."
          }
        }
      }
    },
    "game2.league.consent.shown": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يراه الآخرون: اسمك في المبارزة، ومبارزتك، ومجموع شرارات أسبوعك، يُحدَّث مرة في اليوم عند الساعة 4 صباحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was andere sehen: deinen Turniernamen, dein Turnier und deine Funken der Woche, einmal täglich um 4 Uhr aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What others see: your joust name, your joust and your sparks for the week, updated once a day at 4 a.m."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que ven los demás: tu nombre de justa, tu justa y tu total de chispas de la semana, actualizado una vez al día a las 4 h."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que les autres voient : ton nom de joute, ta joute et ton total d’étincelles de la semaine, mis à jour une fois par jour à 4 h."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vedono gli altri: il tuo nome di torneo, il tuo torneo e il tuo totale di scintille della settimana, aggiornato una volta al giorno alle 4."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que os outros veem: seu nome de torneio, seu torneio e seu total de faíscas da semana, atualizado uma vez por dia às 4 h."
          }
        }
      }
    },
    "game2.league.consent.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانضمام إلى المبارزة العامة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem öffentlichen Turnier beitreten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join the public joust"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unirme a la justa pública"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre la joute publique"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra nel torneo pubblico"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar no torneio público"
          }
        }
      }
    },
    "game2.league.minor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المبارزة العامة غير مفتوحة لحسابك. أما مبارزة الأصدقاء فمفتوحة دائمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das öffentliche Turnier ist für dein Konto nicht geöffnet. Das Turnier der Freunde ist dagegen immer offen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The public joust isn’t open for your account. The Friends’ Joust always is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La justa pública no está abierta para tu cuenta. La Justa de los amigos, en cambio, lo está siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La joute publique n’est pas ouverte pour ton compte. La Joute des amis, elle, l’est toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il torneo pubblico non è aperto per il tuo account. Il Torneo degli amici, invece, lo è sempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O torneio público não está aberto para a sua conta. O Torneio dos amigos, esse, está sempre aberto."
          }
        }
      }
    },
    "game2.league.locked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح المبارزة عند المستوى ⁦%1$@⁩: كل أسبوع تقيس نفسك مع 29 بطلًا بنور متقارب. أنت في المستوى ⁦%2$@⁩."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Turnier öffnet bei Level %1$@: Jede Woche misst du dich mit 29 Helden von ähnlichem Licht. Du bist auf Level %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The joust opens at level %1$@: each week, you measure yourself against 29 heroes whose light is like yours. You are at level %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La justa se abre en el nivel %1$@: cada semana te mides con 29 héroes de luz parecida. Estás en el nivel %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La joute s’ouvre au niveau %1$@ : chaque semaine, tu te mesures à 29 héros de lumière semblable. Tu es au niveau %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il torneo si apre al livello %1$@: ogni settimana ti misuri con 29 eroi di luce simile. Sei al livello %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O torneio se abre no nível %1$@: toda semana, você se mede com 29 heróis de luz parecida. Você está no nível %2$@."
          }
        }
      }
    },
