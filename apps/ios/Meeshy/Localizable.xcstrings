    "composer.audience.mention.outside": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خارج الجمهور المختار — لن يرى هذا الشخص الإشارة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außerhalb der gewählten Zielgruppe — diese Person sieht ihre Erwähnung nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside the chosen audience — this person won't see their mention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de la audiencia elegida: esta persona no verá su mención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors de l'audience choisie — cette personne ne verra pas sa mention."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuori dal pubblico scelto — questa persona non vedrà la sua menzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora do público escolhido — esta pessoa não verá a menção."
          }
        }
      }
    },
