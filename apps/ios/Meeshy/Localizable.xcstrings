    "forward.error.contact-offline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التواصل مع هذا الشخص في وضع عدم الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
