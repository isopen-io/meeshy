    "circles.unlink.confirm.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تكونا مرتبطين بعد الآن: لا دائرة مشتركة. لن يتم إشعار %@ ولن يتمكن من طلب رابط مجددًا قبل 30 يومًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr seid nicht mehr verbunden: kein gemeinsamer Kreis mehr. %@ wird nicht benachrichtigt und kann dich 30 Tage lang nicht erneut um eine Verbindung bitten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll no longer be linked: no shared circle at all. %@ won't be notified and can't ask you for a link again for 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no estaréis vinculados: ningún círculo en común. %@ no recibirá ningún aviso y no podrá volver a pedirte un vínculo antes de 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne serez plus liés : plus aucun cercle commun. %@ n'en sera pas averti(e) et ne pourra pas vous redemander de lien avant 30 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sarete più legati: nessuna cerchia in comune. %@ non verrà avvisato/a e non potrà chiederti di nuovo un legame prima di 30 giorni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocês não estarão mais ligados: nenhum círculo em comum. %@ não será avisado(a) e não poderá pedir um vínculo de novo antes de 30 dias."
          }
        }
      }
    },
    "circles.notice.lowerFailed": {
