        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre atti per sogno. Una volta compiuti, fanno apparire l’Offerta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três atos por sonho. Uma vez realizados, eles fazem aparecer a Oferenda."
          }
        }
      }
    },
    "game.detail.fact.league_place": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا مركزك بين أبطال مبارزتك، هذا الأسبوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein Platz unter den Helden deines Turniers in dieser Woche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your place among the heroes of your joust, this week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es tu puesto entre los héroes de tu justa, esta semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est ta place parmi les héros de ta joute, cette semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il tuo posto tra gli eroi del tuo torneo, questa settimana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o seu lugar entre os heróis do seu torneio, nesta semana."
          }
        }
      }
    },
    "game.detail.fact.week_points": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الشرارات المكتسبة منذ الاثنين. تبدأ من الصفر كل أسبوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind die Funken seit Montag. Jede Woche beginnen sie wieder bei null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the sparks earned since Monday. They start again from zero every week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son las chispas ganadas desde el lunes. Vuelven a cero cada semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les étincelles gagnées depuis lundi. Elles repartent de zéro chaque semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono le scintille guadagnate da lunedì. Ripartono da zero ogni settimana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São as faíscas ganhas desde segunda-feira. Elas voltam a zero toda semana."
          }
        }
      }
    },
    "game.detail.fact.league_zone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأوائل يرتقون إلى الحلقة التالية، والأخيرون يهبطون، والباقون يبقون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ersten steigen in den nächsten Kreis auf, die Letzten steigen ab, die anderen bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first ones climb to the next circle, the last ones go back down, the others stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los primeros suben al círculo siguiente, los últimos bajan, los demás se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les premiers gravissent le cercle suivant, les derniers redescendent, les autres restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I primi salgono al cerchio successivo, gli ultimi riscendono, gli altri restano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os primeiros sobem para o círculo seguinte, os últimos voltam a descer, os outros ficam."
          }
        }
      }
    },
    "game.detail.fact.league_missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الشرارات التي تقودك إلى منطقة الصعود."
          }
        },
