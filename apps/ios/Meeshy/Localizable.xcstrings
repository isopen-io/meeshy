          }
        }
      }
    },
    "game.concept.prestige.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانبعاث يُعرض على من يبلغ نوره المستوى ⁦100⁩."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergeburt bietet sich allen, deren Licht Level 100 erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebirth is offered to those whose light reaches level 100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El renacimiento se ofrece a quienes llevan su luz al nivel 100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La renaissance s’offre à ceux dont la lumière atteint le niveau 100."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rinascita si offre a chi porta la propria luce al livello 100."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O renascimento se oferece a quem leva a luz ao nível 100."
          }
        }
      }
    },
    "game.concept.prestige.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعود نورك شرارةً، وتدخل أسطورتك عصرًا جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Licht wird wieder Funke: Deine Legende beginnt ein neues Zeitalter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light becomes a Spark again and your legend enters a new Age."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu luz vuelve a ser Chispa y tu leyenda entra en una nueva Edad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta lumière redevient Étincelle et ta légende entre dans un nouvel Âge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua luce torna Scintilla e la tua leggenda entra in una nuova Era."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua luz volta a ser Faísca e sua lenda entra numa nova Era."
          }
        }
      }
    },
    "game.concept.prestige.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احمل نورك حتى المستوى ⁦100⁩."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag dein Licht bis Level 100."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry your light all the way to level 100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva tu luz hasta el nivel 100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Porte ta lumière jusqu’au niveau 100."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta la tua luce fino al livello 100."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve sua luz até o nível 100."
          }
        }
      }
    },
    "game.concept.prestige.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انبعث متى شئت: لا شيء يُلزمك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werde wiedergeboren, wann du willst: Nichts zwingt dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be reborn whenever you like: nothing forces you to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renace cuando quieras: nada te obliga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renais quand tu veux : rien ne t’y oblige."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinasci quando vuoi: niente ti obbliga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renasça quando quiser: nada obriga você."
          }
        }
      }
    },
