    "conversation.obsolete.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد جعل المحادثة متقادمة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterhaltung als veraltet markieren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make this conversation obsolete?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Volver obsoleta la conversación?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre la conversation obsolète ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendere obsoleta la conversazione?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tornar a conversa obsoleta?"
          }
        }
      }
