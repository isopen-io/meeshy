    "game.atlas.treasury.line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بعملات Meesh: إرثك ينمو، من الكيس إلى الاحتياطي الملكي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte deine Meeshes: Dein Erbe wächst, von der Börse bis zur königlichen Reserve."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Meeshes: your Legacy grows, from the Purse to the royal Reserve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus Meeshes: tu Legado crece, del Monedero a la Reserva real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde tes Meeshes : ton Héritage grandit, de la Bourse à la Réserve royale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni le tue Meesh: la tua Eredità cresce, dalla Borsa alla Riserva reale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde suas Meeshes: sua Herança cresce, da Bolsa à Reserva real."
          }
        }
      }
    },
