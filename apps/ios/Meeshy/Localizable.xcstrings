            "state": "translated",
            "value": "Primero restablece el cifrado aquí y luego abre la otra conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablissez d’abord le chiffrement ici, puis ouvrez l’autre conversation."
