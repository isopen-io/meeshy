    "game.guide.moment.missions_unlocked.short": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلم هذه الليلة في انتظارك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Traum dieser Nacht wartet auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonight’s dream is waiting for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sueño de esta noche te espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rêve de cette nuit t’attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sogno di stanotte ti aspetta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sonho desta noite espera por você."
          }
        }
      }
    },
    "game.guide.moment.first_mint_possible.means_free": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السكّ يصوغ %@ من نورك في قطعة، دون أن تفقد مستوى، وتكسب ⁦+%@⁩ من المجد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prägen bannt %@ deines Lichts in eine Münze, ohne dass du ein Level verlierst, und du gewinnst +%@ Ruhm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minting binds %@ of your light into a coin, without making you lose a level, and you gain +%@ glory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuñar fija %@ de tu luz en una moneda, sin hacerte perder un nivel, y ganas +%@ de gloria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frapper fige %@ de ta lumière dans une pièce, sans te faire perdre un niveau, et tu gagnes +%@ de gloire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coniare fissa %@ della tua luce in una moneta, senza farti perdere un livello, e guadagni +%@ di gloria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunhar cristaliza %@ da sua luz numa moeda, sem fazer você perder um nível, e você ganha +%@ de glória."
          }
        }
      }
    },
    "game.guide.moment.first_mint_possible.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الآن سك أول Meesh لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst deine erste Meesh prägen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can mint your first Meesh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes acuñar tu primera Meesh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux frapper ta première Meesh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi coniare la tua prima Meesh."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode cunhar a sua primeira Meesh."
          }
        }
      }
    },
    "game.guide.moment.first_mint_possible.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سُكّ الآن، أو دع نورك ينمو أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Präge jetzt, oder lass dein Licht erst wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mint now, or let your light grow first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuña ahora, o deja antes que tu luz crezca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frappe maintenant, ou laisse d’abord grandir ta lumière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conia ora, oppure lascia prima crescere la tua luce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunhe agora, ou deixe primeiro a sua luz crescer."
          }
        }
      }
    },
    "game.guide.moment.first_mint_possible.short": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Meesh تصوغ %@ من نورك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Meesh bannt %@ deines Lichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Meesh binds %@ of your light."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Meesh fija %@ de tu luz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une Meesh fige %@ de ta lumière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Meesh fissa %@ della tua luce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma Meesh cristaliza %@ da sua luz."
          }
        }
      }
    },
    "game.guide.moment.first_mint.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طَق! تم سك أول Meesh لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klack! Deine erste Meesh ist geprägt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clack! Your first Meesh is minted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Clac! Tu primera Meesh está acuñada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tchak ! Ta première Meesh est frappée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clac! La tua prima Meesh è coniata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tchac! Sua primeira Meesh foi cunhada."
          }
        }
      }
    },
    "game.guide.moment.first_mint.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جزء من نورك صِيغ في القطعة: فانخفض مستواك بقدره، أما رتبتك فلا تنخفض أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil deines Lichts ist in der Münze gebannt: Dein Level ist um ebenso viel gesunken, dein Rang nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of your light is now bound in the coin: your level dropped by as much, your rank never does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte de tu luz se ha fijado en la moneda: tu nivel bajó otro tanto, tu rango nunca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une part de ta lumière s’est figée dans la pièce : ton niveau a baissé d’autant, ton rang jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte della tua luce si è fissata nella moneta: il tuo livello è sceso di altrettanto, il tuo rango mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma parte da sua luz se cristalizou na moeda: seu nível baixou na mesma medida, seu título nunca."
          }
        }
      }
    },
    "game.guide.moment.first_mint.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تلقّيته يبقى لك: كل شرارة جديدة تُنمّي نورك من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du empfangen hast, bleibt empfangen: Jeder neue Funke lässt dein Licht wieder wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you received stays received: every new spark makes your light grow again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo recibido sigue recibido: cada nueva chispa hace crecer de nuevo tu luz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu as reçu reste reçu : chaque nouvelle étincelle fait regrandir ta lumière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che hai ricevuto resta ricevuto: ogni nuova scintilla fa ricrescere la tua luce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você recebeu continua recebido: cada nova faísca faz a sua luz crescer de novo."
          }
        }
      }
    },
    "game.guide.moment.first_mint.short": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سُكّت Meesh: رتبتك باقية، ونورك سينمو من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meesh geprägt: Dein Rang bleibt, dein Licht wächst wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meesh minted: your rank stays, your light will grow again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meesh acuñada: tu rango se queda, tu luz volverá a crecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meesh frappée : ton rang reste, ta lumière regrandira."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meesh coniata: il tuo rango resta, la tua luce ricrescerà."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meesh cunhada: seu título fica, sua luz vai crescer de novo."
          }
        }
      }
    },
    "game.guide.moment.price_rises.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصبح Meesh أندر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshes werden seltener."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshes are getting rarer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Meeshes se vuelven más escasas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Meeshes deviennent plus rares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Meesh diventano più rare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Meeshes estão ficando mais raras."
          }
        }
      }
    },
    "game.guide.moment.price_rises.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلما سككت أكثر، صاغت القطعة التالية من نورك أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mehr man prägt, desto mehr Licht bannt die nächste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The more you mint, the more light the next one binds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuantas más se acuñan, más luz fija la siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus on en frappe, plus la suivante fige de lumière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più ne conii, più luce fissa la successiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais moedas se cunham, mais luz a próxima cristaliza."
          }
        }
      }
    },
    "game.guide.moment.price_rises.next": {
      "extractionState": "manual",
      "localizations": {
