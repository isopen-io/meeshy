    "call.captions.refused.e2ee": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمة النصية غير متاحة في محادثة مشفرة من طرف إلى طرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untertitel sind in einer Ende-zu-Ende-verschlüsselten Unterhaltung nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captions are unavailable in an end-to-end encrypted conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subtítulos no están disponibles en una conversación cifrada de extremo a extremo."
          }
        },
