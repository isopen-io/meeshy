    "settings.privacy.read_receipts.info": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأمر متبادل: إن لم تُرسل إشعارات القراءة، فلن ترى أيضًا ما إذا قُرئت رسائلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt in beide Richtungen: Wer keine Lesebestätigungen sendet, sieht auch nicht, ob die eigenen Nachrichten gelesen wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This works both ways: if you don't send read receipts, you won't see whether your own messages were read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es recíproco: si no envías confirmaciones de lectura, tampoco verás si han leído tus mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réciproque : si vous ne renvoyez pas d'accusé de lecture, vous ne verrez pas non plus si vos messages ont été lus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È reciproco: se non invii conferme di lettura, non vedrai nemmeno se i tuoi messaggi sono stati letti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É recíproco: se você não enviar confirmações de leitura, também não verá se suas mensagens foram lidas."
          }
        }
      }
    },
    "settings.privacy.save_media": {
      "extractionState": "manual",
      "localizations": {
