    "reveal.badgeAxis.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى إضافي على هذا المحور. يُفتح المستوى التالي بالمتابعة."
