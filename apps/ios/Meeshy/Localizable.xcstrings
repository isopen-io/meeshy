    "circles.ritual.consent.locationProximity.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ننبَّه كلانا، مرة واحدة كحد أقصى كل ساعتين، عندما نكون قريبين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir beide werden benachrichtigt, höchstens alle 2 Stunden, wenn wir uns nahe sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We are both notified, at most once every 2 hours, when we are close."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dos recibimos un aviso, como máximo una vez cada 2 horas, cuando estamos cerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous sommes prévenus tous les deux, au plus une fois toutes les 2 heures, quand nous sommes proches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siamo avvisati entrambi, al massimo una volta ogni 2 ore, quando siamo vicini."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois somos avisados, no máximo uma vez a cada 2 horas, quando estamos perto."
          }
        }
      }
    },
