    "signInLink.deviceConfirm.claim": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُربط هذا العنوان بـ ‎%@‎ ويُزال من أي حساب Meeshy آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse wird %@ zugeordnet und aus jedem anderen Meeshy-Konto entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address will be attached to %@ and removed from any other Meeshy account."
          }
        },
        "es": {
