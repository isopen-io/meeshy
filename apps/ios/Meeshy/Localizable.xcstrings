    "game2.league.snapshot": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُجمَّد ترتيب الآخرين كل يوم عند الساعة 4 صباحًا: لا أحد يرى من يلعب الآن. سطرك وحده مباشر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Plätze der anderen werden täglich um 4 Uhr festgehalten: Niemand sieht, wer gerade spielt. Nur deine Zeile ist live."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The others’ places are set every day at 4 a.m.: nobody sees who is playing right now. Only your own row is live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clasificación de los demás se fija cada día a las 4 h: nadie ve quién está jugando ahora. Solo tu fila está en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement des autres est figé chaque jour à 4 h : personne ne voit qui joue en ce moment. Seule ta ligne est en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La classifica degli altri si fissa ogni giorno alle 4: nessuno vede chi sta giocando ora. Solo la tua riga è in diretta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A classificação dos outros se fixa todo dia às 4 h: ninguém vê quem está jogando agora. Só a sua linha é ao vivo."
          }
        }
      }
    },
