          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An encrypted message can’t be published. It’s forwarded, copied and saved on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mensaje cifrado no se publica. Se reenvía, se copia y se guarda en este dispositivo."
