    "composer.reelOffer.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منشورك يحتوي على فيديو واحد فقط: كريل، يُعرض بملء الشاشة في الريلز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Beitrag enthält nur ein Video: Als Reel läuft es im Vollbild unter Reels."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your post has a single video: as a reel, it plays full screen in Reels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu publicación tiene un solo vídeo: como reel, se abre a pantalla completa en Reels."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre post n’a qu’une vidéo : en réel, elle s’ouvre en plein écran dans les Réels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo post contiene un solo video: come reel, si apre a schermo intero nei Reel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua publicação tem um único vídeo: como reel, ela abre em tela cheia nos Reels."
          }
        }
      }
    },
