    "game.detail.levelstep.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من 10 إلى 100، كل عشرة مستويات، يطلب أجدادك اختبارًا بسيطًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von 10 bis 100 verlangen deine Ahnen alle zehn Level eine einfache Prüfung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From 10 to 100, every ten levels, your ancestors ask for a simple trial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 10 a 100, cada diez niveles, tus ancestros piden una prueba sencilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De 10 à 100, tous les dix niveaux, tes aïeux demandent une épreuve simple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 10 a 100, ogni dieci livelli, i tuoi antenati chiedono una prova semplice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De 10 a 100, a cada dez níveis, seus ancestrais pedem uma prova simples."
          }
        }
      }
    },
    "game.detail.levelstep.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجتز الاختبار: إن كان نورك قد بلغه، يرتفع المستوى دفعة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestehe die Prüfung: Ist dein Licht schon so weit, steigt das Level sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass the trial: if your light is already there, the level rises at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera la prueba: si tu luz ya llega, el nivel sube de golpe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réussis l’épreuve : si ta lumière y est déjà, le niveau monte d’un coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera la prova: se la tua luce è già lì, il livello sale di colpo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vença a prova: se sua luz já estiver lá, o nível sobe de uma vez."
          }
        }
      }
    },
    "game.level.step.line": {
