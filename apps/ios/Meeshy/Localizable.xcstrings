    "e2ee.devices.scanner.denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يملك Meeshy إذنًا بالوصول إلى الكاميرا. اسمح به في الإعدادات لقراءة الرمز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy hat keinen Zugriff auf die Kamera. Erlaube ihn in den Einstellungen, um den Code zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy has no access to the camera. Allow it in Settings to scan the code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy no tiene acceso a la cámara. Autorízala en Ajustes para leer el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy n’a pas accès à la caméra. Autorisez-la dans Réglages pour lire le code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeshy non ha accesso alla fotocamera. Consentilo in Impostazioni per leggere il codice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Meeshy não tem acesso à câmera. Autorize-o em Ajustes para ler o código."
          }
        }
      }
    },
    "e2ee.devices.scanner.noCamera": {
      "extractionState": "manual",
