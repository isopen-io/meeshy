      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سعيد برؤيتك مجددًا!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schön, dich wiederzusehen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good to see you again!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Qué bueno verte de nuevo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Content de te revoir !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che bello rivederti!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que bom te ver de novo!"
          }
        }
      }
    },
    "game.guide.moment.return_after_absence.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غبت %@: رتبتك وإرثك ومجدك انتظرتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst %@ weg: Dein Rang, dein Erbe und dein Ruhm haben auf dich gewartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You were away %@: your rank, your Legacy and your glory waited for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estuviste fuera %@: tu rango, tu Legado y tu gloria te han esperado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu étais parti %@ : ton rang, ton Héritage et ta gloire t’ont attendu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei stato via %@: il tuo rango, la tua Eredità e la tua gloria ti hanno aspettato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ficou fora por %@: seu título, sua Herança e sua glória esperaram por você."
          }
        }
      }
    },
    "game.guide.moment.return_after_absence.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بالفصل الأول من الحلم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit dem ersten Akt des Traums."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with the dream’s first act."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por el primer acto del sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par le premier acte du rêve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comincia dal primo atto del sogno."
