    "call.liveFrame.hold.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبقي هذا الإطار حول الفيديوهين طوال المكالمة ويقترحه على الطرف الآخر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält diesen Rahmen während des ganzen Anrufs um beide Videos und schlägt ihn deinem Gegenüber vor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps this frame around both videos for the whole call, and offers it to the other person"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene este marco alrededor de los dos vídeos durante toda la llamada y se lo propone a la otra persona"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde ce cadre autour des deux vidéos pendant tout l'appel, et le propose à votre correspondant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene questa cornice attorno ai due video per tutta la chiamata e la propone all'altra persona"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém esta moldura em volta dos dois vídeos durante toda a chamada e a propõe à outra pessoa"
          }
        }
      }
    },
