    "onboarding.greeting.5": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا! معكم %1$@. أبحث عن أشخاص للحديث عن الموسيقى، باللغة %2$@ أو بأي لغة 🎶"
