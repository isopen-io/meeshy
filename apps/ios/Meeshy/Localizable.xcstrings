    "game2.prestige.confirm.access": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خبر سار: مبارزتك (المستوى 10) وتحالفك (المستوى 20) يبقيان مفتوحين، لأنهما يقرآن ذروة نورك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut zu wissen: Dein Turnier (Level 10) und dein Bündnis (Level 20) bleiben offen, denn sie richten sich nach deinem hellsten Licht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good news: your joust (level 10) and your alliance (level 20) stay open, because they read your highest light."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buena noticia: tu justa (nivel 10) y tu alianza (nivel 20) siguen abiertas, porque leen tu luz más alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonne nouvelle : ta joute (niveau 10) et ton alliance (niveau 20) restent ouvertes, car elles lisent ta plus haute lumière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Buona notizia: il tuo torneo (livello 10) e la tua alleanza (livello 20) restano aperti, perché leggono la tua luce più alta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Boa notícia: seu torneio (nível 10) e sua aliança (nível 20) continuam abertos, porque eles leem o auge da sua luz."
          }
        }
      }
    },
    "game2.prestige.confirm.consent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موافقتك على المبارزة العامة تبقى مسجّلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Zustimmung zum öffentlichen Turnier bleibt gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your consent to the public joust stays on file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu consentimiento para la justa pública sigue registrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton accord pour la joute publique reste enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo consenso al torneo pubblico resta registrato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu acordo para o torneio público continua registrado."
          }
        }
      }
    },
    "game2.prestige.confirm.keeps": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يبقى: الشرارات التي تلقّيتها منذ البداية، وذروة نورك، ورتبتك، ومجدك، وعملات Meesh، ولهبك، وكؤوسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was bleibt: deine seit jeher empfangenen Funken, dein hellstes Licht, dein Rang, dein Ruhm, deine Meeshes, deine Flamme und deine Trophäen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What stays: the sparks received since the beginning, your highest light, your rank, your glory, your Meeshes, your Flame and your trophies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se queda: tus chispas recibidas desde siempre, tu luz más alta, tu rango, tu gloria, tus Meeshes, tu Llama y tus trofeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste : tes étincelles reçues depuis toujours, ta plus haute lumière, ton rang, ta gloire, tes Meeshes, ta Flamme et tes trophées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che resta: le tue scintille ricevute da sempre, la tua luce più alta, il tuo rango, la tua gloria, le tue Meesh, la tua Fiamma e i tuoi trofei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que fica: suas faíscas recebidas desde sempre, o auge da sua luz, seu título, sua glória, suas Meeshes, sua Chama e seus troféus."
          }
        }
      }
    },
    "game2.prestige.confirm.resets": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يعود إلى البداية: مستواك (إلى 1) وشرارات نورك (إلى 0)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was neu beginnt: dein Level (bei 1) und die Funken deines Lichts (bei 0)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What starts over: your level (at 1) and the sparks of your light (at 0)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que vuelve a empezar: tu nivel (a 1) y las chispas de tu luz (a 0)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui repart : ton niveau (à 1) et les étincelles de ta lumière (à 0)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che riparte: il tuo livello (da 1) e le scintille della tua luce (da 0)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que recomeça: seu nível (em 1) e as faíscas da sua luz (em 0)."
          }
        }
      }
    },
    "game2.prestige.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أتبدأ انبعاثك ⁦%@⁩؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wiedergeburt %@ beginnen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin your Rebirth %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Empezar tu Renacimiento %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer ta Renaissance %@ ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cominciare la tua Rinascita %@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar o seu Renascimento %@?"
          }
        }
      }
    },
    "game2.prestige.meo": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالانبعاث، يعود مستواك إلى 1 وشراراتك إلى 0. ويهديك أجدادك عصرًا جديدًا، وكأسًا مرقّمة، و%@ من المجد. ورتبتك لا تتراجع أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Wiedergeburt beginnt dein Level wieder bei 1 und deine Funken bei 0. Deine Ahnen schenken dir ein neues Zeitalter, eine nummerierte Trophäe und %@ Ruhm. Dein Rang weicht nie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you are reborn, your level starts over at 1 and your sparks at 0. Your ancestors offer you a new Age, a numbered trophy and %@ glory. Your rank never goes back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al renacer, tu nivel vuelve a 1 y tus chispas a 0. Tus ancestros te ofrecen una nueva Edad, un trofeo numerado y %@ de gloria. Tu rango nunca retrocede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En renaissant, ton niveau repart à 1 et tes étincelles à 0. Tes aïeux t’offrent un nouvel Âge, un trophée numéroté et %@ de gloire. Ton rang ne recule jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinascendo, il tuo livello riparte da 1 e le tue scintille da 0. I tuoi antenati ti offrono una nuova Era, un trofeo numerato e %@ di gloria. Il tuo rango non arretra mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao renascer, seu nível recomeça em 1 e suas faíscas em 0. Seus ancestrais oferecem a você uma nova Era, um troféu numerado e %@ de glória. Seu título nunca recua."
          }
        }
      }
    },
    "game2.prestige.mee": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستوى 100: يمكن لنورك أن ينبعث، أو أن ينمو أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Level 100: Dein Licht kann wiedergeboren werden, oder weiter wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level 100: your light can be reborn, or keep growing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivel 100: tu luz puede renacer, o crecer todavía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau 100 : ta lumière peut renaître, ou grandir encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Livello 100: la tua luce può rinascere, o crescere ancora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nível 100: sua luz pode renascer, ou crescer mais."
          }
        }
      }
    },
    "game2.prestige.max": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاشت أسطورتك انبعاثاتها الخمسة: قمة القمم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Legende hat ihre fünf Wiedergeburten erlebt: der Gipfel der Gipfel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your legend has lived its five rebirths: the summit of summits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu leyenda ha vivido sus cinco renacimientos: la cima de la cima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta légende a vécu ses cinq renaissances : le sommet du sommet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua leggenda ha vissuto le sue cinque rinascite: la vetta della vetta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua lenda viveu os seus cinco renascimentos: o topo do topo."
          }
        }
      }
    },
