    "location.precision.footnote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في مستويي الحي والمدينة، تتم مشاركة المنطقة فقط — وليس العنوان الدقيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den Stufen Viertel und Stadt wird nur das Gebiet geteilt – nicht die genaue Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At Neighborhood and City levels, only the area is shared — not the exact address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los niveles Barrio y Ciudad, solo se comparte la zona, no la dirección exacta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aux niveaux Quartier et Ville, seule la zone est transmise — pas l'adresse exacte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai livelli Quartiere e Città viene condivisa solo la zona, non l'indirizzo esatto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos níveis Bairro e Cidade, apenas a área é compartilhada — não o endereço exato."
          }
        }
      }
    },
