    "settings.media.outgoing.compress.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوفّر البيانات بتصغير كل صورة وكل فيديو (720p). وإلا تُرسل بدقة عالية (فيديو 1080p) مضغوطة دون فقدان ملحوظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spart Daten, indem jedes Foto und jedes Video (720p) verkleinert wird. Sonst werden sie in hoher Auflösung gesendet (Videos in 1080p), ohne sichtbaren Verlust komprimiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves data by shrinking every photo and video (720p). Otherwise, they are sent in high definition (1080p videos), compressed with no visible loss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorra datos reduciendo cada foto y cada vídeo (720p). Si no, se envían en alta definición (vídeos en 1080p), comprimidos sin pérdida visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Économise des données en réduisant chaque photo et chaque vidéo (720p). Sinon, elles partent en haute définition (vidéos en 1080p), compressées sans perte visible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmia dati riducendo ogni foto e ogni video (720p). Altrimenti partono in alta definizione (video in 1080p), compressi senza perdita visibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Economiza dados reduzindo cada foto e cada vídeo (720p). Caso contrário, são enviados em alta definição (vídeos em 1080p), comprimidos sem perda visível."
          }
        }
      }
    },
