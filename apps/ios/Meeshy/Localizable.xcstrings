    "game.concept.level.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النور"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Light"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Luz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lumière"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Luce"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Luz"
          }
        }
      }
    },
    "game.concept.level.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نورك يروي الطريق الذي قطعته على Meeshy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Licht erzählt den Weg, den du auf Meeshy gegangen bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light tells how far you’ve come on Meeshy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu luz cuenta el camino que has recorrido en Meeshy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta lumière dit le chemin que tu as parcouru sur Meeshy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua luce racconta il cammino che hai percorso su Meeshy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua luz mostra o caminho que você percorreu no Meeshy."
          }
        }
      }
    },
    "game.concept.level.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شراراتك تغذّي الحلقة: حين تمتلئ، يبلغ نورك مستوى جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Funken nähren den Ring: Ist er voll, gewinnt dein Licht ein Level."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sparks feed the ring: when it’s full, your light gains a level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chispas alimentan el anillo: lleno, tu luz gana un nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes étincelles nourrissent l’anneau : plein, ta lumière gagne un niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scintille nutrono l’anello: pieno, la tua luce sale di un livello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas faíscas alimentam o anel: cheio, sua luz ganha um nível."
          }
        }
      }
    },
    "game.concept.level.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقّق حلم كل ليلة: فصوله تُطلق شرارات كثيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfülle den Traum jeder Nacht: Seine Akte lassen viele Funken sprühen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fulfill each night’s dream: its acts make lots of sparks fly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz realidad el sueño de cada noche: sus actos hacen brotar muchas chispas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réalise le rêve de chaque nuit : ses actes font jaillir beaucoup d’étincelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compi il sogno di ogni notte: i suoi atti fanno scaturire molte scintille."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Realize o sonho de cada noite: seus atos fazem saltar muitas faíscas."
          }
        }
      }
    },
    "game.concept.level.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ لهبك مشتعلًا: فهو يغذّي أحلامك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte deine Flamme am Brennen: Sie nährt deine Träume."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Flame lit: it feeds your dreams."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu Llama encendida: alimenta tus sueños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde ta Flamme allumée : elle nourrit tes rêves."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni accesa la tua Fiamma: nutre i tuoi sogni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha sua Chama acesa: ela alimenta seus sonhos."
          }
        }
      }
    },
    "game.concept.points.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشرارات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chispas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étincelles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scintille"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faíscas"
          }
        }
      }
    },
    "game.concept.points.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شراراتك تصنع نورك؛ وتألّقه هو مستواك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Funken bilden dein Licht; sein Glanz ist dein Level."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sparks form your light; how bright it shines is your level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chispas forman tu luz; su brillo es tu nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes étincelles forment ta lumière ; son éclat, c’est ton niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scintille formano la tua luce; il suo splendore è il tuo livello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas faíscas formam a sua luz; o brilho dela é o seu nível."
          }
        }
      }
    },
    "game.concept.points.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تبادل حقيقي يُطلقها: الكتابة، والكلام، والنشر، والتفاعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Echter Austausch sprüht Funken: schreiben, sprechen, posten, reagieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every real exchange makes them fly: writing, talking, posting, reacting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada intercambio de verdad las hace brotar: escribir, hablar, publicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque vrai échange en fait jaillir : écrire, parler, publier, réagir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni vero scambio le fa scaturire: scrivi, parli, pubblichi, reagisci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada troca de verdade faz saltar faíscas: escrever, falar, publicar."
          }
        }
      }
    },
    "game.concept.points.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُد كل يوم: لهب مشتعل يغذّي شراراتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm jeden Tag wieder: Eine brennende Flamme nährt deine Funken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back every day: a lit Flame feeds your sparks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve cada día: una Llama encendida alimenta tus chispas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviens chaque jour : une Flamme allumée nourrit tes étincelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna ogni giorno: una Fiamma accesa nutre le tue scintille."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte todo dia: uma Chama acesa alimenta suas faíscas."
          }
        }
      }
    },
    "game.concept.points.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابنِ زخمًا لتضاعف شراراتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse einen Schwung aus, um deine Funken zu vervielfachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build momentum to multiply your sparks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa un impulso para multiplicar tus chispas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déclenche un élan pour multiplier tes étincelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva uno slancio per moltiplicare le tue scintille."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative um impulso para multiplicar suas faíscas."
          }
        }
      }
    },
    "game.concept.meesh.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإرث"
          }
        },
        "de": {
