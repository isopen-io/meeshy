    "game.guide.moment.flame_out.means": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما كان يضيفه إلى أحلامك يبدأ من الصفر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was sie deinen Träumen schenkte, beginnt wieder bei null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What it added to your dreams starts again from zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que añadía a tus sueños vuelve a empezar de cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’elle ajoutait à tes rêves repart de zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che aggiungeva ai tuoi sogni riparte da zero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que ela somava aos seus sonhos recomeça do zero."
          }
        }
