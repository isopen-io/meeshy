    "Cette action est irréversible. Le lien ne sera plus accessible.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الإجراء لا رجعة فيه. لن يعود الرابط متاحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
