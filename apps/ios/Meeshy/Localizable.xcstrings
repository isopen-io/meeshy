    "game2.atlas.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ختم لكل لغة تبادلت بها الرسائل فعلًا: رسالة مرسلة ورسالة مستلمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Stempel pro wirklich gesprochener Sprache: eine gesendete, eine empfangene Nachricht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One stamp per language really exchanged: one message sent, one received."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sello por idioma realmente intercambiado: un mensaje enviado, uno recibido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tampon par langue vraiment échangée : un message envoyé, un reçu."
