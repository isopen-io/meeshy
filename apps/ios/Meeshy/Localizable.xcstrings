    "game.rules.badges.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل وسام يتبع إجراءً واحدًا محددًا: رسالة صوتية، قصة، صداقة جديدة…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Medaille verfolgt EINE bestimmte Aktion: eine Sprachnachricht, eine Story, eine neue Freundschaft…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each medal follows ONE precise move: a voice message, a story, a friendship made…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada medalla sigue UN gesto concreto: un mensaje de voz, una story, una amistad nueva…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque médaille suit UN geste précis : un message vocal, une story, une amitié nouée…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni medaglia segue UN gesto preciso: un messaggio vocale, una storia, un’amicizia stretta…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada medalha acompanha UM gesto preciso: uma mensagem de voz, um story, uma amizade feita…"
          }
        }
      }
    },
    "game.rules.badges.ladder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل وسام يرتقي سبع درجات. عند كل عتبة تتجاوزها، تتغيّر مادته وتُضاء نجمة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Medaille erklimmt sieben Stufen. Bei jeder überschrittenen Schwelle wechselt sie das Material und lässt einen Stern mehr leuchten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each medal climbs seven marks. At each threshold crossed, it changes material and lights one more star."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada medalla sube siete escalones. Cada vez que superas un umbral, cambia de material y enciende una estrella más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque médaille gravit sept paliers. À chaque seuil franchi, elle change de matière et allume une étoile de plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni medaglia sale sette gradini. A ogni soglia superata, cambia materia e accende una stella in più."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada medalha sobe sete patamares. A cada limiar vencido, ela muda de material e acende mais uma estrela."
          }
        }
      }
    },
    "game.rules.badges.ribbon": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتداءً من الذهب، تحمل الميدالية شريطًا؛ وفي المنشور، يتلألأ مينائها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab Gold trägt die Medaille ein Band; bei Prisma schillert ihr Email."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From Gold on, the medal wears a ribbon; at Prism, its enamel turns iridescent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde el Oro, la medalla lleva una cinta; en Prisma, su esmalte se vuelve iridiscente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès l’Or, la médaille porte un ruban ; au Prisme, son émail s’irise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dall’Oro in poi la medaglia porta un nastro; al Prisma il suo smalto diventa iridescente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir do Ouro, a medalha ganha uma fita; no Prisma, seu esmalte fica iridescente."
          }
        }
      }
    },
    "game.rules.badges.imprint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوسام الذي انطفأ يبقى أثرًا: يقول ما ينقص لإعادة إضاءته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erloschene Medaille bleibt ein Abdruck: Er zeigt, was zum Wiederentzünden fehlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A medal that went out stays an imprint: it says what is missing to light it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una medalla apagada sigue siendo una huella: dice lo que falta para volver a encenderla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une médaille éteinte reste une empreinte : elle dit ce qu’il manque pour la rallumer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una medaglia spenta resta un’impronta: dice cosa manca per riaccenderla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma medalha apagada continua uma marca: ela diz o que falta para reacendê-la."
          }
        }
      }
    },
