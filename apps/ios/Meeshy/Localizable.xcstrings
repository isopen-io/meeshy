    },
    "game.concept.defis.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحديات درجات تتجاوزها، واحدة بعد أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herausforderungen sind Stufen, die du eine nach der anderen nimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Challenges are tiers to clear, one after another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los desafíos son escalones que superar, uno tras otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les défis sont des paliers à franchir, l’un après l’autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sfide sono gradini da superare, uno dopo l’altro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os desafios são patamares a vencer, um depois do outro."
          }
        }
      }
    },
    "game.concept.defis.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل درجة تبلغها تفتح التالية، أعلى قليلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede erreichte Stufe öffnet die nächste, ein Stück höher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each tier you reach opens the next one, a little higher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada escalón alcanzado abre el siguiente, un poco más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque palier atteint ouvre le suivant, un peu plus haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni gradino raggiunto apre il successivo, un po’ più in alto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada patamar alcançado abre o seguinte, um pouco mais alto."
          }
        }
      }
    },
    "game.concept.defis.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انظر إلى الدرجة التالية وتقدّم نحوها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir die nächste Stufe an und arbeite darauf hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the next tier and work towards it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el próximo escalón y avanza hacia él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde le prochain palier et avance vers lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda il prossimo gradino e avanza verso di lui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhe o próximo patamar e avance até ele."
          }
        }
      }
    },
    "game.concept.defis.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب إجراءات جديدة: لكل منها تحدياته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probier neue Aktionen aus: Jede hat ihre Herausforderungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try new actions: each one has its challenges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba gestos nuevos: cada uno tiene sus desafíos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie des gestes nouveaux : chacun a ses défis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova gesti nuovi: ognuno ha le sue sfide."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente gestos novos: cada um tem seus desafios."
          }
        }
      }
    },
    "game.concept.succes.name": {
      "extractionState": "manual",
      "localizations": {
