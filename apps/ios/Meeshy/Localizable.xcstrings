    "game.mint.blocked.debt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ظلّ يحجب %@ شرارة من نورك: شراراتك القادمة ستبدّده، ثم يمكنك السكّ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schatten verhüllt %@ Funken deines Lichts: Deine nächsten Funken werden ihn vertreiben, dann kannst du prägen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shadow veils %@ sparks of your light: your next sparks will clear it, then you can mint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sombra cubre %@ chispas de tu luz: tus próximas chispas la disiparán, y luego podrás acuñar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ombre voile %@ étincelles de ta lumière : tes prochaines étincelles la dissiperont, puis tu pourras frapper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’ombra vela %@ scintille della tua luce: le tue prossime scintille la dissiperanno, poi potrai coniare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda deves %@ faíscas: a cunhagem retoma quando a dívida estiver paga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sombra cobre %@ faíscas da sua luz: suas próximas faíscas vão dissipá-la, e então você poderá cunhar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还欠 %@ 火花：还清后即可继续铸造。"
          }
        }
      }
    },
    "game.mint.blocked.debt_plain": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ombre voile ta lumière : tes prochaines étincelles la dissiperont. Tant qu’elle est là, on ne frappe pas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shadow veils your light: your next sparks will clear it. While it’s there, no Meesh can be minted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sombra cubre tu luz: tus próximas chispas la disiparán. Mientras esté ahí, no se acuña."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schatten verhüllt dein Licht: Deine nächsten Funken werden ihn vertreiben. Solange er da ist, wird nicht geprägt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’ombra vela la tua luce: le tue prossime scintille la dissiperanno. Finché c’è, non si conia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma dívida de faíscas bloqueia a cunhagem: os teus próximos ganhos saldam-na primeiro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sombra cobre sua luz: suas próximas faíscas vão dissipá-la. Enquanto ela estiver aí, não dá para cunhar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ظلّ يحجب نورك: شراراتك القادمة ستبدّده. وما دام قائمًا، لا سكّ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "火花欠款阻止了铸造：你接下来的收益会先偿还它。"
          }
        }
      }
    },
    "game.mint.blocked.reserve": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستفتح هذه الـMeesh احتياطي «%1$@»: يلزمك رتبة %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Meesh würde die Reserve „%1$@“ öffnen: Dafür brauchst du den Rang %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Meesh would open the “%1$@” reserve: it takes the %2$@ rank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Meesh abriría la reserva «%1$@»: hace falta el rango %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette Meesh ouvrirait la réserve « %1$@ » : il faut le rang %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa Meesh aprirebbe la riserva «%1$@»: serve il rango %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Meesh abriria a reserva «%1$@»: é preciso a patente %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Meesh abriria a reserva “%1$@”: é preciso a patente %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这枚 Meesh 将开启“%1$@”储备：需要 %2$@ 段位。"
