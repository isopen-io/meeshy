    "settings.privacy.analytics.info": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قياسات استخدام مجهولة: الشاشات المفتوحة والميزات المستخدمة والأعطال. لا محتوى رسائلك ولا جهات اتصالك أبدًا. يسري الإعداد فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Nutzungsdaten: geöffnete Bildschirme, genutzte Funktionen, Abstürze. Niemals Nachrichteninhalte oder Kontakte. Die Einstellung wirkt sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous usage metrics: screens opened, features used, crashes. Never your message content or your contacts. The setting takes effect immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Métricas de uso anónimas: pantallas abiertas, funciones utilizadas, fallos. Nunca el contenido de tus mensajes ni tus contactos. El ajuste se aplica de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure d'usage anonyme : écrans ouverts, fonctionnalités utilisées, plantages. Jamais le contenu de vos messages, ni vos contacts. Le réglage prend effet immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metriche d'uso anonime: schermate aperte, funzioni usate, arresti anomali. Mai il contenuto dei messaggi né i contatti. L'impostazione ha effetto immediato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Métricas de uso anônimas: telas abertas, recursos usados, falhas. Nunca o conteúdo das suas mensagens nem seus contatos. O ajuste vale imediatamente."
          }
        }
      }
    },
