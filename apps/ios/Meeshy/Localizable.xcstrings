    "composer.more.commentsOff.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتمكن أحد من التعليق على هذا المنشور. يمكنك إعادة تفعيل التعليقات من قائمته."
          }
        },
        "de": {
