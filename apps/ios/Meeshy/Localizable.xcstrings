          "stringUnit": {
            "state": "translated",
            "value": "Das Entschlüsseln von Benachrichtigungen auf dem Gerät, um ihren Text anzuzeigen, ist noch nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decrypting notifications on the device, to show their text, isn’t available yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no está disponible descifrar las notificaciones en el dispositivo para mostrar su texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déchiffrement des notifications sur l’appareil, pour en afficher le texte, n’est pas encore disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La decrittografia delle notifiche sul dispositivo, per mostrarne il testo, non è ancora disponibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A descriptografia das notificações no aparelho, para mostrar o texto, ainda não está disponível."
          }
        }
      }
    },
    "conversation.encryption.fact.notYetGroups": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشفير التام بين الطرفين للمجموعات غير متاح بعد في التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende-zu-Ende-Verschlüsselung für Gruppen ist in der App noch nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encryption for groups isn’t available in the app yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cifrado de extremo a extremo de los grupos aún no está disponible en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffrement de bout en bout des groupes n’est pas encore disponible dans l’application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La crittografia end-to-end dei gruppi non è ancora disponibile nell’app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A criptografia de ponta a ponta dos grupos ainda não está disponível no app."
          }
        }
      }
    },
    "conversation.encryption.fact.groupSendingUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في هذه المجموعة، لا يستطيع التطبيق بعد إرسال رسائل مشفّرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Gruppe kann die App noch keine verschlüsselten Nachrichten senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In this group, the app can’t send encrypted messages yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este grupo, la app aún no puede enviar mensajes cifrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans ce groupe, l’application ne peut pas encore envoyer de message chiffré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo gruppo l’app non può ancora inviare messaggi crittografati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste grupo, o app ainda não pode enviar mensagens criptografadas."
          }
        }
      }
    },
    "conversation.encryption.fact.notYetSafetyNumbers": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق من أرقام الأمان مع جهات اتصالك غير متاح بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Überprüfen der Sicherheitsnummern mit deinen Kontakten ist noch nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifying safety numbers with your contacts isn’t available yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación de los números de seguridad con tus contactos aún no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification des numéros de sécurité avec vos contacts n’est pas encore disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La verifica dei numeri di sicurezza con i tuoi contatti non è ancora disponibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação dos números de segurança com seus contatos ainda não está disponível."
          }
        }
      }
    },
    "conversation.encryption.fact.oneKeyPerDevice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكل جهاز مفتاحه الخاص، ولا يغادره أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Gerät hat seinen eigenen Schlüssel, der es nie verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each device has its own key, which never leaves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dispositivo tiene su propia clave, que nunca sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque appareil a sa propre clé, qui ne le quitte jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni dispositivo ha la propria chiave, che non lo lascia mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada aparelho tem a própria chave, que nunca sai dele."
          }
        }
      }
    },
    "conversation.encryption.fact.deviceLimit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن يضم حسابك حتى 16 جهازًا مشفّرًا. بعد ذلك، يقترح التطبيق إزالة أحدها؛ ولا يقرأ الجهاز المُزال الرسائل المشفّرة الجديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto kann bis zu 16 verschlüsselte Geräte haben. Darüber hinaus schlägt die App vor, eines zu entfernen; ein entferntes Gerät liest keine neuen verschlüsselten Nachrichten mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account can have up to 16 encrypted devices. Beyond that, the app offers to remove one; a removed device no longer reads new encrypted messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta puede tener hasta 16 dispositivos cifrados. Más allá, la app te propone quitar uno; un dispositivo quitado ya no lee los nuevos mensajes cifrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte peut avoir jusqu’à 16 appareils chiffrés. Au-delà, l’application vous propose d’en retirer un ; un appareil retiré ne lit plus les nouveaux messages chiffrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account può avere fino a 16 dispositivi crittografati. Oltre, l’app ti propone di rimuoverne uno; un dispositivo rimosso non legge più i nuovi messaggi crittografati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta pode ter até 16 aparelhos criptografados. Além disso, o app propõe remover um; um aparelho removido não lê mais as novas mensagens criptografadas."
          }
        }
      }
    },
    "conversation.encryption.fact.restoredDeviceIsNew": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعدّ الجهاز المُعاد تثبيته أو استعادته جهازًا جديدًا: لا يقرأ الرسائل المشفّرة المستلمة قبل ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neu installiertes oder wiederhergestelltes Gerät gilt als neues Gerät: Es liest zuvor empfangene verschlüsselte Nachrichten nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reinstalled or restored device counts as a new device: it can’t read encrypted messages received before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo reinstalado o restaurado cuenta como nuevo: no lee los mensajes cifrados recibidos antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil réinstallé ou restauré compte comme un nouvel appareil : il ne lit pas les messages chiffrés reçus avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo reinstallato o ripristinato conta come nuovo: non legge i messaggi crittografati ricevuti prima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um aparelho reinstalado ou restaurado conta como novo: ele não lê as mensagens criptografadas recebidas antes."
          }
        }
      }
    },
    "conversation.encryption.fact.whoMayToggle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلال مرحلة الاختبار، يمكن فقط لأعضاء المحادثة الذين لديهم دور في فريق Meeshy (محلّل أو أعلى) تغيير الوضع؛ وفي المجموعة يجب أن يكونوا مشرفين أيضًا. لا يمكن إيقاف التشفير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Testphase können nur Mitglieder der Unterhaltung mit einer Meeshy-Teamrolle (Analyst oder höher) den Modus ändern; in einer Gruppe müssen sie zudem Moderator sein. Die Verschlüsselung lässt sich nicht ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During the test phase, only conversation members with a Meeshy team role (analyst or above) can change the mode; in a group, they must also be a moderator. Encryption can’t be turned off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la fase de pruebas, solo los miembros de la conversación con un rol del equipo Meeshy (analista o superior) pueden cambiar el modo; en un grupo, también deben ser moderadores. El cifrado no se puede desactivar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant la phase de test, seuls les membres de la conversation qui ont un rôle d’équipe Meeshy (analyste ou plus) peuvent changer de mode ; dans un groupe, il faut aussi en être modérateur. Le chiffrement ne se désactive pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la fase di test, solo i membri della conversazione con un ruolo nel team Meeshy (analista o superiore) possono cambiare modalità; in un gruppo devono anche esserne moderatori. La crittografia non si può disattivare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a fase de testes, só os membros da conversa com uma função na equipe Meeshy (analista ou acima) podem mudar o modo; em um grupo, também precisam ser moderadores. A criptografia não pode ser desativada."
          }
        }
      }
    },
    "conversation.encryption.fact.switchKeepsHistory": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغيّر التبديل إلا الرسائل الجديدة: تبقى الرسائل المشفّرة تمامًا بين الطرفين كذلك، مقروءة على الأجهزة التي استلمتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wechsel betrifft nur neue Nachrichten: Bereits Ende-zu-Ende-verschlüsselte bleiben es, lesbar auf den Geräten, die sie empfangen haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A switch only changes new messages: those already end-to-end encrypted stay so, readable on the devices that received them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cambio solo afecta a los mensajes nuevos: los ya cifrados de extremo a extremo siguen así, legibles en los dispositivos que los recibieron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bascule ne change que les nouveaux messages : ceux déjà chiffrés de bout en bout le restent, lisibles sur les appareils qui les ont reçus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cambio riguarda solo i nuovi messaggi: quelli già crittografati end-to-end restano tali, leggibili sui dispositivi che li hanno ricevuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma troca só muda as novas mensagens: as já criptografadas de ponta a ponta continuam assim, legíveis nos aparelhos que as receberam."
          }
        }
      }
    },
    "conversation.encryption.fact.switchIsShownInThread": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر كل تغيير للوضع في المحادثة لجميع الأعضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Moduswechsel wird im Verlauf für alle Mitglieder angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every mode change shows in the chat for every member."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cambio de modo aparece en el chat para todos los miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque changement de mode s’affiche dans le fil, pour tous les membres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni cambio di modalità compare nella chat per tutti i membri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mudança de modo aparece na conversa para todos os membros."
          }
        }
      }
    },
    "conversation.encryption.fact.endToEndIsFinal": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تفعيله، لا يمكن إيقاف التشفير التام بين الطرفين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal eingeschaltet, lässt sich die Ende-zu-Ende-Verschlüsselung nicht mehr ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once turned on, end-to-end encryption can’t be turned off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez activado, el cifrado de extremo a extremo ya no se puede desactivar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, le chiffrement de bout en bout ne se désactive plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta attivata, la crittografia end-to-end non si può più disattivare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de ativada, a criptografia de ponta a ponta não pode mais ser desativada."
          }
        }
      }
    },
    "conversation.encryption.fact.endToEndNeverTurnedOff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُوقَف التشفير التام بين الطرفين أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ende-zu-Ende-Verschlüsselung lässt sich nie ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encryption can never be turned off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cifrado de extremo a extremo nunca se desactiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffrement de bout en bout ne se désactive jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La crittografia end-to-end non si disattiva mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A criptografia de ponta a ponta nunca é desativada."
          }
        }
      }
    },
    "conversation.encryption.fact.endToEndNeverTurnedOffDirect": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُوقَف التشفير التام بين الطرفين أبدًا: تبقى هذه المحادثة الثنائية مشفّرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ende-zu-Ende-Verschlüsselung lässt sich nie ausschalten: Dieser Einzelchat bleibt verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encryption can never be turned off: this one-to-one chat stays encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cifrado de extremo a extremo nunca se desactiva: este chat individual sigue cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffrement de bout en bout ne se désactive jamais : ce tête-à-tête le reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La crittografia end-to-end non si disattiva mai: questa chat individuale resta crittografata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A criptografia de ponta a ponta nunca é desativada: esta conversa individual continua criptografada."
          }
        }
      }
    },
    "conversation.encryption.fact.serverCannotTurnItOff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد أن تُرى مشفّرة تمامًا بين الطرفين، لا يُكتب فيها هنا أبدًا بنص واضح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal Ende-zu-Ende-verschlüsselt gesehen, wird hier nie wieder im Klartext geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once seen end-to-end encrypted, it is never written in plain text here again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista cifrada de extremo a extremo, ya nunca se escribe en claro aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue chiffrée de bout en bout, elle ne s’écrit plus jamais en clair ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista crittografata end-to-end, qui non si scrive mai più in chiaro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista com criptografia de ponta a ponta, nunca mais é escrita em texto claro aqui."
          }
        }
      }
    },
    "conversation.encryption.detail.translation.onDevice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
