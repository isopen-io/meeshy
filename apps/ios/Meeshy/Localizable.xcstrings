        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد التشفير هنا أولًا، ثم افتح المحادثة الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle zuerst die Verschlüsselung hier wieder her, öffne dann die andere Unterhaltung."
