<?xml version="1.0" encoding="utf-8"?>
<!-- #10626 — apercu du selecteur : le widget des non-lus, sans compte. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_brand_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_widget_chat"
        android:tint="@color/widget_on_brand" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/widget_unread_label"
        android:textColor="@color/widget_on_brand"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
