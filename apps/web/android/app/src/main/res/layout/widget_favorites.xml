<?xml version="1.0" encoding="utf-8"?>
<!-- #10626 — les contacts favoris (FavoriteContactsWidget iOS) : les directes
     epinglees, quatre par rangee, une seconde rangee en grand format. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <include layout="@layout/widget_header" />

    <LinearLayout
        android:id="@+id/fav_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/fav_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/fav_0_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/fav_0_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/fav_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/fav_1_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/fav_1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/fav_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/fav_2_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/fav_2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/fav_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/fav_3_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/fav_3_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fav_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/fav_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/fav_4_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/fav_4_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/fav_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/fav_5_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/fav_5_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/fav_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/fav_6_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/fav_6_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/fav_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/fav_7_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/fav_7_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="@color/widget_ink_2"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
