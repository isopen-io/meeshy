<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- #10005 — `SystemBars.setStyle` repeint la fenetre de ce fond : derriere les barres
             systeme, la surface de l'ecran et non le gris du theme DayNight. -->
        <item name="android:windowBackground">@color/surface</item>
        <!-- #13129 — l'accent que la WebView prete a ses controles natifs (calendrier d'un
             `<input type="date">`, liste d'un `<select>`) : sans lui, le sarcelle par defaut
             d'AppCompat, la ou iOS teinte le meme selecteur de `MeeshyColors.indigo500`. -->
        <item name="colorAccent">@color/brand_accent</item>
    </style>


    <!-- L'ecran de lancement. `android:background` sert API 24-30 ; a partir
         d'Android 12 (API 31) le systeme peint lui-meme et ne lit que
         `windowSplashScreenBackground` — sans lui le fond retombe sur le
         `colorBackground` du theme, BLANC en mode clair (#5604). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
    </style>
</resources>