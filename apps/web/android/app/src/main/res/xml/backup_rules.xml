<!-- #8049 — le credential du refus d'appel sans socket (CallShellStore) ne
     quitte jamais l'appareil : ni sauvegarde, ni restauration ailleurs.
     #10143 — le stockage de la WebView non plus (session meeshy.session,
     cache des requetes) : sur le web, il reste dans le navigateur. -->
<full-backup-content>
    <exclude domain="sharedpref" path="meeshy_call_shell.xml" />
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
